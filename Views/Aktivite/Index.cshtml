@{
    ViewData["Title"] = "Kullanıcı Aktivitesi";
}

<div class="px-6 py-5">
    <!-- Header -->
    <div class="flex items-center gap-3 mb-5">
        <div class="w-9 h-9 rounded-lg bg-indigo-100 flex items-center justify-center">
            <i class="bi bi-clock-history text-indigo-700" style="font-size:16px;"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-[#1e293b] tracking-tight">Kullanıcı Aktivitesi</h1>
            <p class="text-[10px] text-slate-400">
                Kim ne zaman giriş yaptı, sistemde ne kadar süre geçirdi.
            </p>
        </div>
    </div>

    <!-- Özet Kartları -->
    <div id="summaryCards" class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-5">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4">
            <div class="text-[10px] text-slate-400 tracking-wide">Toplam Kullanıcı</div>
            <div id="sumUsers" class="text-2xl font-bold text-[#1e293b] mt-1">—</div>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4">
            <div class="text-[10px] text-slate-400 tracking-wide">Şu An Aktif</div>
            <div id="sumActive" class="text-2xl font-bold text-emerald-600 mt-1">—</div>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4">
            <div class="text-[10px] text-slate-400 tracking-wide">Toplam Giriş</div>
            <div id="sumLogins" class="text-2xl font-bold text-indigo-600 mt-1">—</div>
        </div>
    </div>

    <!-- Sekmeler -->
    <div class="flex items-center gap-1 mb-3 border-b border-slate-200">
        <button data-tab="users" class="tab-btn tab-active px-4 py-2 text-[12px] font-semibold text-[#1e293b] border-b-2 border-indigo-600 -mb-px transition-colors">
            <i class="bi bi-people mr-1"></i> Kullanıcı Özeti
        </button>
        <button data-tab="logs" class="tab-btn px-4 py-2 text-[12px] font-semibold text-slate-500 hover:text-[#1e293b] border-b-2 border-transparent -mb-px transition-colors">
            <i class="bi bi-list-ul mr-1"></i> Giriş Logları
        </button>
        <div class="ml-auto">
            <button id="refreshBtn" class="text-[11px] px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium transition-colors">
                <i class="bi bi-arrow-clockwise mr-1"></i> Yenile
            </button>
        </div>
    </div>

    <!-- Kullanıcı Özeti -->
    <div id="tab-users" class="tab-panel bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-slate-50 text-[10px] text-slate-500 tracking-wider">
                        <th class="px-5 py-2.5 text-left font-semibold">Kullanıcı</th>
                        <th class="px-5 py-2.5 text-left font-semibold">E-posta</th>
                        <th class="px-5 py-2.5 text-right font-semibold">Giriş Sayısı</th>
                        <th class="px-5 py-2.5 text-right font-semibold">Toplam Süre</th>
                        <th class="px-5 py-2.5 text-left font-semibold">Son Giriş</th>
                        <th class="px-5 py-2.5 text-center font-semibold">Durum</th>
                        <th class="px-5 py-2.5 text-right font-semibold"></th>
                    </tr>
                </thead>
                <tbody id="userTbody">
                    <tr><td colspan="7" class="px-5 py-8 text-center text-slate-400 text-sm">Yükleniyor…</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Giriş Logları (kronolojik) -->
    <div id="tab-logs" class="tab-panel hidden bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-5 py-3 border-b border-slate-100 flex items-center gap-3">
            <input id="logFilter" type="text" placeholder="E-posta veya isim ara…"
                   class="flex-1 px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
            <span id="logCount" class="text-[11px] text-slate-400 whitespace-nowrap"></span>
        </div>
        <div class="overflow-x-auto max-h-[640px] overflow-y-auto">
            <table class="w-full text-sm">
                <thead class="sticky top-0">
                    <tr class="bg-slate-50 text-[10px] text-slate-500 tracking-wider">
                        <th class="px-5 py-2.5 text-left font-semibold">Tarih</th>
                        <th class="px-5 py-2.5 text-left font-semibold">Saat</th>
                        <th class="px-5 py-2.5 text-left font-semibold">Kullanıcı</th>
                        <th class="px-5 py-2.5 text-left font-semibold">E-posta</th>
                        <th class="px-5 py-2.5 text-left font-semibold">Çıkış</th>
                        <th class="px-5 py-2.5 text-right font-semibold">Süre</th>
                        <th class="px-5 py-2.5 text-left font-semibold">IP</th>
                        <th class="px-5 py-2.5 text-center font-semibold">Durum</th>
                    </tr>
                </thead>
                <tbody id="logTbody">
                    <tr><td colspan="8" class="px-5 py-8 text-center text-slate-400 text-sm">Yükleniyor…</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detay modal -->
    <div id="detayModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-3xl w-full max-h-[80vh] flex flex-col">
            <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between">
                <h2 id="detayTitle" class="text-sm font-bold text-[#1e293b]">Oturum Geçmişi</h2>
                <button id="detayClose" class="text-slate-400 hover:text-slate-600">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="overflow-x-auto overflow-y-auto flex-1">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-slate-50 text-[10px] text-slate-500 tracking-wider sticky top-0">
                            <th class="px-4 py-2 text-left font-semibold">Giriş</th>
                            <th class="px-4 py-2 text-left font-semibold">Çıkış</th>
                            <th class="px-4 py-2 text-right font-semibold">Süre</th>
                            <th class="px-4 py-2 text-left font-semibold">IP</th>
                            <th class="px-4 py-2 text-center font-semibold">Durum</th>
                        </tr>
                    </thead>
                    <tbody id="detayTbody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    'use strict';

    var $ = function(id){ return document.getElementById(id); };

    function escapeHtml(s){
        if (s === null || s === undefined) return '';
        return String(s).replace(/[&<>"']/g, function(c){
            return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
        });
    }

    function renderUsers(rows){
        var tbody = $('userTbody');
        if (!rows || rows.length === 0){
            tbody.innerHTML = '<tr><td colspan="7" class="px-5 py-8 text-center text-slate-400 text-sm">Henüz aktivite kaydı yok.</td></tr>';
            $('sumUsers').textContent = '0';
            $('sumActive').textContent = '0';
            $('sumLogins').textContent = '0';
            return;
        }

        var totalLogins = rows.reduce(function(a, r){ return a + (r.girisAdedi || 0); }, 0);
        var activeCount = rows.filter(function(r){ return r.aktifMi; }).length;
        $('sumUsers').textContent = rows.length.toLocaleString('tr-TR');
        $('sumActive').textContent = activeCount.toLocaleString('tr-TR');
        $('sumLogins').textContent = totalLogins.toLocaleString('tr-TR');

        var html = rows.map(function(r){
            var name = r.adSoyad || r.email || ('Kullanıcı #' + r.kullaniciId);
            var initial = (name.charAt(0) || '?').toUpperCase();
            var statusBadge = r.aktifMi
                ? '<span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 font-semibold"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Aktif</span>'
                : '<span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 font-semibold">Çevrimdışı</span>';
            return ''
                + '<tr class="border-t border-slate-100 hover:bg-slate-50/60">'
                + '  <td class="px-5 py-3">'
                + '    <div class="flex items-center gap-2.5">'
                + '      <div class="w-7 h-7 rounded-lg bg-indigo-100 text-indigo-700 text-[11px] font-bold flex items-center justify-center">' + escapeHtml(initial) + '</div>'
                + '      <span class="font-medium text-[#1e293b]">' + escapeHtml(name) + '</span>'
                + '    </div>'
                + '  </td>'
                + '  <td class="px-5 py-3 text-slate-600">' + escapeHtml(r.email || '—') + '</td>'
                + '  <td class="px-5 py-3 text-right font-semibold text-[#1e293b]">' + (r.girisAdedi || 0).toLocaleString('tr-TR') + '</td>'
                + '  <td class="px-5 py-3 text-right text-indigo-700 font-semibold">' + escapeHtml(r.toplamSure) + '</td>'
                + '  <td class="px-5 py-3 text-slate-600 whitespace-nowrap">' + escapeHtml(r.sonGiris) + '</td>'
                + '  <td class="px-5 py-3 text-center">' + statusBadge + '</td>'
                + '  <td class="px-5 py-3 text-right">'
                + '    <button class="detay-btn text-[11px] px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium transition-colors" data-uid="' + r.kullaniciId + '" data-name="' + escapeHtml(name) + '">Detay</button>'
                + '  </td>'
                + '</tr>';
        }).join('');
        tbody.innerHTML = html;

        Array.prototype.forEach.call(document.querySelectorAll('.detay-btn'), function(btn){
            btn.addEventListener('click', function(){
                openDetay(parseInt(btn.dataset.uid, 10), btn.dataset.name);
            });
        });
    }

    function openDetay(uid, name){
        $('detayTitle').textContent = name + ' — Oturum Geçmişi';
        $('detayTbody').innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-slate-400 text-sm">Yükleniyor…</td></tr>';
        $('detayModal').classList.remove('hidden');

        fetch('/Aktivite/Detay?kullaniciId=' + uid, { credentials:'same-origin' })
            .then(function(r){ return r.json(); })
            .then(function(j){
                if (!j.ok || !j.data){ throw new Error('veri yok'); }
                if (j.data.length === 0){
                    $('detayTbody').innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-slate-400 text-sm">Oturum kaydı yok.</td></tr>';
                    return;
                }
                $('detayTbody').innerHTML = j.data.map(function(d){
                    var status = d.aktif
                        ? '<span class="text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 font-semibold">Aktif</span>'
                        : '<span class="text-[10px] px-1.5 py-0.5 rounded-full bg-slate-100 text-slate-500">Kapandı</span>';
                    return ''
                        + '<tr class="border-t border-slate-100">'
                        + '  <td class="px-4 py-2.5 whitespace-nowrap text-slate-700">' + escapeHtml(d.giris) + '</td>'
                        + '  <td class="px-4 py-2.5 whitespace-nowrap text-slate-500">' + escapeHtml(d.cikis || '—') + '</td>'
                        + '  <td class="px-4 py-2.5 text-right font-semibold text-indigo-700">' + escapeHtml(d.sure) + '</td>'
                        + '  <td class="px-4 py-2.5 text-slate-500">' + escapeHtml(d.ip || '—') + '</td>'
                        + '  <td class="px-4 py-2.5 text-center">' + status + '</td>'
                        + '</tr>';
                }).join('');
            })
            .catch(function(){
                $('detayTbody').innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-red-400 text-sm">Yüklenemedi.</td></tr>';
            });
    }

    function closeDetay(){ $('detayModal').classList.add('hidden'); }

    var allLogs = [];

    function renderLogs(rows){
        var q = ($('logFilter').value || '').toLowerCase().trim();
        var filtered = !q ? rows : rows.filter(function(r){
            return (r.email || '').toLowerCase().indexOf(q) >= 0
                || (r.adSoyad || '').toLowerCase().indexOf(q) >= 0;
        });

        $('logCount').textContent = filtered.length + ' kayıt';

        if (filtered.length === 0){
            $('logTbody').innerHTML = '<tr><td colspan="8" class="px-5 py-8 text-center text-slate-400 text-sm">Eşleşme bulunamadı.</td></tr>';
            return;
        }

        $('logTbody').innerHTML = filtered.map(function(r){
            var name = r.adSoyad || '—';
            var status = r.aktif
                ? '<span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 font-semibold"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Aktif</span>'
                : '<span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 font-semibold">Kapandı</span>';
            return ''
                + '<tr class="border-t border-slate-100 hover:bg-slate-50/60">'
                + '  <td class="px-5 py-2.5 text-slate-600 whitespace-nowrap">' + escapeHtml(r.tarih) + '</td>'
                + '  <td class="px-5 py-2.5 text-slate-700 font-mono text-[12px] whitespace-nowrap">' + escapeHtml(r.saat) + '</td>'
                + '  <td class="px-5 py-2.5 text-[#1e293b] font-medium">' + escapeHtml(name) + '</td>'
                + '  <td class="px-5 py-2.5 text-slate-600">' + escapeHtml(r.email || '—') + '</td>'
                + '  <td class="px-5 py-2.5 text-slate-500 font-mono text-[12px] whitespace-nowrap">' + escapeHtml(r.cikis || '—') + '</td>'
                + '  <td class="px-5 py-2.5 text-right text-indigo-700 font-semibold whitespace-nowrap">' + escapeHtml(r.sure) + '</td>'
                + '  <td class="px-5 py-2.5 text-slate-500 font-mono text-[11px]">' + escapeHtml(r.ip || '—') + '</td>'
                + '  <td class="px-5 py-2.5 text-center">' + status + '</td>'
                + '</tr>';
        }).join('');
    }

    function loadLogs(){
        fetch('/Aktivite/SonGirisler', { credentials:'same-origin' })
            .then(function(r){ return r.json(); })
            .then(function(j){
                if (!j.ok){ throw new Error('hata'); }
                allLogs = j.data || [];
                renderLogs(allLogs);
            })
            .catch(function(){
                $('logTbody').innerHTML = '<tr><td colspan="8" class="px-5 py-8 text-center text-red-400 text-sm">Veri yüklenemedi.</td></tr>';
            });
    }

    function loadUsers(){
        fetch('/Aktivite/Ozet', { credentials:'same-origin' })
            .then(function(r){ return r.json(); })
            .then(function(j){
                if (!j.ok){ throw new Error('hata'); }
                renderUsers(j.data || []);
            })
            .catch(function(){
                $('userTbody').innerHTML = '<tr><td colspan="7" class="px-5 py-8 text-center text-red-400 text-sm">Veri yüklenemedi.</td></tr>';
            });
    }

    function loadAll(){ loadUsers(); loadLogs(); }

    // Tab switching
    Array.prototype.forEach.call(document.querySelectorAll('.tab-btn'), function(btn){
        btn.addEventListener('click', function(){
            var tab = btn.dataset.tab;
            Array.prototype.forEach.call(document.querySelectorAll('.tab-btn'), function(b){
                b.classList.remove('tab-active','text-[#1e293b]','border-indigo-600');
                b.classList.add('text-slate-500','border-transparent');
            });
            btn.classList.add('tab-active','text-[#1e293b]','border-indigo-600');
            btn.classList.remove('text-slate-500','border-transparent');

            $('tab-users').classList.toggle('hidden', tab !== 'users');
            $('tab-logs').classList.toggle('hidden', tab !== 'logs');
        });
    });

    $('logFilter').addEventListener('input', function(){ renderLogs(allLogs); });
    $('refreshBtn').addEventListener('click', loadAll);
    $('detayClose').addEventListener('click', closeDetay);
    $('detayModal').addEventListener('click', function(e){ if (e.target === $('detayModal')) closeDetay(); });

    loadAll();
    setInterval(loadAll, 30000);
})();
</script>
}
