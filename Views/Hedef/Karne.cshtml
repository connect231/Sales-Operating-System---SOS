<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function(){
    const fmtTLm = v => {
        v = Number(v) || 0;
        if (Math.abs(v) >= 1e9) return '₺' + (v/1e9).toFixed(1) + 'Mr';
        if (Math.abs(v) >= 1e6) return '₺' + (v/1e6).toFixed(1) + 'M';
        if (Math.abs(v) >= 1e3) return '₺' + (v/1e3).toFixed(0) + 'K';
        return '₺' + v.toFixed(0);
    };
    const fmtPct = v => (Math.round((Number(v)||0)*10)/10).toLocaleString('tr-TR') + '%';
    const renkText = r => 'text-' + (r||'neutral');
    const initials = ad => ad.split(/\s+/).map(s => s[0]).join('').slice(0,2).toUpperCase();
    const AYLAR = ['Oca','Şub','Mar','Nis','May','Haz','Tem','Ağu','Eyl','Eki','Kas','Ara'];

    // ── Chart.js helpers — aylık trend grafikleri (Şirket Özeti + Detay) ──
    // Eski instance'ı destroy ederek tab/temsilci değişiminde memory leak engelle.
    const _chartInstances = {};
    function tlAxisCallback(v) {
        v = Number(v) || 0;
        if (Math.abs(v) >= 1e6) return (v/1e6).toFixed(1) + 'M';
        if (Math.abs(v) >= 1e3) return (v/1e3).toFixed(0) + 'K';
        return String(v);
    }
    // 12 ay × YS / Yenileme yan yana bar — ayToplamlari girdisinden
    function renderYsYenChart(canvasId, ayToplamlari) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        if (_chartInstances[canvasId]) _chartInstances[canvasId].destroy();
        const map = {};
        (ayToplamlari || []).forEach(a => { map[a.ay] = a; });
        const ysData  = []; const yenData = [];
        for (let ay = 1; ay <= 12; ay++) {
            const r = map[ay] || {};
            ysData.push(Number(r.gerceklesenYS || 0));
            yenData.push(Number(r.gerceklesenYen || 0));
        }
        _chartInstances[canvasId] = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: AYLAR,
                datasets: [
                    // Stacked sıralama: alt=Yenileme (yeşil), üst=Yeni Satış (mor) — sağ taraftaki "Ürün × Ay" ile aynı estetik.
                    { label: 'Yenileme',   data: yenData, backgroundColor: '#10b981', borderRadius: 1, maxBarThickness: 24 },
                    { label: 'Yeni Satış', data: ysData,  backgroundColor: '#818cf8', borderRadius: 1, maxBarThickness: 24 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, boxHeight: 12, font: { size: 11 } } },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ctx.dataset.label + ': ' + fmtTLm(ctx.parsed.y);
                            },
                            footer: function(items) {
                                let sum = 0; items.forEach(i => sum += i.parsed.y);
                                return 'Toplam: ' + fmtTLm(sum);
                            }
                        }
                    }
                },
                scales: {
                    x: { stacked: true, grid: { display: false }, ticks: { font: { size: 11 } } },
                    y: { stacked: true, grid: { color: '#f1f5f9' }, ticks: { callback: tlAxisCallback, font: { size: 10 } } }
                }
            }
        });
    }

    // 12 ay × her ürün için ayrı seri (stacked bar) — heatmap girdisinden
    // Sabit renk haritası — her ürün için kalıcı (renk-ürün eşleşmesi tüm ekranda aynı):
    //   Enroute=kırmızı, Stokbar=mavi, Quest=yeşil, ServiceCore=mor (kullanıcı sabit istedi)
    //   Diğerleri statik palet — Enroute kırmızı olduğu için BFG'yi eski kırmızıdan turuncuya aldık (çakışma).
    const URUN_RENK = {
        'Enroute':            '#ef4444',  // kırmızı
        'Stokbar':            '#3b82f6',  // mavi
        'Quest':              '#10b981',  // yeşil
        'ServiceCore':        '#a855f7',  // mor
        'Varuna':             '#06b6d4',  // cyan
        'E-Dönüşüm':          '#ec4899',  // pembe
        'Hosting':            '#f59e0b',  // amber
        'Bütünleşik Finans':  '#ea580c',  // turuncu (BFG — TBLSOS_HEDEF_URUN'da Ad="Bütünleşik Finans")
        'BFG':                '#ea580c',  // alias — eski etiket (geri uyumluluk)
        'Raporlama':          '#94a3b8'   // gri
    };
    function renderUrunChart(canvasId, heatmap) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        if (_chartInstances[canvasId]) _chartInstances[canvasId].destroy();
        const urunMap = {};
        (heatmap || []).forEach(c => {
            const ad = c.urunAd || '—';
            if (!urunMap[ad]) urunMap[ad] = Array(12).fill(0);
            urunMap[ad][(c.ay || 1) - 1] += Number(c.gerceklesen || 0);
        });
        // Yıl boyu toplamı hesapla, en çok satandan en aza sırala (descending)
        // Stacked bar'da ilk dataset alta düşer → en çok satan altta, en az satan tepede.
        const urunler = Object.keys(urunMap)
            .map(ad => ({ ad, total: urunMap[ad].reduce((a, b) => a + b, 0) }))
            .sort((a, b) => b.total - a.total)
            .map(x => x.ad);
        const datasets = urunler.map(ad => ({
            label: ad,
            data: urunMap[ad],
            backgroundColor: URUN_RENK[ad] || '#cbd5e1',
            borderRadius: 1, maxBarThickness: 20
        }));
        _chartInstances[canvasId] = new Chart(ctx, {
            type: 'bar',
            data: { labels: AYLAR, datasets: datasets },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 10, boxHeight: 10, font: { size: 10 }, padding: 8 } },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ctx.dataset.label + ': ' + fmtTLm(ctx.parsed.y);
                            },
                            footer: function(items) {
                                let sum = 0; items.forEach(i => sum += i.parsed.y);
                                return 'Toplam: ' + fmtTLm(sum);
                            }
                        }
                    }
                },
                scales: {
                    x: { stacked: true, grid: { display: false }, ticks: { font: { size: 11 } } },
                    y: { stacked: true, grid: { color: '#f1f5f9' }, ticks: { callback: tlAxisCallback, font: { size: 10 } } }
                }
            }
        });
    }

    // ── Detay panel için — ay-bazlı Hedef vs Gerçekleşen grouped bar ──
    function renderAyHedefGercBar(canvasId, ayToplamlari, hedefKey, gercKey, colorHedef, colorGerc) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        if (_chartInstances[canvasId]) _chartInstances[canvasId].destroy();
        const map = {};
        (ayToplamlari || []).forEach(a => { map[a.ay] = a; });
        const hedefData = []; const gercData = [];
        for (let ay = 1; ay <= 12; ay++) {
            const r = map[ay] || {};
            hedefData.push(Number(r[hedefKey] || 0));
            gercData.push(Number(r[gercKey] || 0));
        }
        _chartInstances[canvasId] = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: AYLAR,
                datasets: [
                    { label: 'Hedef',       data: hedefData, backgroundColor: colorHedef, borderRadius: 1, maxBarThickness: 18 },
                    { label: 'Gerçekleşen', data: gercData,  backgroundColor: colorGerc,  borderRadius: 1, maxBarThickness: 18 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 11, boxHeight: 11, font: { size: 10 }, padding: 6 } },
                    tooltip: {
                        callbacks: {
                            label: ctx => ctx.dataset.label + ': ' + fmtTLm(ctx.parsed.y)
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                    y: { grid: { color: '#f1f5f9' }, ticks: { callback: tlAxisCallback, font: { size: 9 } } }
                }
            }
        });
    }

    // ── Tek ürün için — 12 ay × Hedef/Gerçekleşen mini grouped bar (ürün kartı içinde) ──
    function renderUrunMiniBar(canvasId, hucreler, urunRengi) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        if (_chartInstances[canvasId]) _chartInstances[canvasId].destroy();
        const map = {};
        (hucreler || []).forEach(c => { map[c.ay] = c; });
        const hedefData = []; const gercData = [];
        for (let ay = 1; ay <= 12; ay++) {
            const r = map[ay] || {};
            hedefData.push(Number(r.hedef || 0));
            gercData.push(Number(r.gerceklesen || 0));
        }
        // Hedef bar — yarı saydam ürün rengi; Gerçekleşen — tam ürün rengi
        const colHedef = (urunRengi || '#94a3b8') + '55'; // alfa
        const colGerc  = urunRengi || '#475569';
        _chartInstances[canvasId] = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: AYLAR,
                datasets: [
                    { label: 'Hedef',       data: hedefData, backgroundColor: colHedef, borderRadius: 1, maxBarThickness: 10 },
                    { label: 'Gerçekleşen', data: gercData,  backgroundColor: colGerc,  borderRadius: 1, maxBarThickness: 10 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': ' + fmtTLm(ctx.parsed.y) } }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 8 }, autoSkip: false, maxRotation: 0 } },
                    y: { display: false, beginAtZero: true }
                }
            }
        });
    }

    // ── Ürün başına mini bar grid render — Şirket Özeti veya Detay panel'inde kullanılabilir ──
    // Veri: d.heatmap (= ürün × ay × hedef/gerceklesen) + d.urunToplamlari (= ürün × hedef/gerç toplam + attainment)
    function renderOzetUrunBarGrid(d) {
        const grid = document.getElementById('ozetUrunBarGrid');
        if (!grid) return;
        const urunBarMap = {};
        (d.heatmap || []).forEach(c => {
            if (!urunBarMap[c.urunId]) urunBarMap[c.urunId] = { ad: c.urunAd, hucreler: [] };
            urunBarMap[c.urunId].hucreler.push(c);
        });
        const urunTopMap = {};
        (d.urunToplamlari || []).forEach(u => { urunTopMap[u.urunId] = u; });
        const uids = Object.keys(urunBarMap).sort((a, b) => a - b);
        if (!uids.length) {
            grid.innerHTML = '<div style="grid-column: 1/-1; text-align:center; color:#94a3b8; padding: 24px;">Ürün bazında veri yok.</div>';
            return;
        }
        let html = '';
        uids.forEach(uid => {
            const u = urunBarMap[uid];
            const top = urunTopMap[uid] || {};
            const att = top.attainment || 0;
            const renkCls = att >= 90 ? 'green' : att >= 70 ? 'yellow' : att > 0 ? 'red' : 'neutral';
            html += `
            <div class="kr-urun-bar-card">
                <div class="kr-urun-bar-head">
                    <div class="kr-urun-bar-title" title="${u.ad}">${u.ad}</div>
                    <span class="kr-urun-bar-pct ${renkCls}">${fmtPct(att)}</span>
                </div>
                <div class="kr-urun-bar-wrap"><canvas id="chart_urun_ozet_${uid}"></canvas></div>
                <div class="kr-urun-bar-foot">
                    <span>Hedef <b>${fmtTLm(top.hedefToplam || 0)}</b></span>
                    <span>Gerç. <b>${fmtTLm(top.gerceklesenToplam || 0)}</b></span>
                </div>
            </div>`;
        });
        grid.innerHTML = html;
        requestAnimationFrame(() => {
            uids.forEach(uid => {
                const u = urunBarMap[uid];
                const renkHex = URUN_RENK[u.ad] || '#64748b';
                renderUrunMiniBar('chart_urun_ozet_' + uid, u.hucreler, renkHex);
            });
        });
    }

    const tabs = document.querySelectorAll('.kr-tab');
    const panes = document.querySelectorAll('.kr-pane');
    let listeLoaded = false;
    tabs.forEach(t => t.addEventListener('click', () => {
        if (t.disabled) return;
        const target = t.dataset.tab;
        tabs.forEach(x => x.classList.toggle('active', x === t));
        panes.forEach(p => p.classList.toggle('active', p.id === 'pane-' + target));
        if (target === 'liste' && !listeLoaded) loadTemsilciListesi();
    }));

    // ── Tab 1 ── (sayfa açılışında — kullanıcı önce burayı görür)
    let _ozetData = null;

    fetch('/Hedef/SirketOzeti').then(r => r.json()).then(j => {
        if (!j.ok) return; const d = j.data;
        _ozetData = d;
        // ── Aylık trend grafikleri (şirket geneli) ──
        // Chart.js CDN async yüklenebilir; window.Chart hazırsa hemen çiz, değilse 100ms loop
        (function tryDrawCharts(retry){
            if (typeof Chart !== 'undefined') {
                renderYsYenChart('chart_ozet_ysyen', d.ayToplamlari);
                renderUrunChart('chart_ozet_urun', d.heatmap);
                // ── Detay analizleri Şirket Özeti'ne de — Tüm şirket toplamı bazlı ──
                // 3 ana bar: Genel/YS/Yen × Ay (Hedef vs Gerçekleşen grouped)
                renderAyHedefGercBar('chart_ozet_genel', d.ayToplamlari, 'hedef',    'gerceklesen',    '#cbd5e1', '#0ea5e9');
                renderAyHedefGercBar('chart_ozet_ys2',   d.ayToplamlari, 'hedefYS',  'gerceklesenYS',  '#cbd5e1', '#8b5cf6');
                renderAyHedefGercBar('chart_ozet_yen2',  d.ayToplamlari, 'hedefYen', 'gerceklesenYen', '#cbd5e1', '#10b981');
                // Ürün başına mini bar — 8 ürün × Hedef/Gerçekleşen × Ay
                renderOzetUrunBarGrid(d);
            } else if (retry < 30) {
                setTimeout(function(){ tryDrawCharts(retry + 1); }, 100);
            }
        })(0);
        // ── Üst büyük kart: Yıllık Hedef + Yıl Sonu Tahmin ──
        document.getElementById('o_yillik').innerText = fmtTLm(d.yillikHedef);
        document.getElementById('o_yillikSub').innerHTML =
            'YS ' + fmtTLm(d.yillikHedefYS) + ' · Yen ' + fmtTLm(d.yillikHedefYen);

        document.getElementById('o_runrate').innerText = fmtTLm(d.runRate);
        var subParts = ['YS ' + fmtTLm(d.runRateYS), 'Yen ' + fmtTLm(d.runRateYen)];
        if (d.yenCappe) subParts[1] += ' 🚧';
        document.getElementById('o_runrateSub').innerHTML = subParts.join(' · ');

        // Tahmin renk (yeşil ≥%90, sarı %70-90, kırmızı <%70)
        var tahminOran = d.yillikHedef > 0 ? d.runRate / d.yillikHedef * 100 : 0;
        var tahminRenk = tahminOran >= 90 ? '#059669' : tahminOran >= 70 ? '#d97706' : '#dc2626';
        document.getElementById('o_runrate').style.color = tahminRenk;
        var tahminRenkCls = tahminOran >= 90 ? 'green' : tahminOran >= 70 ? 'yellow' : 'red';
        var pctEl = document.getElementById('o_runratePct');
        pctEl.className = 'kpi-tahmin-pct ' + tahminRenkCls;
        pctEl.textContent = 'Yıllık hedefin ' + fmtPct(tahminOran);

        // ── Multi-tick bar: YTD Hedef + Tahmin + Yıllık ticklerı (YTD Gerç yeşil dolgu) ──
        var maxBar = d.yillikHedef > 0 ? d.yillikHedef : 1;
        var pctGerc   = Math.min(100, d.ytdGerceklesen / maxBar * 100);
        var pctYtdh   = Math.min(100, d.ytdHedef / maxBar * 100);
        var pctTahmin = Math.min(100, d.runRate / maxBar * 100);

        requestAnimationFrame(function(){
            document.getElementById('mb_gerc_fill').style.width = pctGerc + '%';
            document.getElementById('mb_tahmin_fill').style.left = pctGerc + '%';
            document.getElementById('mb_tahmin_fill').style.width = Math.max(0, pctTahmin - pctGerc) + '%';
            document.getElementById('mb_tick_ytdh').style.left   = pctYtdh + '%';
            document.getElementById('mb_tick_tahmin').style.left = pctTahmin + '%';
            document.getElementById('mb_tick_yillik').style.left = '100%';
            document.getElementById('mb_lbl_ytdh').style.left    = pctYtdh + '%';
            document.getElementById('mb_lbl_tahmin').style.left  = pctTahmin + '%';
            document.getElementById('mb_lbl_yillik').style.left  = '100%';
            document.getElementById('mb_lbl_yillik').style.transform = 'translateX(-100%)';
            // Collision koruması: YTD Hedef ve Tahmin etiketleri çok yakınsa YTD'yi kaydır
            if (Math.abs(pctTahmin - pctYtdh) < 8) {
                document.getElementById('mb_lbl_ytdh').style.transform = 'translateX(-95%)';
            }
        });
        document.getElementById('mb_lbl_ytdh').innerHTML   = '<span class="lbl-name">YTD Hedef</span><span class="lbl-value">' + fmtTLm(d.ytdHedef) + '</span>';
        document.getElementById('mb_lbl_tahmin').innerHTML = '<span class="lbl-name">Tahmin</span><span class="lbl-value">' + fmtTLm(d.runRate) + '</span>';
        document.getElementById('mb_lbl_yillik').innerHTML = '<span class="lbl-name">Yıllık</span><span class="lbl-value">' + fmtTLm(d.yillikHedef) + '</span>';

        // ── Alt sol: YTD Gerçekleşen ──
        document.getElementById('o_ytdGerc').innerText = fmtTLm(d.ytdGerceklesen);
        document.getElementById('o_ytdSub').innerHTML = 'YTD Hedef ' + fmtTLm(d.ytdHedef) + ' · <b class="' + renkText(d.renkSinifi) + '">' + fmtPct(d.attainment) + '</b>';
        const bar = document.getElementById('o_bar');
        bar.className = 'kpi-fill ' + (d.renkSinifi || 'neutral');
        requestAnimationFrame(() => bar.style.width = Math.min(100, d.attainment) + '%');

        // ── Alt sağ: YS / Yenileme — YTD hedef + Yıllık hedef ──
        function ysyenPctCls(p){ return p >= 90 ? 'green' : p >= 60 ? 'yellow' : 'red'; }
        var ysYtdPct  = d.ytdHedefYS  > 0 ? d.gerceklesenYS  / d.ytdHedefYS  * 100 : 0;
        var yenYtdPct = d.ytdHedefYen > 0 ? d.gerceklesenYen / d.ytdHedefYen * 100 : 0;
        document.getElementById('o_ysVal').innerText  = fmtTLm(d.gerceklesenYS);
        document.getElementById('o_yenVal').innerText = fmtTLm(d.gerceklesenYen);
        document.getElementById('o_ysTarget').innerHTML  =
            '<div>YTD Hedef <b>' + fmtTLm(d.ytdHedefYS) + '</b><span class="ysyen-pct ' + ysyenPctCls(ysYtdPct) + '">%' + ysYtdPct.toFixed(1) + '</span></div>' +
            '<div class="ysyen-yillik">Yıllık ' + fmtTLm(d.yillikHedefYS) + '</div>';
        document.getElementById('o_yenTarget').innerHTML =
            '<div>YTD Hedef <b>' + fmtTLm(d.ytdHedefYen) + '</b><span class="ysyen-pct ' + ysyenPctCls(yenYtdPct) + '">%' + yenYtdPct.toFixed(1) + '</span></div>' +
            '<div class="ysyen-yillik">Yıllık ' + fmtTLm(d.yillikHedefYen) + '</div>';

        // Açık sinyali banner (sadece YSAcik > 0 ise göster)
        // Mantık: Yenileme yıllık hedefini %100 yapsa bile YS açığı kapanmıyor.
        if (d.ysAcik && d.ysAcik > 0) {
            // Günlük hızları frontend'de hesapla — backend ysHizOrani var ama somut sayı yok
            var ytdStart = new Date(d.yil, 0, 1);
            var nowDate  = new Date();
            var gunGecti = Math.max(1, Math.floor((nowDate - ytdStart) / 86400000) + 1);
            var kalanGun = Math.max(1, 365 - gunGecti);
            var ysGunMevcut = d.gerceklesenYS / gunGecti;
            var ysGunGerekli = Math.max(0, d.yillikHedefYS - d.gerceklesenYS) / kalanGun;
            var hizCarpan = ysGunMevcut > 0 ? (ysGunGerekli / ysGunMevcut).toFixed(1) : '∞';

            var bannerCls = d.ysHizOrani < 0.5 ? 'banner-red' : 'banner-yellow';
            var banner = document.getElementById('acikBanner');
            banner.className = 'kpi banner-card ' + bannerCls;
            // Tooltip içeriği — matematik detayı
            var tooltipHtml =
                '<h4>Hesaplama Detayı</h4>' +
                '<div class="formula-row"><span class="lbl">Bugün</span><span class="val">' + nowDate.toLocaleDateString('tr-TR') + '</span></div>' +
                '<div class="formula-row"><span class="lbl">Geçmiş gün (1 Oca → bugün)</span><span class="val">' + gunGecti + ' gün</span></div>' +
                '<div class="formula-row"><span class="lbl">Kalan gün (bugün → 31 Ara)</span><span class="val">' + kalanGun + ' gün</span></div>' +
                '<div class="formula-row"><span class="lbl">YS YTD gerçekleşen</span><span class="val">' + fmtTLm(d.gerceklesenYS) + '</span></div>' +
                '<div class="formula-row"><span class="lbl">YS yıllık hedef</span><span class="val">' + fmtTLm(d.yillikHedefYS) + '</span></div>' +
                '<div class="formula-block">' +
                  '<div class="formula-name">Şu anki hız</div>' +
                  '<code>YS YTD ÷ Geçmiş gün<br>= ' + fmtTLm(d.gerceklesenYS) + ' ÷ ' + gunGecti + ' = ' + fmtTLm(ysGunMevcut) + ' / gün</code>' +
                '</div>' +
                '<div class="formula-block">' +
                  '<div class="formula-name">Gerekli hız</div>' +
                  '<code>(YS yıllık − YS YTD) ÷ Kalan gün<br>= (' + fmtTLm(d.yillikHedefYS) + ' − ' + fmtTLm(d.gerceklesenYS) + ') ÷ ' + kalanGun + '<br>= ' + fmtTLm(d.yillikHedefYS - d.gerceklesenYS) + ' ÷ ' + kalanGun + ' = ' + fmtTLm(ysGunGerekli) + ' / gün</code>' +
                '</div>' +
                '<div class="formula-block">' +
                  '<div class="formula-name">Hızlanma katsayısı</div>' +
                  '<code>Gerekli ÷ Şu anki = ' + fmtTLm(ysGunGerekli) + ' ÷ ' + fmtTLm(ysGunMevcut) + ' = ' + hizCarpan + '×</code>' +
                '</div>';

            banner.innerHTML =
                '<div class="banner-head">' +
                  '<span class="banner-icon">⚠</span>' +
                  '<span class="banner-title">Yıl sonu açığı <b>' + fmtTLm(d.ysAcik) + '</b></span>' +
                  '<button class="info-icon" type="button" aria-label="Hesaplama detayı" tabindex="0">i</button>' +
                  '<div class="info-tooltip">' + tooltipHtml + '</div>' +
                '</div>' +
                '<div class="banner-math">' +
                  '<div class="row"><span class="lbl">Yenileme tavanı (yıllık hedef)</span><span class="val">' + fmtTLm(d.yillikHedefYen) + '</span></div>' +
                  '<div class="row"><span class="lbl">+ YS yıl sonu (mevcut hızla)</span><span class="val">' + fmtTLm(d.runRateYS) + '</span></div>' +
                  '<div class="row sep"><span class="lbl">= Tahmini kapanış</span><span class="val">' + fmtTLm(d.runRate) + '</span></div>' +
                  '<div class="row"><span class="lbl">Yıllık hedef</span><span class="val">' + fmtTLm(d.yillikHedef) + '</span></div>' +
                  '<div class="row sep total"><span class="lbl">Açık</span><span class="val">−' + fmtTLm(d.ysAcik) + '</span></div>' +
                '</div>' +
                '<div class="banner-foot">' +
                  '<div class="hiz-baslik">Yeni Satış günlük hızı</div>' +
                  '<div class="hiz-row"><span class="hiz-lbl">Şu anki</span><span class="hiz-val">' + fmtTLm(ysGunMevcut) + ' <span class="hiz-unit">/ gün</span></span></div>' +
                  '<div class="hiz-row"><span class="hiz-lbl">Hedefe varmak için</span><span class="hiz-val"><b>' + fmtTLm(ysGunGerekli) + '</b> <span class="hiz-unit">/ gün</span> <span class="hiz-x">(' + hizCarpan + '× hızlanma)</span></span></div>' +
                '</div>';
            banner.style.display = 'flex';
        }

        renderMatris();
        loadUrunListesi();
    });

    // ── Şirket Özeti — Ürün kart grid (temsilci kartının ürün eksenli karşılığı) ──
    function loadUrunListesi() {
        fetch('/Hedef/UrunListesi').then(r => r.json()).then(j => {
            if (!j.ok) return;
            const grid = document.getElementById('urunGrid');
            if (!j.data || !j.data.length) {
                grid.innerHTML = '<div style="grid-column: 1/-1; text-align:center; color:#94a3b8; padding: 24px;">Ürün hedefi bulunamadı.</div>';
                return;
            }
            grid.innerHTML = j.data.map((u, i) => {
                const renk = u.renkSinifi || 'neutral';
                const pct = Math.min(100, Math.max(0, u.attainmentTimeAdj || 0));
                const pctOutside = pct < 22;
                const colorIdx = ((i % 8) + 1);
                const ad = u.urunAd || '';
                const init = ad.replace(/[^A-Za-zÇĞİÖŞÜçğıöşü]/g, '').slice(0, 2).toUpperCase() || '??';
                const tahminPctU = u.yillikHedef > 0 ? Math.round((u.runRate / u.yillikHedef) * 100 * 10) / 10 : 0;
                const tahminRenkU = tahminPctU >= 90 ? 'green' : tahminPctU >= 70 ? 'yellow' : tahminPctU > 0 ? 'red' : 'neutral';
                return `
                <div class="rep-card" data-renk="${renk}" data-id="${u.urunId}" data-urun="${ad}">
                    <div class="rep-top">
                        <div class="urun-avatar c${colorIdx}">${init}</div>
                        <div>
                            <div class="rep-name">${ad}</div>
                        </div>
                    </div>
                    <div class="rep-row"><span>Yıllık Hedef</span><b>${fmtTLm(u.yillikHedef)}</b></div>
                    <div class="rep-row"><span>YTD Hedef</span><b>${fmtTLm(u.ytdHedef)}</b></div>
                    <div class="rep-row"><span>YTD Gerçekleşen</span><b>${fmtTLm(u.ytdGerceklesen)}</b></div>
                    <div class="rep-progress">
                        <div class="rep-progress-fill ${renk}" data-pct="${pct}">
                            <span class="rep-progress-pct ${pctOutside ? 'outside' : ''}">${fmtPct(u.attainmentTimeAdj)}</span>
                        </div>
                    </div>
                    <div class="rep-mini-grid">
                        <div class="rep-mini-col">
                            <span class="rep-mini-tag ys">Yeni Satış</span>
                            <div class="rep-mini-row"><span>YTD Hedef</span><b>${fmtTLm(u.ytdHedefYS)}</b></div>
                            <div class="rep-mini-row"><span>YTD Gerç.</span><b>${fmtTLm(u.gerceklesenYS)}</b></div>
                        </div>
                        <div class="rep-mini-col">
                            <span class="rep-mini-tag yen">Yenileme</span>
                            <div class="rep-mini-row"><span>YTD Hedef</span><b>${fmtTLm(u.ytdHedefYen)}</b></div>
                            <div class="rep-mini-row"><span>YTD Gerç.</span><b>${fmtTLm(u.gerceklesenYen)}</b></div>
                        </div>
                    </div>
                    <div class="rep-tempo">
                        <div class="rep-tempo-label">Bu hızla tahmini kapanış</div>
                        <div class="rep-tempo-value">${fmtTLm(u.runRate)}</div>
                        <div class="rep-tempo-pct ${tahminRenkU}">Yıllık hedefin %${tahminPctU.toLocaleString('tr-TR')}</div>
                    </div>
                </div>`;
            }).join('');
            requestAnimationFrame(() => {
                document.querySelectorAll('#urunGrid .rep-progress-fill').forEach(el => el.style.width = el.dataset.pct + '%');
            });
            // Tıklama davranışı şimdilik yok — ürün kartları sayfa üstünde KPI panelini tamamlar.
            document.querySelectorAll('#urunGrid .rep-card').forEach(card => { card.style.cursor = 'default'; });
        });
    }

    // Hücre içi 3 satır — Toplam (koyu, ana) → YS (mavi soluk) → Yen (mor soluk)
    function tripleCell(toplam, ys, yen, extraCls) {
        return '<td class="heat-cell ' + (extraCls || '') + '">'
             + '<div class="cell-total">'    + fmtTLm(toplam || 0) + '</div>'
             + '<div class="cell-ys-mini">'  + fmtTLm(ys || 0)     + '</div>'
             + '<div class="cell-yen-mini">' + fmtTLm(yen || 0)    + '</div>'
             + '</td>';
    }

    function renderMatris() {
        if (!_ozetData) return;
        const d = _ozetData;
        const aylar = ['Oca','Şub','Mar','Nis','May','Haz','Tem','Ağu','Eyl','Eki','Kas','Ara'];

        // (urunId, ay) → { toplam, ys, yen }
        const urunMap = {};
        d.heatmap.forEach(c => {
            urunMap[c.urunId] = urunMap[c.urunId] || { ad: c.urunAd, h: {} };
            urunMap[c.urunId].h[c.ay] = {
                toplam: c.hedef    || 0,
                ys:     c.hedefYS  || 0,
                yen:    c.hedefYen || 0
            };
        });

        let html = '<thead><tr><th></th>' + aylar.map(a => '<th>' + a + '</th>').join('') + '<th>Toplam</th></tr></thead><tbody>';
        Object.keys(urunMap).sort((a,b) => a - b).forEach(uid => {
            const u = urunMap[uid];
            let topT = 0, topYS = 0, topYen = 0;
            html += '<tr><td class="urun-name">' + u.ad + '</td>';
            for (let ay = 1; ay <= 12; ay++) {
                const v = u.h[ay] || { toplam: 0, ys: 0, yen: 0 };
                topT += v.toplam; topYS += v.ys; topYen += v.yen;
                html += tripleCell(v.toplam, v.ys, v.yen);
            }
            html += tripleCell(topT, topYS, topYen, 'total-cell');
            html += '</tr>';
        });
        // Alt toplam satır: ay başı (Toplam + YS + Yen)
        html += '<tr><td class="urun-name" style="border-top:1px solid #e2e8f0;padding-top:12px;">Toplam</td>';
        d.ayToplamlari.forEach(a => html += tripleCell(a.hedef, a.hedefYS, a.hedefYen, 'total-cell'));
        html += tripleCell(d.yillikHedef, d.yillikHedefYS, d.yillikHedefYen, 'total-cell-strong');
        html += '</tr></tbody>';
        document.getElementById('o_heatmap').innerHTML = html;
    }

    // ── Tab 2: Temsilci kart grid (lazy — sadece sekme açılınca yüklenir) ──
    function loadTemsilciListesi() {
        listeLoaded = true;
        // Alt panel: Excel benzeri matris (kart grid ile paralel yüklenir)
        loadTemsilciUrunMatris();
        fetch('/Hedef/TemsilciListesi').then(r => r.json()).then(j => {
        if (!j.ok) return;

        // Atanmamış uyarı şeridi: şirket geneli (Tab 1) ile temsilci toplamının farkı
        if (_ozetData) {
            const sirketYTD = _ozetData.ytdGerceklesen || 0;
            const atanmis = j.data.reduce((s, t) => s + (t.ytdGerceklesen || 0), 0);
            const atanmamis = sirketYTD - atanmis;
            const oran = sirketYTD > 0 ? (atanmamis / sirketYTD * 100) : 0;
            if (atanmamis > 1000) {
                const alert = document.getElementById('atanmamisAlert');
                document.getElementById('atanmamisText').innerHTML =
                    '<b>YTD Atanmamış: ' + fmtTLm(atanmamis) + '</b> (şirket toplamının ' +
                    fmtPct(oran) + ') · CRM\'de temsilci eşleşmesi olmayan hesapların faturaları. ' +
                    'Atanmış: ' + fmtTLm(atanmis) + ' · Şirket geneli: ' + fmtTLm(sirketYTD) + '.';
                alert.classList.remove('gizli');
            }
        }

        const grid = document.getElementById('repGrid');
        grid.innerHTML = j.data.map(t => {
            const renk = t.renkSinifi || 'neutral';
            const pct = Math.min(100, Math.max(0, t.attainmentTimeAdj || 0));
            const pctOutside = pct < 22; // Dar dolguda yüzde dışarı taşır
            const kanalBadge = t.kanal === 'Kanal' ? 'kanal' : '';
            // Run-rate yüzde: yıllık hedefin ne kadarını öngörüyor?
            const tahminPct = t.yillikHedef > 0 ? Math.round((t.runRate / t.yillikHedef) * 100 * 10) / 10 : 0;
            const tahminRenk = tahminPct >= 90 ? 'green' : tahminPct >= 70 ? 'yellow' : tahminPct > 0 ? 'red' : 'neutral';
            return `
            <div class="rep-card" data-renk="${renk}" data-id="${t.temsilciId}">
                <div class="rep-top">
                    <div class="rep-avatar">${initials(t.ad)}</div>
                    <div>
                        <div class="rep-name">${t.ad}</div>
                        <span class="rep-kanal ${kanalBadge}">${t.kanal}</span>
                    </div>
                </div>
                <div class="rep-row"><span>Yıllık Hedef</span><b>${fmtTLm(t.yillikHedef)}</b></div>
                <div class="rep-row"><span>YTD Hedef</span><b>${fmtTLm(t.ytdHedef)}</b></div>
                <div class="rep-row"><span>YTD Gerçekleşen</span><b>${fmtTLm(t.ytdGerceklesen)}</b></div>
                <div class="rep-progress">
                    <div class="rep-progress-fill ${renk}" data-pct="${pct}">
                        <span class="rep-progress-pct ${pctOutside ? 'outside' : ''}">${fmtPct(t.attainmentTimeAdj)}</span>
                    </div>
                </div>
                <div class="rep-mini-grid">
                    <div class="rep-mini-col">
                        <span class="rep-mini-tag ys">Yeni Satış</span>
                        <div class="rep-mini-row"><span>YTD Hedef</span><b>${fmtTLm(t.ytdHedefYS)}</b></div>
                        <div class="rep-mini-row"><span>YTD Gerç.</span><b>${fmtTLm(t.gerceklesenYS)}</b></div>
                    </div>
                    <div class="rep-mini-col">
                        <span class="rep-mini-tag yen">Yenileme</span>
                        <div class="rep-mini-row"><span>YTD Hedef</span><b>${fmtTLm(t.ytdHedefYen)}</b></div>
                        <div class="rep-mini-row"><span>YTD Gerç.</span><b>${fmtTLm(t.gerceklesenYen)}</b></div>
                    </div>
                </div>
                <div class="rep-tempo">
                    <div class="rep-tempo-label">Bu hızla tahmini kapanış</div>
                    <div class="rep-tempo-value">${fmtTLm(t.runRate)}</div>
                    <div class="rep-tempo-pct ${tahminRenk}">Yıllık hedefin %${tahminPct.toLocaleString('tr-TR')}</div>
                </div>
            </div>`;
        }).join('');
        // Animate progress bars
        requestAnimationFrame(() => {
            document.querySelectorAll('.rep-progress-fill').forEach(el => el.style.width = el.dataset.pct + '%');
        });
        // Click → detay
        document.querySelectorAll('.rep-card').forEach(card => {
            card.addEventListener('click', () => loadDetay(card.dataset.id));
        });
        });
    }

    // ── Tab 2 alt panel: Temsilci × Ürün matrisi (Excel benzeri, triple-row hücreler) ──
    function loadTemsilciUrunMatris() {
        fetch('/Hedef/TemsilciUrunMatris').then(r => r.json()).then(j => {
            if (!j.ok) return;
            const d = j.data;
            const urunler = d.urunSirasi;

            let html = '<thead><tr><th></th>';
            urunler.forEach(u => html += '<th>' + u + '</th>');
            html += '<th>Toplam</th></tr></thead><tbody>';

            d.satirlar.forEach(row => {
                html += '<tr><td class="urun-name">' + row.temsilciAd + '</td>';
                urunler.forEach(u => {
                    const t = row.urunToplam[u] || 0;
                    const ys = row.urunYS[u] || 0;
                    const yen = row.urunYen[u] || 0;
                    html += tripleCell(t, ys, yen);
                });
                html += tripleCell(row.satirToplam, row.satirYS, row.satirYen, 'total-cell');
                html += '</tr>';
            });

            // Sütun toplamları
            html += '<tr><td class="urun-name" style="border-top:1px solid #e2e8f0;padding-top:12px;">Toplam</td>';
            urunler.forEach(u => {
                html += tripleCell(d.urunToplamTop[u] || 0, d.urunToplamYS[u] || 0, d.urunToplamYen[u] || 0, 'total-cell');
            });
            html += tripleCell(d.grandToplam, d.grandYS, d.grandYen, 'total-cell-strong');
            html += '</tr></tbody>';
            document.getElementById('o_temsMatris').innerHTML = html;
        });
    }

    // ── Tab 3: Detay ──
    function loadDetay(temsilciId) {
        const dt = document.querySelector('.kr-tab[data-tab="detay"]');
        dt.disabled = false;
        tabs.forEach(x => x.classList.toggle('active', x === dt));
        panes.forEach(p => p.classList.toggle('active', p.id === 'pane-detay'));
        const c = document.getElementById('detayContent');
        c.innerHTML = '<div style="text-align:center;padding:48px;color:#94a3b8;">Yükleniyor…</div>';

        fetch('/Hedef/TemsilciDetay?temsilciId=' + temsilciId).then(r => r.json()).then(j => {
            if (!j.ok) { c.innerHTML = '<div style="padding:24px;color:#dc2626;">Hata: ' + (j.error||'') + '</div>'; return; }
            const d = j.data;
            const renk = d.attainmentTimeAdj >= 85 ? 'green' : d.attainmentTimeAdj >= 70 ? 'yellow' : 'red';
            const aylar = ['Oca','Şub','Mar','Nis','May','Haz','Tem','Ağu','Eyl','Eki','Kas','Ara'];

            // Tahmin renk (Şirket Özeti ile aynı mantık): yeşil ≥%90, sarı %70-90, kırmızı <%70
            const tahminOran = d.yillikHedef > 0 ? (d.runRate / d.yillikHedef * 100) : 0;
            const tahminRenkHex = tahminOran >= 90 ? '#059669' : tahminOran >= 70 ? '#d97706' : '#dc2626';

            let html = '<div class="kpi-grid">' +
                `<div class="kpi"><div class="kpi-label">${d.ad} · Yıllık Hedef</div><div class="kpi-value">${fmtTLm(d.yillikHedef)}</div><div class="kpi-sub">${d.kanal} · YS ${fmtTLm(d.yillikHedefYS)} · Yen ${fmtTLm(d.yillikHedefYen)}</div></div>` +
                `<div class="kpi"><div class="kpi-label">YTD Hedef</div><div class="kpi-value">${fmtTLm(d.ytdHedef)}</div></div>` +
                `<div class="kpi"><div class="kpi-label">YTD Gerçekleşen</div><div class="kpi-value">${fmtTLm(d.ytdGerceklesen)}</div><div class="kpi-sub"><b class="${renkText(renk)}">${fmtPct(d.attainmentTimeAdj)}</b></div></div>` +
                `<div class="kpi"><div class="kpi-label">Bu hızla tahmini kapanış</div><div class="kpi-value" style="color:${tahminRenkHex};">${fmtTLm(d.runRate)}</div><div class="kpi-sub">Yıllık hedefin <b>${fmtPct(tahminOran)}</b></div></div>` +
            '</div>';

            // ── Hedef × Ay bar grafikleri — 3 ana blok: Genel, Yeni Satış, Yenileme ──
            html += '<div class="kr-section-title">Aylık Hedef vs Gerçekleşen — ' + d.ad + '</div>';
            html += '<div class="kr-bar-grid">' +
                  '<div class="panel"><div class="panel-title">Genel × Ay</div>' +
                  '<div class="kr-bar-wrap"><canvas id="chart_detay_genel"></canvas></div></div>' +
                  '<div class="panel"><div class="panel-title">Yeni Satış × Ay</div>' +
                  '<div class="kr-bar-wrap"><canvas id="chart_detay_ys"></canvas></div></div>' +
                  '<div class="panel"><div class="panel-title">Yenileme × Ay</div>' +
                  '<div class="kr-bar-wrap"><canvas id="chart_detay_yen"></canvas></div></div>' +
                  '</div>';

            // ── Ürün başına ayrı bar grafiği (4-sütun grid) ──
            // Her ürün kendi mini panelinde 12 ay × Hedef/Gerçekleşen
            html += '<div class="kr-section-title">Ürün Bazında Hedef vs Gerçekleşen</div>';
            // Ürün × Ay matrisinden ürün ad'a göre grupla
            const _urunBarMap = {};
            (d.urunAyMatris || []).forEach(c => {
                const uid = c.urunId;
                if (!_urunBarMap[uid]) _urunBarMap[uid] = { ad: c.urunAd, hucreler: [] };
                _urunBarMap[uid].hucreler.push(c);
            });
            // Toplam tablosundan attainment için referans dictionary
            const _urunTopMap = {};
            (d.urunToplamlari || []).forEach(u => { _urunTopMap[u.urunId] = u; });
            // Sırayı urunToplamlari'na göre (UrunId asc), kart başına render
            html += '<div class="kr-urun-bar-grid">';
            Object.keys(_urunBarMap).sort((a,b) => a-b).forEach((uid, idx) => {
                const u = _urunBarMap[uid];
                const top = _urunTopMap[uid] || {};
                const att = top.attainment || 0;
                const renkCls = att >= 90 ? 'green' : att >= 70 ? 'yellow' : att > 0 ? 'red' : 'neutral';
                const renkHex = URUN_RENK[u.ad] || '#64748b';
                html += `
                <div class="kr-urun-bar-card">
                    <div class="kr-urun-bar-head">
                        <div class="kr-urun-bar-title" title="${u.ad}">${u.ad}</div>
                        <span class="kr-urun-bar-pct ${renkCls}">${fmtPct(att)}</span>
                    </div>
                    <div class="kr-urun-bar-wrap"><canvas id="chart_urun_${uid}"></canvas></div>
                    <div class="kr-urun-bar-foot">
                        <span>Hedef <b>${fmtTLm(top.hedefToplam || 0)}</b></span>
                        <span>Gerç. <b>${fmtTLm(top.gerceklesenToplam || 0)}</b></span>
                    </div>
                </div>`;
            });
            html += '</div>';

            // Ürün × Ay matrisi — triple-row (Toplam / YS / Yen)
            const urunMap = {};
            d.urunAyMatris.forEach(c => {
                urunMap[c.urunId] = urunMap[c.urunId] || { ad: c.urunAd, h: {} };
                urunMap[c.urunId].h[c.ay] = {
                    toplam: c.hedef    || 0,
                    ys:     c.hedefYS  || 0,
                    yen:    c.hedefYen || 0
                };
            });
            html += '<div class="panel"><div class="matris-head">'
                  + '<div class="panel-title" style="margin-bottom:0;">Ürün × Ay Hedef Matrisi</div>'
                  + '<div class="matris-legend">'
                  + '<span class="legend-item"><span class="legend-dot legend-tot"></span>Toplam</span>'
                  + '<span class="legend-item"><span class="legend-dot legend-ys"></span>Yeni Satış</span>'
                  + '<span class="legend-item"><span class="legend-dot legend-yen"></span>Yenileme</span>'
                  + '</div></div>'
                  + '<div style="overflow-x:auto;"><table class="heatmap"><thead><tr><th></th>'
                  + aylar.map(a=>'<th>'+a+'</th>').join('') + '<th>Toplam</th></tr></thead><tbody>';
            Object.keys(urunMap).sort((a,b)=>a-b).forEach(uid => {
                const u = urunMap[uid];
                let topT = 0, topYS = 0, topYen = 0;
                html += '<tr><td class="urun-name">'+u.ad+'</td>';
                for (let ay = 1; ay <= 12; ay++) {
                    const v = u.h[ay] || { toplam: 0, ys: 0, yen: 0 };
                    topT += v.toplam; topYS += v.ys; topYen += v.yen;
                    html += tripleCell(v.toplam, v.ys, v.yen);
                }
                html += tripleCell(topT, topYS, topYen, 'total-cell');
                html += '</tr>';
            });
            html += '<tr><td class="urun-name" style="border-top:1px solid #e2e8f0;padding-top:12px;">Toplam</td>';
            d.ayToplamlari.forEach(a => html += tripleCell(a.hedef, a.hedefYS, a.hedefYen, 'total-cell'));
            html += tripleCell(d.yillikHedef, d.yillikHedefYS, d.yillikHedefYen, 'total-cell-strong');
            html += '</tr></tbody></table></div></div>';

            html += '<div class="panel" style="margin-top:16px;"><div class="panel-title">Ürün Bazında Yeni Satış / Yenileme</div><table class="heatmap"><thead><tr><th></th><th>Yeni Satış</th><th>Yenileme</th><th>Toplam</th></tr></thead><tbody>';
            // Hedef/Gerç + % çift satırlı hücre
            const pctCls = p => p >= 90 ? 'gr' : p >= 70 ? 'yl' : p > 0 ? 'rd' : 'nu';
            const cellHG = (hedef, gerc, extraCls) => {
                const p = hedef > 0 ? (gerc / hedef * 100) : 0;
                return '<td class="heat-cell ' + (extraCls || '') + '">'
                     + '<div class="cell-hedef">' + fmtTLm(hedef) + '</div>'
                     + '<div class="cell-gerc ' + pctCls(p) + '">' + fmtTLm(gerc)
                     + (hedef > 0 ? '<span class="pct">' + fmtPct(p) + '</span>' : '')
                     + '</div></td>';
            };
            d.urunToplamlari.forEach(u => {
                html += '<tr><td class="urun-name">' + u.urunAd + '</td>'
                      + cellHG(u.hedefYS,     u.gerceklesenYS)
                      + cellHG(u.hedefYen,    u.gerceklesenYen)
                      + cellHG(u.hedefToplam, u.gerceklesenToplam, 'total-cell')
                      + '</tr>';
            });
            html += '</tbody></table></div>';

            c.innerHTML = html;

            // Canvas DOM hazır → grafikleri çiz (Chart.js CDN async; hazır değilse retry loop)
            (function tryDrawDetayCharts(retry){
                if (typeof Chart !== 'undefined') {
                    // 3 ana bar: Genel × Ay, Yeni Satış × Ay, Yenileme × Ay
                    renderAyHedefGercBar('chart_detay_genel', d.ayToplamlari, 'hedef',    'gerceklesen',    '#cbd5e1', '#0ea5e9');
                    renderAyHedefGercBar('chart_detay_ys',    d.ayToplamlari, 'hedefYS',  'gerceklesenYS',  '#cbd5e1', '#8b5cf6');
                    renderAyHedefGercBar('chart_detay_yen',   d.ayToplamlari, 'hedefYen', 'gerceklesenYen', '#cbd5e1', '#10b981');
                    // Ürün başına mini bar
                    Object.keys(_urunBarMap).forEach(uid => {
                        const u = _urunBarMap[uid];
                        const renkHex = URUN_RENK[u.ad] || '#64748b';
                        renderUrunMiniBar('chart_urun_' + uid, u.hucreler, renkHex);
                    });
                } else if (retry < 30) {
                    setTimeout(function(){ tryDrawDetayCharts(retry + 1); }, 100);
                }
            })(0);
        });
    }

    // URL hash ile direct-link (#temsilci=3 gibi)
    const hash = location.hash.match(/temsilci=(\d+)/);
    if (hash) loadDetay(hash[1]);
})();
</script>
