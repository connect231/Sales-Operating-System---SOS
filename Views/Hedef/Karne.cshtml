@{
    ViewData["Title"] = "Hedefler";
}

@* ═══════════════════════════════════════════════════════════════════════
   2026 Satış Karnesi — Apple-quality redesign
   Tab 1: Şirket Özeti  · KPI satırı + ürün/ay heatmap
   Tab 2: Temsilciler   · 9 kart (avatar, hedef, progress, sparkline)
   Tab 3: Detay         · seçili kişi + ürün matrisi
   ═══════════════════════════════════════════════════════════════════════ *@

<style>
    /* Aylık trend grafik gridi (Şirket Özeti + Detay) — 2 sütun, dar ekranda 1 sütun */
    .kr-chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 22px; }
    @@media (max-width: 1100px) { .kr-chart-grid { grid-template-columns: 1fr; } }
    .kr-chart-wrap { position: relative; height: 280px; }
    .kr-chart-wrap canvas { width: 100% !important; height: 100% !important; }

    /* Detay paneli — 3 ana bar grafiği grid */
    .kr-bar-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; margin-bottom: 18px; }
    @@media (max-width: 1280px) { .kr-bar-grid { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 720px)  { .kr-bar-grid { grid-template-columns: 1fr; } }
    .kr-bar-wrap { position: relative; height: 240px; }
    .kr-bar-wrap canvas { width: 100% !important; height: 100% !important; }

    /* Ürün bazında mini bar grafikleri — 4 sütun grid */
    .kr-urun-bar-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    @@media (max-width: 1280px) { .kr-urun-bar-grid { grid-template-columns: repeat(3, 1fr); } }
    @@media (max-width: 980px)  { .kr-urun-bar-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 560px)  { .kr-urun-bar-grid { grid-template-columns: 1fr; } }
    .kr-urun-bar-card {
        background: #fff; border-radius: 12px; padding: 10px 12px 12px;
        box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 0 0 1px rgba(15,23,42,.06);
    }
    .kr-urun-bar-head {
        display: flex; align-items: center; justify-content: space-between;
        gap: 8px; margin-bottom: 6px;
    }
    .kr-urun-bar-title {
        font-size: 11.5px; font-weight: 700; color: #0f172a; letter-spacing: -0.01em;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .kr-urun-bar-pct {
        font-size: 10px; font-weight: 700; font-variant-numeric: tabular-nums;
        padding: 1px 6px; border-radius: 5px; flex-shrink: 0;
    }
    .kr-urun-bar-pct.green  { background: #d1fae5; color: #065f46; }
    .kr-urun-bar-pct.yellow { background: #fef3c7; color: #92400e; }
    .kr-urun-bar-pct.red    { background: #fee2e2; color: #991b1b; }
    .kr-urun-bar-pct.neutral{ background: #f1f5f9; color: #475569; }
    .kr-urun-bar-wrap { position: relative; height: 160px; }
    .kr-urun-bar-wrap canvas { width: 100% !important; height: 100% !important; }
    .kr-urun-bar-foot {
        display: flex; justify-content: space-between; font-size: 9.5px;
        color: #64748b; margin-top: 4px; gap: 6px;
    }
    .kr-urun-bar-foot b { color: #0f172a; font-weight: 700; font-variant-numeric: tabular-nums; }
    .kr-section-title {
        font-size: 12px; font-weight: 700; color: #64748b;
        letter-spacing: 0.06em; margin: 18px 0 10px;
    }

    .kr-page { padding: 28px 36px 60px; max-width: 1480px; margin: 0 auto; }
    .kr-head { display:flex; align-items:flex-end; justify-content:space-between; margin-bottom: 28px; }
    .kr-title { font-size: 26px; font-weight: 700; color: #0f172a; letter-spacing: -0.02em; }
    .kr-sub { font-size: 13.5px; color: #64748b; margin-top: 5px; font-weight: 500; }

    /* Tabs */
    .kr-tabs { display:flex; gap:2px; background:#f1f5f9; padding:4px; border-radius:12px; }
    .kr-tab {
        padding: 9px 22px; font-size: 13px; font-weight: 600; color:#64748b;
        background:transparent; border:0; border-radius:9px; cursor:pointer;
        transition: all .25s cubic-bezier(.4,0,.2,1);
    }
    .kr-tab.active { background:#fff; color:#0f172a; box-shadow: 0 1px 4px rgba(15,23,42,.08), 0 0 0 1px rgba(15,23,42,.04); }
    .kr-tab:hover:not(.active):not(:disabled) { color:#0f172a; background: rgba(255,255,255,.55); }
    .kr-tab:disabled { opacity: .35; cursor: not-allowed; }

    .kr-pane { display:none; animation: fadeUp .3s cubic-bezier(.4,0,.2,1); }
    .kr-pane.active { display:block; }
    @@keyframes fadeUp { from { opacity:0; transform: translateY(6px); } to { opacity:1; transform: translateY(0); } }

    /* KPI yapısı — sol kolon (hero + 2 alt kart) | sağ kolon (banner full-height) */
    .kpi-stack { display: grid; gap: 14px; margin-bottom: 22px; }
    .kpi-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    /* Detay tab — 4'lü KPI satırı */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }
    @@media (max-width: 1100px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 600px)  { .kpi-grid { grid-template-columns: 1fr; } }
    .layout-grid { display: grid; grid-template-columns: 1fr 380px; gap: 14px; align-items: stretch; }
    .layout-left  { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
    .kpi {
        background: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
        border-radius: 16px; padding: 18px 22px; position: relative;
        box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 0 0 1px rgba(15,23,42,.06);
        transition: transform .25s, box-shadow .25s;
    }
    .kpi:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(15,23,42,.08), 0 0 0 1px rgba(15,23,42,.08); }
    .kpi-label { font-size: 11.5px; color: #64748b; letter-spacing: 0.04em; font-weight: 700; }
    .kpi-value { font-size: 24px; font-weight: 700; color: #0f172a; margin-top: 6px; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
    .kpi-sub { font-size: 12.5px; color: #475569; margin-top: 5px; font-weight: 500; }
    .kpi-bar { height: 6px; background: #f1f5f9; border-radius: 4px; margin-top: 12px; overflow: hidden; }
    .kpi-fill { height: 100%; border-radius: 4px; width: 0; transition: width 1.1s cubic-bezier(.4,0,.2,1); }

    /* Büyük kart — Yıllık Hedef + Yıl Sonu Tahmin birleşik */
    .kpi-hero { padding: 22px 26px 24px; }
    .kpi-hero-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 18px; flex-wrap: wrap; }
    .kpi-hero-block { min-width: 200px; }
    .kpi-hero-block .kpi-label { font-size: 11.5px; }
    .kpi-hero-block .kpi-value { font-size: 30px; line-height: 1.05; margin-top: 4px; }
    .kpi-hero-block .kpi-sub { font-size: 13.5px; margin-top: 6px; color: #475569; }
    .kpi-hero-divider {
        width: 1px; align-self: stretch; margin: 4px 0;
        background: linear-gradient(180deg, transparent 0%, #e2e8f0 30%, #e2e8f0 70%, transparent 100%);
    }

    /* Tahmini kapanış altındaki yüzde rozeti — yıllık hedefin ne kadarı? */
    .kpi-tahmin-pct {
        display: inline-block; margin-top: 8px;
        padding: 4px 12px; border-radius: 8px;
        font-size: 13px; font-weight: 700;
        font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
    }
    .kpi-tahmin-pct.green  { background: #d1fae5; color: #065f46; }
    .kpi-tahmin-pct.yellow { background: #fef3c7; color: #92400e; }
    .kpi-tahmin-pct.red    { background: #fee2e2; color: #991b1b; }

    /* Multi-tick bar — YTD Gerç (yeşil dolgu) → YTD Hedef (sarı tick) → Yıl Sonu Tahmin (turuncu tick) → Yıllık (uç) */
    .kpi-multibar-wrap { position: relative; padding-top: 6px; padding-bottom: 40px; }
    .kpi-multibar {
        position: relative; height: 10px; background: #f1f5f9; border-radius: 6px; overflow: visible;
        box-shadow: inset 0 1px 2px rgba(15,23,42,.04);
    }
    .kpi-mb-fill {
        position: absolute; top: 0; left: 0; height: 100%; border-radius: 6px;
        transition: width 1.1s cubic-bezier(.4,0,.2,1);
    }
    .kpi-mb-fill.gerc-fill { background: linear-gradient(90deg, #10b981, #059669); z-index: 3; }
    .kpi-mb-fill.tahmin-fill { background: linear-gradient(90deg, rgba(245,158,11,.55), rgba(245,158,11,.85)); z-index: 2; border-radius: 0 6px 6px 0; }
    .kpi-mb-tick {
        position: absolute; top: -6px; bottom: -6px; width: 2px;
        background: #475569; border-radius: 2px;
        transition: left 1.1s cubic-bezier(.4,0,.2,1);
    }
    .kpi-mb-tick.tick-ytd-hedef { background: #f59e0b; }
    .kpi-mb-tick.tick-tahmin    { background: #ef4444; }
    .kpi-mb-tick.tick-yillik    { background: #1e293b; }
    .kpi-mb-tick-label {
        position: absolute; top: 18px; transform: translateX(-50%);
        font-size: 11.5px; line-height: 1.25; font-weight: 600; color: #475569;
        white-space: nowrap; text-align: center;
    }
    .kpi-mb-tick-label .lbl-name { color: #64748b; font-size: 10.5px; letter-spacing: 0.02em; display: block; font-weight: 600; }
    .kpi-mb-tick-label .lbl-value { color: #1e293b; font-variant-numeric: tabular-nums; font-weight: 700; }
    .kpi-mb-tick-label.is-ytd .lbl-value { color: #059669; }
    .kpi-mb-tick-label.is-ytd-hedef .lbl-value { color: #d97706; }
    .kpi-mb-tick-label.is-tahmin .lbl-value { color: #dc2626; }
    .kpi-mb-tick-label.is-yillik .lbl-value { color: #1e293b; font-weight: 700; }

    /* YS / Yenileme kartı — alt detay (yıllık hedef ile) */
    .ysyen-row { display: flex; gap: 18px; margin-top: 4px; }
    .ysyen-col { flex: 1; min-width: 0; }
    .ysyen-tag {
        display: inline-block; font-size: 11.5px; padding: 3px 10px; border-radius: 999px;
        font-weight: 700; letter-spacing: 0.02em;
    }
    .ysyen-tag.ys  { background: #ede9fe; color: #6d28d9; }
    .ysyen-tag.yen { background: #cffafe; color: #0e7490; }
    .ysyen-val { font-size: 20px; font-weight: 700; color: #0f172a; margin-top: 8px; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
    .ysyen-target { font-size: 12px; color: #475569; margin-top: 5px; font-weight: 500; }
    .ysyen-target b { color: #0f172a; font-weight: 700; }
    .ysyen-pct { display: inline-block; padding: 2px 7px; border-radius: 5px; font-size: 11px; font-weight: 700; margin-left: 5px; }
    .ysyen-pct.green  { background: #d1fae5; color: #065f46; }
    .ysyen-pct.yellow { background: #fef3c7; color: #92400e; }
    .ysyen-pct.red    { background: #fee2e2; color: #991b1b; }
    .ysyen-yillik { font-size: 11px; color: #64748b; margin-top: 3px; letter-spacing: 0.02em; font-weight: 500; }

    .green  { background: linear-gradient(90deg, #10b981, #059669); color: #fff; }
    .yellow { background: linear-gradient(90deg, #f59e0b, #d97706); color: #fff; }
    .red    { background: linear-gradient(90deg, #ef4444, #dc2626); color: #fff; }
    .neutral { background: linear-gradient(90deg, #94a3b8, #64748b); color: #fff; }
    .text-green { color: #059669; }  .text-yellow { color: #d97706; }
    .text-red { color: #dc2626; }    .text-neutral { color: #64748b; }

    /* Banner sağ kolon — sol kolonun toplam yüksekliği kadar uzanır */
    .layout-grid > .banner-card { align-self: stretch; }

    /* Açık sinyali — ayrı kart, kompakt matematiksel detay */
    .banner-card {
        display: flex; flex-direction: column;
        padding: 14px 16px; border-radius: 14px; border: 1.5px solid;
        font-size: 12.5px; line-height: 1.45;
    }
    .banner-card.banner-red {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border-color: #fca5a5; color: #991b1b;
    }
    .banner-card.banner-yellow {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border-color: #fcd34d; color: #92400e;
    }
    .banner-card .banner-head { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }
    .banner-card .banner-icon { font-size: 16px; line-height: 1; }
    .banner-card .banner-title { font-weight: 700; font-size: 13.5px; line-height: 1.25; }

    /* Matematik mini tablo — sıkı */
    .banner-math {
        background: rgba(255,255,255,0.65); border-radius: 8px;
        padding: 9px 12px; margin-bottom: 8px;
        font-variant-numeric: tabular-nums; font-size: 12px;
        line-height: 1.4;
    }
    .banner-math .row { display: flex; justify-content: space-between; padding: 2px 0; gap: 8px; }
    .banner-math .row .lbl { color: inherit; opacity: 0.88; }
    .banner-math .row .val { font-weight: 600; }
    .banner-math .row.sep { border-top: 1px dashed rgba(0,0,0,0.18); margin-top: 4px; padding-top: 5px; }
    .banner-math .row.total { font-weight: 800; }
    .banner-math .row.total .val { font-size: 13.5px; }
    .banner-card .banner-foot { font-size: 12px; opacity: 0.95; line-height: 1.45; }
    .banner-card .banner-foot b { font-weight: 700; }
    .banner-card .hiz-baslik {
        font-weight: 700; font-size: 12px; margin-bottom: 4px;
        opacity: 0.92; letter-spacing: 0.01em;
    }
    .banner-card .hiz-row {
        display: flex; justify-content: space-between; align-items: baseline;
        padding: 2px 0; gap: 8px;
    }
    .banner-card .hiz-lbl { opacity: 0.88; font-size: 12px; }
    .banner-card .hiz-val { font-weight: 700; font-variant-numeric: tabular-nums; font-size: 13px; }
    .banner-card .hiz-unit { opacity: 0.65; font-size: 11px; font-weight: 500; }
    .banner-card .hiz-x { opacity: 0.88; font-size: 11px; font-weight: 600; margin-left: 3px; }

    /* Info ikon + tooltip — banner başlığında ⓘ, hover ile matematik detayı */
    .banner-card .banner-head { position: relative; }
    .info-icon {
        display: inline-flex; align-items: center; justify-content: center;
        width: 16px; height: 16px; border-radius: 50%;
        background: rgba(0,0,0,0.08); color: inherit;
        font-size: 10px; font-weight: 700; cursor: help;
        border: 0; margin-left: auto; flex-shrink: 0;
        transition: background 0.2s;
    }
    .info-icon:hover { background: rgba(0,0,0,0.18); }
    .info-tooltip {
        position: absolute; top: 28px; right: -4px; z-index: 50;
        width: 320px; padding: 12px 14px;
        background: #1e293b; color: #e2e8f0;
        border-radius: 10px; box-shadow: 0 8px 24px rgba(15,23,42,0.25);
        font-size: 11px; line-height: 1.55; font-variant-numeric: tabular-nums;
        opacity: 0; visibility: hidden; transform: translateY(-4px);
        transition: opacity 0.18s, transform 0.18s, visibility 0.18s;
        pointer-events: none;
    }
    .info-tooltip::before {
        content: ''; position: absolute; top: -6px; right: 12px;
        width: 12px; height: 12px; background: #1e293b;
        transform: rotate(45deg);
    }
    .info-icon:hover + .info-tooltip,
    .info-icon:focus + .info-tooltip,
    .info-tooltip:hover {
        opacity: 1; visibility: visible; transform: translateY(0);
        pointer-events: auto;
    }
    .info-tooltip h4 { margin: 0 0 8px 0; font-size: 11px; font-weight: 700; color: #fbbf24; letter-spacing: 0.02em; }
    .info-tooltip .formula-row {
        display: flex; justify-content: space-between; gap: 8px;
        padding: 3px 0; border-bottom: 1px dashed rgba(226,232,240,0.12);
    }
    .info-tooltip .formula-row:last-child { border-bottom: 0; }
    .info-tooltip .formula-row .lbl { color: #94a3b8; }
    .info-tooltip .formula-row .val { color: #e2e8f0; font-weight: 600; }
    .info-tooltip .formula-block { margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(226,232,240,0.18); }
    .info-tooltip .formula-block .formula-name { color: #fbbf24; font-weight: 700; margin-bottom: 4px; }
    .info-tooltip .formula-block code {
        display: block; padding: 6px 8px; background: rgba(0,0,0,0.3);
        border-radius: 6px; font-size: 10.5px; color: #cbd5e1;
        font-family: ui-monospace, 'SF Mono', Consolas, monospace;
        margin-bottom: 4px;
    }

    /* Ürün kart grid (Şirket Özeti) — rep-card şablonunun ürün eksenli kardeşi */
    .urun-grid { display:grid; grid-template-columns: repeat(4, 1fr); gap:10px; margin-bottom: 22px; }
    .urun-card-section-title {
        font-size: 12px; font-weight: 700; color: #64748b; letter-spacing: 0.06em;
        text-transform: none; margin: 4px 0 10px;
    }
    .urun-avatar {
        width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
        color: #fff; font-weight: 700; font-size: 11px;
        display: flex; align-items: center; justify-content: center;
        letter-spacing: -0.02em;
    }
    /* 8 ana ürün için sabit gradient paleti (sırayla atanır) */
    .urun-avatar.c1 { background: linear-gradient(135deg, #6366f1, #8b5cf6); }
    .urun-avatar.c2 { background: linear-gradient(135deg, #06b6d4, #0ea5e9); }
    .urun-avatar.c3 { background: linear-gradient(135deg, #10b981, #059669); }
    .urun-avatar.c4 { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .urun-avatar.c5 { background: linear-gradient(135deg, #ec4899, #db2777); }
    .urun-avatar.c6 { background: linear-gradient(135deg, #14b8a6, #0d9488); }
    .urun-avatar.c7 { background: linear-gradient(135deg, #ef4444, #dc2626); }
    .urun-avatar.c8 { background: linear-gradient(135deg, #8b5cf6, #6366f1); }
    .rep-kanal.agirlik-ys  { background:#ede9fe; color:#6d28d9; }
    .rep-kanal.agirlik-yen { background:#cffafe; color:#0e7490; }

    /* Temsilci kartları — kompakt 4 sütun */
    .rep-grid { display:grid; grid-template-columns: repeat(4, 1fr); gap:10px; }
    .rep-card {
        background:#fff; border-radius:12px; padding:13px 14px;
        box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 0 0 1px rgba(15,23,42,.06);
        cursor:pointer; transition: all .25s cubic-bezier(.4,0,.2,1);
        position: relative; overflow: hidden;
    }
    .rep-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(15,23,42,.1), 0 0 0 1px rgba(14,165,233,.2); }
    .rep-card::before {
        content:''; position:absolute; top:0; left:0; right:0; height:2px;
        background: var(--accent, #94a3b8);
    }
    .rep-card[data-renk="green"]  { --accent: #10b981; }
    .rep-card[data-renk="yellow"] { --accent: #f59e0b; }
    .rep-card[data-renk="red"]    { --accent: #ef4444; }

    .rep-top { display:flex; align-items:center; gap:8px; margin-bottom: 10px; }
    .rep-avatar {
        width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff; font-weight: 700; font-size: 11px;
        display: flex; align-items: center; justify-content: center;
        letter-spacing: -0.02em;
    }
    .rep-name { font-size: 12px; font-weight: 700; color: #0f172a; line-height: 1.2; }
    .rep-kanal { font-size: 9px; padding: 1px 6px; border-radius: 999px; background: #e0f2fe; color: #0369a1; font-weight: 600; margin-top: 3px; display: inline-block; }
    .rep-kanal.kanal { background: #fef3c7; color: #92400e; }

    .rep-row { display:flex; justify-content: space-between; font-size: 10px; color: #64748b; margin: 3px 0; }
    .rep-row b { color: #0f172a; font-weight: 700; font-variant-numeric: tabular-nums; }
    .rep-progress {
        position: relative; height: 18px; background: #f1f5f9;
        border-radius: 9px; overflow: visible; margin: 10px 0 6px;
        box-shadow: inset 0 1px 2px rgba(15,23,42,.04);
    }
    .rep-progress-fill {
        height: 100%; border-radius: 9px; width: 0;
        transition: width 1s cubic-bezier(.4,0,.2,1);
        position: relative;
    }
    .rep-progress-pct {
        position: absolute; top: 50%; transform: translateY(-50%);
        right: 8px;
        font-size: 10.5px; font-weight: 800; color: #fff;
        font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
        white-space: nowrap; text-shadow: 0 1px 2px rgba(0,0,0,.28);
        pointer-events: none;
    }
    /* Bar dolgusu çok dar ise yüzde etiketini dışarı (sağ tarafa) taşı, koyu renk */
    .rep-progress-pct.outside {
        right: auto; left: calc(100% + 6px);
        color: #1e293b; text-shadow: none;
        background: rgba(255,255,255,0.92); padding: 1px 6px; border-radius: 4px;
        border: 1px solid #e2e8f0;
    }

    /* Kart içi YS/Yen mini breakdown — yıllık hedef + YTD gerçekleşen */
    .rep-mini-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
        margin: 8px 0 2px; padding: 7px 8px;
        background: #f8fafc; border-radius: 8px;
    }
    .rep-mini-col { min-width: 0; }
    .rep-mini-tag {
        font-size: 9px; font-weight: 700; letter-spacing: 0.02em;
        padding: 1px 6px; border-radius: 999px;
        display: inline-block; margin-bottom: 4px;
    }
    .rep-mini-tag.ys  { background: #ede9fe; color: #6d28d9; }
    .rep-mini-tag.yen { background: #cffafe; color: #0e7490; }
    .rep-mini-row {
        display: flex; justify-content: space-between; align-items: baseline;
        font-size: 9.5px; color: #64748b; margin: 1px 0; line-height: 1.35;
    }
    .rep-mini-row b { color: #0f172a; font-weight: 700; font-variant-numeric: tabular-nums; }

    .rep-tempo { display:flex; flex-direction: column; align-items: flex-end; margin-top: 9px; padding-top: 9px; border-top: 1px solid #f1f5f9; gap: 2px; }
    .rep-tempo-label { font-size: 9px; color: #94a3b8; letter-spacing: .05em; font-weight: 700; }
    .rep-tempo-value { font-size: 14px; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; line-height: 1.1; }
    .rep-tempo-pct {
        display: inline-block; padding: 1px 7px; border-radius: 6px;
        font-size: 10px; font-weight: 700; font-variant-numeric: tabular-nums;
        margin-top: 2px;
    }
    .rep-tempo-pct.green  { background: #d1fae5; color: #065f46; }
    .rep-tempo-pct.yellow { background: #fef3c7; color: #92400e; }
    .rep-tempo-pct.red    { background: #fee2e2; color: #991b1b; }
    .rep-tempo-pct.neutral{ background: #f1f5f9; color: #475569; }

    /* Atanmamış uyarı şeridi */
    .atanmamis-alert {
        background: #fef3c7; border: 1px solid #fbbf24;
        border-radius: 10px; padding: 9px 14px; margin-bottom: 12px;
        display: flex; align-items: center; gap: 10px;
        color: #92400e; font-size: 11px; line-height: 1.4;
    }
    .atanmamis-alert i { font-size: 14px; flex-shrink: 0; }
    .atanmamis-alert b { font-weight: 700; }
    .atanmamis-alert.gizli { display: none; }

    /* Heatmap (Şirket Özeti) */
    .panel { background:#fff; border-radius:16px; padding: 22px 24px; box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 0 0 1px rgba(15,23,42,.06); }
    .panel-title { font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 14px; letter-spacing: -0.01em; }
    .heatmap { width:100%; border-collapse: separate; border-spacing: 4px; font-size: 11px; }
    .heatmap th { font-weight: 700; color: #94a3b8; font-size: 10px; padding: 8px 6px; letter-spacing: 0.05em; }
    .heatmap td.urun-name { text-align: left; font-weight: 600; color: #0f172a; padding: 8px 12px 8px 4px; white-space: nowrap; }
    .heatmap td.heat-cell {
        text-align: right;
        padding: 8px 10px;
        border-radius: 8px;
        background: #fafbfc;
        border: 1px solid #eef2f7;
        font-variant-numeric: tabular-nums;
        transition: background .15s, border-color .15s;
    }
    .heatmap td.heat-cell:hover { background: #fff; border-color: #cbd5e1; }
    .heatmap td.total-cell { background: #f1f5f9; border-color: #e2e8f0; }
    .heatmap td.total-cell-strong { background: #0f172a; color: #fff; border-color: #0f172a; }

    .skeleton { display:inline-block; width:80px; height:14px; background:linear-gradient(90deg,#f1f5f9 0%, #e2e8f0 50%, #f1f5f9 100%); background-size: 200% 100%; border-radius:4px; animation: shimmer 1.4s linear infinite; }
    @@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    .num { font-variant-numeric: tabular-nums; }

    /* Matris başlık + legend */
    .matris-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; gap: 12px; flex-wrap: wrap; }
    .matris-legend { display: flex; gap: 14px; font-size: 10px; color: #64748b; font-weight: 600; letter-spacing: 0.04em; }
    .legend-item { display: flex; align-items: center; gap: 6px; }
    .legend-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .legend-tot { background: #0f172a; }   /* siyah — Toplam (asıl hedef) */
    .legend-ys  { background: #3b82f6; }   /* mavi — Yeni Satış */
    .legend-yen { background: #8b5cf6; }   /* mor — Yenileme */

    /* Hücre içi 3 satır: Toplam (koyu, ana) → ayırıcı → YS (mavi soluk) + Yen (mor soluk) */
    .cell-total {
        color: #0f172a;
        font-weight: 700;
        font-size: 12px;
        font-variant-numeric: tabular-nums;
        padding-bottom: 4px;
        border-bottom: 1px dashed #e2e8f0;
        margin-bottom: 4px;
    }
    .cell-ys-mini  { color: #3b82f6; font-size: 10px; font-weight: 500; font-variant-numeric: tabular-nums; line-height: 1.4; }
    .cell-yen-mini { color: #8b5cf6; font-size: 10px; font-weight: 500; font-variant-numeric: tabular-nums; line-height: 1.4; }
    .heatmap td.total-cell-strong .cell-total { color: #fff; border-bottom-color: rgba(255,255,255,0.2); }
    .heatmap td.total-cell-strong .cell-ys-mini { color: #93c5fd; }
    .heatmap td.total-cell-strong .cell-yen-mini { color: #c4b5fd; }
    .heatmap td.total-cell .cell-total { font-size: 13px; }

    /* İki satırlı Hedef/Gerç hücresi (Detay tab — Ürün Bazında YS/Yen tablosu) */
    .cell-hedef { color: #0f172a; font-weight: 700; font-size: 12px; font-variant-numeric: tabular-nums; }
    .cell-gerc {
        font-size: 10.5px; font-weight: 600; font-variant-numeric: tabular-nums;
        margin-top: 2px; display: flex; justify-content: flex-end; align-items: baseline; gap: 6px;
    }
    .cell-gerc .pct {
        font-size: 9px; font-weight: 700; padding: 1px 5px; border-radius: 4px;
    }
    .cell-gerc.gr  { color: #059669; } .cell-gerc.gr  .pct { background: #d1fae5; color: #065f46; }
    .cell-gerc.yl  { color: #d97706; } .cell-gerc.yl  .pct { background: #fef3c7; color: #92400e; }
    .cell-gerc.rd  { color: #dc2626; } .cell-gerc.rd  .pct { background: #fee2e2; color: #991b1b; }
    .cell-gerc.nu  { color: #64748b; } .cell-gerc.nu  .pct { background: #f1f5f9; color: #475569; }
</style>

