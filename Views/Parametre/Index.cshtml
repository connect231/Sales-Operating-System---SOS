@{
    ViewData["Title"] = "Parametreler";
    var selectedYil = (int)ViewBag.SelectedYil;
    var selectedSenaryoId = (int)ViewBag.SelectedSenaryoId;
    var senaryolar = (List<SOS.Models.MsK.TBLSOS_HEDEF_SENARYO>)ViewBag.Senaryolar;
    var urunler = (List<SOS.Models.MsK.TBLSOS_HEDEF_URUN>)ViewBag.Urunler;
    var matris = (Dictionary<(int UrunId, int Ay), decimal>)ViewBag.HedefMatris;
    var matrisYS = (Dictionary<(int UrunId, int Ay), decimal>)ViewBag.HedefMatrisYS;
    var matrisYen = (Dictionary<(int UrunId, int Ay), decimal>)ViewBag.HedefMatrisYen;
    var anaUrunler = (List<SOS.Models.MsK.TBLSOS_ANA_URUN>)ViewBag.AnaUrunler;
    var eslestirmeSayilari = (Dictionary<int, int>)ViewBag.EslestirmeSayilari;
    var toplamEslestirme = (int)ViewBag.ToplamEslestirme;
    var yillikToplam = (decimal)ViewBag.YillikToplam;
    var aylar = new[] { "Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara" };
}

<!-- HEADER -->
<div class="flex items-center justify-between mb-6 fade-ready">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-blue-100 flex items-center justify-center">
            <i class="bi bi-sliders text-blue-700 text-lg"></i>
        </div>
        <div>
            <h1 class="text-xl font-bold text-[#1e293b] tracking-tight">Parametreler</h1>
            <p class="text-[11px] text-slate-400">Hedefler &middot; Ürün eşleştirme &middot; Genel ayarlar</p>
        </div>
    </div>
</div>

<!-- TAB NAV -->
<div class="flex gap-1 mb-5 fade-ready">
    <button onclick="switchTab('hedefler')" id="tab-hedefler" class="param-tab active px-4 py-2 rounded-xl text-xs font-semibold transition-all">
        <i class="bi bi-bullseye mr-1.5"></i>Aylık hedefler
    </button>
    <button onclick="switchTab('urunler')" id="tab-urunler" class="param-tab px-4 py-2 rounded-xl text-xs font-semibold transition-all">
        <i class="bi bi-box-seam mr-1.5"></i>Ürün eşleştirme
    </button>
    <button onclick="switchTab('ayarlar')" id="tab-ayarlar" class="param-tab px-4 py-2 rounded-xl text-xs font-semibold transition-all">
        <i class="bi bi-gear mr-1.5"></i>Genel ayarlar
    </button>
</div>

<!-- ═══ TAB 1: ÜRÜN × AY EDİTÖR MATRİSİ ═══ -->
<div id="panel-hedefler" class="param-panel fade-ready">
    <!-- Üst kontroller: senaryo + yıllık toplam + kaydet -->
    <div class="flex items-center justify-between mb-4 gap-4 flex-wrap">
        <div class="flex items-center gap-3">
            <select id="senaryoSelect" onchange="onSenaryoChange(this.value)"
                    class="text-sm px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 font-semibold focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
                @if (senaryolar.Count == 0)
                {
                    <option value="@selectedSenaryoId" selected>Senaryo @selectedSenaryoId</option>
                }
                else
                {
                    @foreach (var s in senaryolar)
                    {
                        if (s.Id == selectedSenaryoId)
                        { <option value="@s.Id" selected>@s.Ad (@s.Yil)</option> }
                        else
                        { <option value="@s.Id">@s.Ad (@s.Yil)</option> }
                    }
                }
            </select>
            <span class="text-xs text-slate-400">Senaryo</span>

            <!-- Sub-tab: Toplam / Yeni Satış / Yenileme -->
            <div class="ml-3 inline-flex items-center gap-0.5 bg-slate-100 rounded-lg p-0.5" role="tablist">
                <button type="button" onclick="switchSatisTipi('Toplam')" id="st-Toplam"
                        class="st-btn active text-[11px] font-semibold px-3 py-1.5 rounded-md">Toplam</button>
                <button type="button" onclick="switchSatisTipi('YeniSatis')" id="st-YeniSatis"
                        class="st-btn text-[11px] font-semibold px-3 py-1.5 rounded-md">Yeni Satış</button>
                <button type="button" onclick="switchSatisTipi('Yenileme')" id="st-Yenileme"
                        class="st-btn text-[11px] font-semibold px-3 py-1.5 rounded-md">Yenileme</button>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="text-right">
                <p class="text-[10px] text-slate-400">Yıllık toplam</p>
                <p id="yillikToplam" class="text-lg font-bold text-[#1e293b]">₺@((yillikToplam / 1_000_000m).ToString("N1"))M</p>
            </div>
            <button onclick="saveMatris()" id="btnSave"
                    class="px-4 py-2 rounded-xl bg-blue-600 text-white text-xs font-semibold hover:bg-blue-700 transition-colors flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                <i class="bi bi-check2-circle"></i> Kaydet
            </button>
        </div>
    </div>

    <!-- Editör matrisi: 8 ürün × 12 ay -->
    <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="hedef-matris w-full text-xs">
                <thead>
                    <tr>
                        <th class="text-left px-3 py-2.5 font-semibold text-slate-500 sticky left-0 bg-slate-50 z-10">Ürün</th>
                        @foreach (var ay in aylar)
                        {
                            <th class="text-center px-1.5 py-2.5 font-semibold text-slate-400 text-[10px] tracking-wide">@ay</th>
                        }
                        <th class="text-right px-3 py-2.5 font-semibold text-slate-700 bg-slate-50">Toplam</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var urun in urunler)
                    {
                        var urunYillik = Enumerable.Range(1, 12).Sum(ay => matris.TryGetValue((urun.Id, ay), out var v) ? v : 0m);
                        <tr class="border-t border-slate-100 hover:bg-blue-50/20">
                            <td class="text-left px-3 py-1.5 font-semibold text-[#1e293b] sticky left-0 bg-white whitespace-nowrap z-10" data-urun-id="@urun.Id">@urun.Ad</td>
                            @for (int ay = 1; ay <= 12; ay++)
                            {
                                var tutarTop = matris.TryGetValue((urun.Id, ay), out var vT) ? vT : 0m;
                                var tutarYS  = matrisYS.TryGetValue((urun.Id, ay), out var vY) ? vY : 0m;
                                var tutarYen = matrisYen.TryGetValue((urun.Id, ay), out var vN) ? vN : 0m;
                                // JS parseFloat için invariant culture (nokta) — virgül kabul etmiyor
                                var inv = System.Globalization.CultureInfo.InvariantCulture;
                                var attrTop = tutarTop.ToString("0.##", inv);
                                var attrYS  = tutarYS.ToString("0.##", inv);
                                var attrYen = tutarYen.ToString("0.##", inv);
                                var displayM = tutarTop > 0 ? (tutarTop / 1_000_000m).ToString("0.##") : "";
                                <td class="text-center px-0.5 py-1">
                                    <input type="text"
                                           data-urun="@urun.Id"
                                           data-ay="@ay"
                                           data-toplam="@attrTop"
                                           data-ys="@attrYS"
                                           data-yen="@attrYen"
                                           value="@displayM"
                                           placeholder="0"
                                           oninput="onCellInput(this)"
                                           class="hedef-cell w-16 px-1.5 py-1 text-center text-xs font-semibold text-[#1e293b] bg-transparent border border-transparent rounded-md focus:bg-white focus:border-blue-400 focus:ring-1 focus:ring-blue-100 outline-none transition-colors" />
                                </td>
                            }
                            <td class="text-right px-3 py-1.5 font-bold text-slate-700 bg-slate-50/60 whitespace-nowrap" data-row-toplam="@urun.Id">
                                ₺@((urunYillik / 1_000_000m).ToString("N1"))M
                            </td>
                        </tr>
                    }
                    <tr class="border-t-2 border-slate-200 bg-slate-50/80">
                        <td class="text-left px-3 py-2.5 font-bold text-[#1e293b] sticky left-0 bg-slate-50/80 z-10">Toplam</td>
                        @for (int ay = 1; ay <= 12; ay++)
                        {
                            var ayToplam = urunler.Sum(u => matris.TryGetValue((u.Id, ay), out var v) ? v : 0m);
                            <td class="text-center px-1 py-2.5 font-bold text-[11px] text-slate-700 whitespace-nowrap" data-col-toplam="@ay">
                                @if (ayToplam > 0)
                                { <text>₺@((ayToplam / 1_000_000m).ToString("0.#"))M</text> }
                                else
                                { <text>—</text> }
                            </td>
                        }
                        <td class="text-right px-3 py-2.5 font-bold text-blue-700 whitespace-nowrap" id="grandToplam">
                            ₺@((yillikToplam / 1_000_000m).ToString("N1"))M
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Bilgi notu -->
    <div class="mt-4 flex items-start gap-2 text-[11px] text-slate-500">
        <i class="bi bi-info-circle text-slate-400 mt-0.5"></i>
        <p>
            Tüm tutarlar <b>milyon TL</b> cinsindendir (örn. <code class="text-slate-700 bg-slate-100 px-1.5 rounded">42,2</code> = ₺42,2M).
            Hücreyi düzenleyince yıllık toplam &amp; ay toplamı canlı hesaplanır. Kaydet butonu Cockpit, Fırsat Analizi ve Hedefler ekranındaki cache'leri otomatik tazeler.
            Yeni Satış / Yenileme oranı mevcut veriden korunur (eski Toplam=0 ise %50/%50 default).
        </p>
    </div>
</div>

<!-- ═══ TAB 2: ÜRÜN EŞLEŞTİRME ═══ -->
<div id="panel-urunler" class="param-panel hidden fade-ready">
    <!-- Üst rozet sırası: 8 ana ürün × adet -->
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-2 mb-4">
        @foreach (var u in anaUrunler)
        {
            var adet = eslestirmeSayilari.TryGetValue(u.Id, out var n) ? n : 0;
            <button onclick="filterByAnaUrun(@u.Id, '@u.Ad')" data-anaurun-rozet="@u.Id"
                    class="anaurun-rozet text-left px-3 py-2.5 rounded-xl bg-white border border-slate-100 hover:border-blue-300 hover:shadow-sm transition-all group">
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wide truncate">@u.Ad</p>
                <p class="text-base font-bold text-[#1e293b] mt-0.5">@adet.ToString("N0")</p>
                <p class="text-[9px] text-slate-300">stok kodu</p>
            </button>
        }
    </div>

    <!-- Filtre + arama -->
    <div class="flex items-center gap-2 mb-3 flex-wrap">
        <div class="relative flex-1 min-w-[240px] max-w-md">
            <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-300 text-xs"></i>
            <input id="esSearch" type="text" placeholder="Stok kodu, ürün adı veya mask ara…"
                   class="w-full pl-8 pr-3 py-1.5 rounded-xl border border-slate-200 bg-white text-xs text-slate-700 focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100" />
        </div>
        <select id="esAnaUrunFilter"
                class="text-xs px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 font-semibold focus:outline-none focus:border-blue-400">
            <option value="">Tüm ana ürünler</option>
            @foreach (var u in anaUrunler)
            {
                <option value="@u.Id">@u.Ad</option>
            }
        </select>
        <span id="esCount" class="text-[11px] text-slate-400 ml-auto">@toplamEslestirme.ToString("N0") kayıt</span>
    </div>

    <!-- Tablo -->
    <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="es-tablo w-full text-xs">
                <thead class="bg-slate-50 text-[10px] text-slate-500 uppercase tracking-wide">
                    <tr>
                        <th class="text-left px-4 py-2.5 font-semibold">Stok Kodu</th>
                        <th class="text-left px-4 py-2.5 font-semibold">Ürün Adı</th>
                        <th class="text-left px-3 py-2.5 font-semibold">Mask</th>
                        <th class="text-left px-3 py-2.5 font-semibold">Lisans Tipi</th>
                        <th class="text-left px-3 py-2.5 font-semibold">Ana Ürün</th>
                    </tr>
                </thead>
                <tbody id="esTbody">
                    <tr><td colspan="5" class="text-center text-slate-300 py-12">Yükleniyor…</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between mt-3 text-[11px] text-slate-500">
        <button id="esPrev" onclick="esPage(-1)" disabled
                class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-blue-300 disabled:opacity-40 disabled:cursor-not-allowed font-semibold">
            <i class="bi bi-chevron-left"></i> Önceki
        </button>
        <span id="esPageInfo">Sayfa 1</span>
        <button id="esNext" onclick="esPage(1)"
                class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-blue-300 disabled:opacity-40 disabled:cursor-not-allowed font-semibold">
            Sonraki <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>

<!-- ═══ TAB 3: GENEL AYARLAR (placeholder) ═══ -->
<div id="panel-ayarlar" class="param-panel hidden fade-ready">
    <div class="bg-white rounded-xl border border-slate-100 p-8 text-center">
        <i class="bi bi-gear text-4xl text-slate-200"></i>
        <p class="text-sm text-slate-400 mt-3">Genel ayarlar ekranı yapım aşamasında</p>
    </div>
</div>

@section Scripts {
<style>
    .param-tab { background: #f1f5f9; color: #64748b; }
    .param-tab.active { background: #1e40af; color: white; box-shadow: 0 2px 8px rgba(30,64,175,0.25); }
    .param-tab:not(.active):hover { background: #e2e8f0; }
    .hedef-matris { border-collapse: separate; border-spacing: 0; font-variant-numeric: tabular-nums; }
    .hedef-matris th { font-size: 10px; letter-spacing: 0.05em; }
    .hedef-cell::placeholder { color: #cbd5e1; }
    .hedef-cell.dirty { background: #fef3c7; border-color: #fbbf24; }
    /* Satış tipi sub-tab pill — Toplam (varsayılan koyu), YS (mavi), Yen (mor) aktifken */
    .st-btn { color: #64748b; background: transparent; border: 0; cursor: pointer; transition: all .18s; }
    .st-btn:hover:not(.active) { color: #334155; }
    .st-btn.active { background: #fff; color: #0f172a; box-shadow: 0 1px 3px rgba(15,23,42,.08); }
    .st-btn.active[id="st-YeniSatis"] { color: #1e40af; }
    .st-btn.active[id="st-Yenileme"]  { color: #6d28d9; }
    /* Aktif satış tipine göre input vurgu rengi */
    body[data-satis-tipi="YeniSatis"] .hedef-cell:not(.dirty) { color: #1e40af; }
    body[data-satis-tipi="Yenileme"]  .hedef-cell:not(.dirty) { color: #6d28d9; }
    .es-tablo tbody tr { border-top: 1px solid #f1f5f9; }
    .es-tablo tbody tr:hover { background: #f8fafc; }
    .anaurun-rozet.active { border-color: #3b82f6; background: #eff6ff; box-shadow: 0 0 0 1px #3b82f6 inset; }
    .es-select { min-width: 130px; padding: 4px 8px; border-radius: 8px; border: 1px solid #e2e8f0; background: #fff; font-size: 11px; font-weight: 600; }
    .es-select:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 1px #3b82f6; }
    .es-select.saved { border-color: #10b981; background: #ecfdf5; }
    .es-select.saving { opacity: 0.5; pointer-events: none; }
    .es-select.error { border-color: #ef4444; background: #fef2f2; }
</style>
<script>
(function(){
    'use strict';

    var dirty = false;
    var senaryoId = @selectedSenaryoId;
    var satisTipi = 'Toplam';   // 'Toplam' | 'YeniSatis' | 'Yenileme'
    var fmtTL = function(v) {
        v = Number(v) || 0;
        if (v === 0) return '—';
        return '₺' + (v / 1_000_000).toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + 'M';
    };

    // Tab switch
    window.switchTab = function(tab) {
        document.querySelectorAll('.param-tab').forEach(function(t){ t.classList.remove('active'); });
        document.getElementById('tab-' + tab).classList.add('active');
        document.querySelectorAll('.param-panel').forEach(function(p){ p.classList.add('hidden'); });
        document.getElementById('panel-' + tab).classList.remove('hidden');
    };

    // Sub-tab: Toplam / YeniSatis / Yenileme — input'ları yeniden doldur
    window.switchSatisTipi = function(tip) {
        if (dirty && !confirm('Kaydedilmemiş değişiklikleriniz var. Devam edilsin mi (değişiklikler kaybolur)?')) {
            return;
        }
        satisTipi = tip;
        document.body.setAttribute('data-satis-tipi', tip);
        ['Toplam', 'YeniSatis', 'Yenileme'].forEach(function(t){
            var el = document.getElementById('st-' + t);
            if (el) el.classList.toggle('active', t === tip);
        });
        // Input value'ları aktif satış tipinden yeniden yaz
        var attr = tip === 'YeniSatis' ? 'ys' : (tip === 'Yenileme' ? 'yen' : 'toplam');
        document.querySelectorAll('.hedef-cell').forEach(function(c){
            var raw = parseFloat(c.dataset[attr] || '0') || 0;
            c.value = raw > 0 ? (raw / 1_000_000).toLocaleString('tr-TR', { maximumFractionDigits: 2 }).replace(',', ',') : '';
            c.classList.remove('dirty');
        });
        dirty = false;
        document.getElementById('btnSave').disabled = true;
        recompute();
    };

    // Senaryo değişimi → URL ile reload
    window.onSenaryoChange = function(sid) {
        if (dirty && !confirm('Kaydedilmemiş değişiklikleriniz var. Senaryo değiştirilsin mi?')) {
            document.getElementById('senaryoSelect').value = senaryoId;
            return;
        }
        var url = new URL(location.href);
        url.searchParams.set('senaryoId', sid);
        location.href = url.toString();
    };

    function parseM(s) {
        if (!s) return 0;
        // tr-TR: 42,2 → 42.2
        var n = parseFloat(String(s).replace(/\./g, '').replace(',', '.'));
        return isNaN(n) ? 0 : n;
    }

    window.onCellInput = function(el) {
        dirty = true;
        el.classList.add('dirty');
        document.getElementById('btnSave').disabled = false;
        recompute();
    };

    function recompute() {
        var rowSums = {}, colSums = {}, grand = 0;
        document.querySelectorAll('.hedef-cell').forEach(function(c){
            var u = c.dataset.urun, a = c.dataset.ay;
            var v = parseM(c.value) * 1_000_000;
            rowSums[u] = (rowSums[u] || 0) + v;
            colSums[a] = (colSums[a] || 0) + v;
            grand += v;
        });
        document.querySelectorAll('[data-row-toplam]').forEach(function(td){
            td.textContent = fmtTL(rowSums[td.dataset.rowToplam] || 0);
        });
        document.querySelectorAll('[data-col-toplam]').forEach(function(td){
            td.textContent = fmtTL(colSums[td.dataset.colToplam] || 0);
        });
        document.getElementById('grandToplam').textContent = fmtTL(grand);
        document.getElementById('yillikToplam').textContent = fmtTL(grand);
    }

    window.saveMatris = async function() {
        var btn = document.getElementById('btnSave');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Kaydediliyor…';

        var hucreler = [];
        document.querySelectorAll('.hedef-cell').forEach(function(c){
            var v = parseM(c.value) * 1_000_000;
            hucreler.push({
                urunId: parseInt(c.dataset.urun, 10),
                ay: parseInt(c.dataset.ay, 10),
                hedefTutar: v
            });
        });

        try {
            var res = await fetch('/Parametre/SaveHedeflerUrunAy', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ senaryoId: senaryoId, satisTipi: satisTipi, hucreler: hucreler })
            });
            var d = await res.json();
            if (d.success) {
                btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Kaydedildi';
                btn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                btn.classList.add('bg-green-600');
                dirty = false;
                // data-toplam/ys/yen attribute'larını taze değerle senkronla — sub-tab geçişinde tutarlı kalsın
                document.querySelectorAll('.hedef-cell').forEach(function(c){
                    var v = parseM(c.value) * 1_000_000;
                    if (satisTipi === 'YeniSatis') {
                        var oldYen = parseFloat(c.dataset.yen || '0') || 0;
                        c.dataset.ys = v;
                        c.dataset.toplam = v + oldYen;
                    } else if (satisTipi === 'Yenileme') {
                        var oldYS = parseFloat(c.dataset.ys || '0') || 0;
                        c.dataset.yen = v;
                        c.dataset.toplam = v + oldYS;
                    } else {
                        // Toplam — backend YS/Yen orantı korur, ama biz tam tutarı bilmiyoruz; sayfayı tazelememek için kabul edilebilir tutarsızlık (sonraki sub-tab geçişinde fark görünür ama save tetiklendi)
                        c.dataset.toplam = v;
                        // YS/Yen için orantı koruma yansıması
                        var oldT = parseFloat(c.dataset.toplam || '0') || 0;
                        // Bu noktada veriyi tam doğru aktarmadık; bir sonraki yükleme bu durumu temizler
                    }
                });
                document.querySelectorAll('.hedef-cell.dirty').forEach(function(c){ c.classList.remove('dirty'); });
                setTimeout(function(){
                    btn.innerHTML = '<i class="bi bi-check2-circle"></i> Kaydet';
                    btn.classList.remove('bg-green-600');
                    btn.classList.add('bg-blue-600', 'hover:bg-blue-700');
                    btn.disabled = true;
                }, 2000);
            } else {
                throw d.error || 'Hata';
            }
        } catch(e) {
            btn.innerHTML = '<i class="bi bi-x-circle"></i> Hata!';
            btn.classList.remove('bg-blue-600');
            btn.classList.add('bg-red-600');
            console.error('Kaydetme hatası:', e);
            setTimeout(function(){
                btn.innerHTML = '<i class="bi bi-check2-circle"></i> Kaydet';
                btn.classList.remove('bg-red-600');
                btn.classList.add('bg-blue-600', 'hover:bg-blue-700');
                btn.disabled = false;
            }, 2000);
        }
    };

    window.addEventListener('beforeunload', function(e) {
        if (dirty) { e.preventDefault(); e.returnValue = ''; }
    });

    // ═══ Tab 2: Ürün eşleştirme ═══
    var esState = { sayfa: 1, boyut: 50, q: '', anaUrunId: '', toplam: 0, loaded: false };
    var anaUrunlerJson = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(anaUrunler.Select(u => new { id = u.Id, ad = u.Ad })));
    var debounceTimer;

    // Tab değişince ilk açılışta yükle
    var origSwitch = window.switchTab;
    window.switchTab = function(tab) {
        origSwitch(tab);
        if (tab === 'urunler' && !esState.loaded) {
            esState.loaded = true;
            loadEslestirmeListesi();
        }
    };

    window.filterByAnaUrun = function(anaUrunId, ad) {
        document.getElementById('esAnaUrunFilter').value = anaUrunId;
        document.querySelectorAll('.anaurun-rozet').forEach(function(b){
            b.classList.toggle('active', String(b.dataset.anaurunRozet) === String(anaUrunId));
        });
        esState.anaUrunId = anaUrunId;
        esState.sayfa = 1;
        loadEslestirmeListesi();
    };

    document.getElementById('esSearch').addEventListener('input', function(e){
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function(){
            esState.q = e.target.value.trim();
            esState.sayfa = 1;
            loadEslestirmeListesi();
        }, 250);
    });

    document.getElementById('esAnaUrunFilter').addEventListener('change', function(e){
        esState.anaUrunId = e.target.value;
        esState.sayfa = 1;
        document.querySelectorAll('.anaurun-rozet').forEach(function(b){
            b.classList.toggle('active', String(b.dataset.anaurunRozet) === String(e.target.value));
        });
        loadEslestirmeListesi();
    });

    window.esPage = function(delta) {
        var maxSayfa = Math.max(1, Math.ceil(esState.toplam / esState.boyut));
        var hedef = esState.sayfa + delta;
        if (hedef < 1 || hedef > maxSayfa) return;
        esState.sayfa = hedef;
        loadEslestirmeListesi();
    };

    function escapeHtml(s) {
        if (s == null) return '';
        return String(s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function buildAnaUrunOptions(seciliId) {
        return anaUrunlerJson.map(function(u){
            return '<option value="' + u.id + '"' + (u.id === seciliId ? ' selected' : '') + '>' + escapeHtml(u.ad) + '</option>';
        }).join('');
    }

    async function loadEslestirmeListesi() {
        var tbody = document.getElementById('esTbody');
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-slate-300 py-12">Yükleniyor…</td></tr>';

        var params = new URLSearchParams({ sayfa: esState.sayfa, boyut: esState.boyut });
        if (esState.q) params.set('q', esState.q);
        if (esState.anaUrunId) params.set('anaUrunId', esState.anaUrunId);

        try {
            var res = await fetch('/Parametre/EslestirmeListesi?' + params.toString());
            var d = await res.json();
            if (!d.ok) throw new Error('Liste alınamadı');

            esState.toplam = d.toplam;
            document.getElementById('esCount').textContent = d.toplam.toLocaleString('tr-TR') + ' kayıt';

            if (d.items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-slate-300 py-12">Sonuç bulunamadı</td></tr>';
            } else {
                tbody.innerHTML = d.items.map(function(it){
                    return '<tr>'
                        + '<td class="px-4 py-2 font-mono text-[11px] text-slate-700 whitespace-nowrap">' + escapeHtml(it.stokKodu) + '</td>'
                        + '<td class="px-4 py-2 text-slate-600">' + escapeHtml(it.urunAdi || '—') + '</td>'
                        + '<td class="px-3 py-2 text-slate-500 text-[11px]">' + escapeHtml(it.mask || '—') + '</td>'
                        + '<td class="px-3 py-2 text-slate-500 text-[11px]">' + escapeHtml(it.lisansTipi || '—') + '</td>'
                        + '<td class="px-3 py-2">'
                        +   '<select class="es-select" data-id="' + it.id + '" data-old="' + it.anaUrunId + '" onchange="esUpdateRow(this)">'
                        +     buildAnaUrunOptions(it.anaUrunId)
                        +   '</select>'
                        + '</td>'
                        + '</tr>';
                }).join('');
            }

            // Pagination buton durumları
            var maxSayfa = Math.max(1, Math.ceil(d.toplam / d.boyut));
            document.getElementById('esPrev').disabled = (d.sayfa <= 1);
            document.getElementById('esNext').disabled = (d.sayfa >= maxSayfa);
            document.getElementById('esPageInfo').textContent = 'Sayfa ' + d.sayfa + ' / ' + maxSayfa;
        } catch(e) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-red-500 py-12">Hata: ' + escapeHtml(e.message || e) + '</td></tr>';
        }
    }

    window.esUpdateRow = async function(sel) {
        var id = parseInt(sel.dataset.id, 10);
        var newId = parseInt(sel.value, 10);
        var oldId = parseInt(sel.dataset.old, 10);
        if (newId === oldId) return;

        sel.classList.add('saving');
        try {
            var res = await fetch('/Parametre/UpdateEslestirme', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id, anaUrunId: newId })
            });
            var d = await res.json();
            if (!d.success) throw new Error(d.error || 'Hata');

            sel.dataset.old = newId;
            sel.classList.remove('saving');
            sel.classList.add('saved');
            setTimeout(function(){ sel.classList.remove('saved'); }, 1500);

            // Header rozet sayılarını güncelle (azalan → eski; artan → yeni)
            updateRozetSayi(oldId, -1);
            updateRozetSayi(newId, +1);
        } catch(e) {
            sel.classList.remove('saving');
            sel.classList.add('error');
            sel.value = oldId;  // rollback
            console.error('Eşleştirme update hatası:', e);
            setTimeout(function(){ sel.classList.remove('error'); }, 2500);
        }
    };

    function updateRozetSayi(anaUrunId, delta) {
        var rozet = document.querySelector('[data-anaurun-rozet="' + anaUrunId + '"]');
        if (!rozet) return;
        var p = rozet.querySelector('p:nth-child(2)');
        if (!p) return;
        var cur = parseInt(p.textContent.replace(/\D/g, ''), 10) || 0;
        var yeni = Math.max(0, cur + delta);
        p.textContent = yeni.toLocaleString('tr-TR');
    }
})();
</script>
}
