@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Identity
@using SOS.Models.Kullanici
@using SOS.Services
@inject IConfiguration Configuration
@inject UserManager<AppUser> UserManager
@inject IUrlEncryptionService UrlEncryption
@inject IAdminAuthService AdminAuth

@{
    var appUser = await UserManager.GetUserAsync(User);
    var userInitial = User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?";
    var userName = User.Identity?.Name ?? "Kullanıcı";
    // SOS-özel admin yetkisi: TBLSOS_ADMIN_KULLANICI tablosundan
    var isSosAdmin = await AdminAuth.IsAdminAsync(User.Identity?.Name);
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Font preload: FOUT/titreme önleme -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/tailwind.css">
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        /* ═══ APPLE-QUALITY RENDERING ═══ */
        *, *::before, *::after {
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
            -webkit-tap-highlight-color: transparent;
        }

        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', system-ui, sans-serif;
            font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';
            font-optical-sizing: auto;
        }

        html {
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
            font-synthesis: none;
        }

        /* GPU-only animasyonlar: sadece transform + opacity = 60fps */
        .gpu { will-change: transform, opacity; transform: translateZ(0); backface-visibility: hidden; }

        /* Apple easing curves */
        :root {
            --ease-apple: cubic-bezier(0.25, 0.1, 0.25, 1.0);
            --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-in-out: cubic-bezier(0.45, 0, 0.55, 1);
            --duration-fast: 0.2s;
            --duration-normal: 0.35s;
            --duration-slow: 0.5s;
        }

        /* Smooth number transitions */
        .num-transition {
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.02em;
            transition: none; /* JS handles animation */
        }

        /* macOS scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.08); border-radius: 99px; transition: background 0.2s; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(0,0,0,0.18); }
        * { scrollbar-width: thin; scrollbar-color: rgba(0,0,0,0.08) transparent; }

        /* Content fade-in on load (no flash) */
        .fade-ready { opacity: 0; transform: translateY(8px); }
        .fade-in {
            opacity: 1 !important;
            transform: translateY(0) !important;
            transition: opacity var(--duration-slow) var(--ease-out-expo),
                        transform var(--duration-slow) var(--ease-out-expo);
        }

        /* Smooth value update flash */
        .value-updated {
            animation: value-pulse 0.6s var(--ease-apple);
        }
        @@keyframes value-pulse {
            0% { opacity: 0.4; transform: scale(0.96); }
            50% { opacity: 1; transform: scale(1.02); }
            100% { opacity: 1; transform: scale(1); }
        }

        /* Deep Blue Navy Sidebar — sabit genişlik (hover'da açılmaz) */
        .nav-sidebar {
            width: 68px;
            background: linear-gradient(180deg, #1e3a8a 0%, #1e40af 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            flex-shrink: 0;
            overflow: visible;  /* tooltip dışarı taşabilsin */
            border-right: 1px solid rgba(255,255,255,0.06);
            box-shadow: 4px 0 24px rgba(30,58,138,0.15);
        }

        /* Logo area */
        .sidebar-logo {
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            margin-bottom: 8px;
        }
        .sidebar-logo-text { display: none; }  /* sabit kapalı sidebar'da gizle */

        .nav-link {
            position: relative;  /* tooltip için */
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 12px 22px;
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            transition: background-color 0.2s ease, color 0.2s ease, border-left-color 0.2s ease;
            border-left: 3px solid transparent;
        }
        .nav-link:hover {
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.9);
            border-left-color: rgba(96,165,250,0.4);
        }
        .nav-link.active {
            background: rgba(255,255,255,0.1);
            color: white;
            border-left-color: #60a5fa;
        }
        .nav-link i {
            font-size: 20px;
            min-width: 24px;
            text-align: center;
            flex-shrink: 0;
        }
        /* Sabit kapalı sidebar — yazı etiketleri gizli */
        .nav-link-text { display: none; }

        /* Hover tooltip (title attribute'undan) */
        .nav-link::after {
            content: attr(title);
            position: absolute;
            left: calc(100% + 10px);
            top: 50%;
            transform: translateY(-50%) translateX(-4px);
            background: #0f172a;
            color: #fff;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.18s ease, transform 0.18s ease;
            box-shadow: 0 4px 14px rgba(0,0,0,0.25);
            z-index: 100;
        }
        .nav-link::before {
            content: '';
            position: absolute;
            left: calc(100% + 4px);
            top: 50%;
            transform: translateY(-50%) translateX(-4px);
            border: 6px solid transparent;
            border-right-color: #0f172a;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.18s ease, transform 0.18s ease;
            z-index: 100;
        }
        .nav-link:hover::after,
        .nav-link:hover::before {
            opacity: 1;
            transform: translateY(-50%) translateX(0);
        }

        /* Mobile sidebar — sadece gerçek mobil cihazlar (telefon).
           Eski 767px breakpoint Chrome side panel açıkken laptop'ta da tetikleniyordu
           → sidebar translateX(-100%) ile ekran dışına gidiyordu, hamburger butonu da olmadığı
           için erişilemez oluyordu. 480px ile sadece gerçek telefonlarda mobil mode açılır;
           dar laptop/iPad ekranlarında 68px sabit sidebar görünür kalır. */
        @@media (max-width: 480px) {
            .nav-sidebar {
                position: fixed;
                left: 0; top: 0; bottom: 0;
                z-index: 45;
                width: 220px !important;
                transform: translateX(-100%);
                transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            }
            .nav-sidebar.mobile-open {
                transform: translateX(0);
            }
            .nav-sidebar .sidebar-logo-text,
            .nav-sidebar .nav-link-text,
            .nav-sidebar .sidebar-user-text { display: inline; opacity: 1; transform: none; }
            .nav-sidebar .sidebar-logo, .nav-sidebar .nav-link { justify-content: flex-start; }
            .nav-link::after, .nav-link::before { display: none; }  /* mobilde tooltip kapalı */
            main { padding: 16px !important; padding-top: 56px !important; }
        }

        /* Bottom section */
        .sidebar-footer {
            margin-top: auto;
            width: 100%;
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 12px 0;
        }
        .sidebar-avatar-wrap {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: rgba(96,165,250,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #93c5fd;
            font-size: 13px;
            font-weight: 700;
            flex-shrink: 0;
        }
        .sidebar-user-text { display: none; }  /* sabit kapalı sidebar */
    </style>
</head>
