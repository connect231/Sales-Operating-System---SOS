            }
            .su-tarih-row i { color: #d97706; font-size: 13px; }
            .su-tarih-row b { color: #78350f; font-weight: 800; letter-spacing: -.01em; }

            /* GÖVDE — metric kartlar */
            .su-body { padding: 24px 28px 4px; }
            .su-metric-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-bottom: 16px;
            }
            .su-metric {
                position: relative;
                padding: 18px 18px 16px;
                border-radius: 18px;
                background: linear-gradient(180deg, #fff 0%, #fafbff 100%);
                border: 1px solid #eef2f6;
                box-shadow: 0 1px 2px rgba(15,23,42,.04), inset 0 0 0 1px rgba(255,255,255,.6);
                overflow: hidden;
            }
            .su-metric::after {
                /* sol kenar accent */
                content: ''; position: absolute;
                left: 0; top: 14px; bottom: 14px;
                width: 3px; border-radius: 2px;
            }
            .su-metric.amber::after {
                background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
                box-shadow: 0 0 16px rgba(245,158,11,.5);
            }
            .su-metric.indigo::after {
                background: linear-gradient(180deg, #6366f1 0%, #4338ca 100%);
                box-shadow: 0 0 16px rgba(99,102,241,.5);
            }
