                transition: all .15s ease;
            }
            .su-kapat-btn:hover { background: #f1f5f9; color: #0f172a; }
        </style>
        <div id="satisciUyariBackdrop">
            <div id="satisciUyariCard" role="dialog" aria-labelledby="suHello" aria-modal="true">
                <div class="su-hero">
                    <button id="suClose" type="button" class="su-close-btn" aria-label="Kapat">
                        <i class="bi bi-x-lg" style="font-size:13px;"></i>
                    </button>
                    <div class="su-hero-row">
                        <div class="su-avatar" id="suAvatar">B</div>
                        <div style="flex:1; min-width:0;">
                            <div class="su-kicker">Hatırlatma</div>
                            <div id="suHello" class="su-title">Merhaba</div>
                        </div>
                    </div>
                    <div class="su-tarih-row">
                        <i class="bi bi-calendar2-x"></i>
                        <span>Tahmini kapanışı geçmiş açık fırsatlar · <b id="suTarih">bugün</b> itibarıyla</span>
                    </div>
                </div>
                <div class="su-body">
                    <div class="su-metric-grid">
                        <div class="su-metric amber">
                            <span class="su-metric-icon"><i class="bi bi-folder2-open"></i></span>
                            <div class="su-metric-num" id="suStaleAdet">—</div>
                            <div class="su-metric-lbl">Açık fırsat</div>
                        </div>
                        <div class="su-metric indigo">
                            <span class="su-metric-icon"><i class="bi bi-file-earmark-check"></i></span>
                            <div class="su-metric-num" id="suTeklifAdet">—</div>
                            <div class="su-metric-lbl">Teklife dönmüş</div>
                        </div>
                    </div>
                    <p class="su-aciklama">
                        Bu fırsatların tahmini kapanış tarihleri geçmiş — forecast doğruluğu için <b>lütfen tarihleri güncelleyiniz</b>.
                    </p>
                </div>
                <div class="su-footer">
                    <span class="su-footer-tag">İşini doğru yap! LBD</span>
                    <div style="display:flex; align-items:center; gap:6px;">
                        <button id="suKapat" type="button" class="su-kapat-btn">Sonra</button>
                        <a id="suDetaylar" href="#" class="su-detay-btn">
                            <span>Detayları aç</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <script>
        // ═══ SATIŞÇI GİRİŞ UYARISI — her login'de zorunlu tetiklenir + gün-içi tekrar açılışta atlanır ═══
        // Dedupe flag: localStorage 'satisci_uyari_son_tarih' = YYYY-MM-DD (bugün ise atla).
        // Login POST → TempData["FreshLogin"]="1" → aşağıdaki blok flag'i SİLER → popup kesin gelir.
        // Yan etki: doğal logout zaten Clear-Site-Data ile storage temizliyor; bu blok session-timeout
        // sonrası otomatik login akışı için kritik (logout tetiklenmediği için storage temiz değil).
        @if (TempData["FreshLogin"] != null)
        {
            <text>try { localStorage.removeItem('satisci_uyari_son_tarih'); } catch(e) {}</text>
        }
        (function(){
            'use strict';
            var TODAY = (new Date()).toISOString().slice(0, 10);
            var KEY = 'satisci_uyari_son_tarih';
            try { if (localStorage.getItem(KEY) === TODAY) return; } catch(e) {}
            fetch('/Account/SatisciGirisUyarisi', { credentials: 'same-origin' })
                .then(function(r){ return r.ok ? r.json() : null; })
                .then(function(d){
                    if (!d || !d.eligible) return;
                    var bd = document.getElementById('satisciUyariBackdrop');
                    var card = document.getElementById('satisciUyariCard');
                    if (!bd || !card) return;
                    var fmt = new Intl.NumberFormat('tr-TR');
                    var bugunLabel = '';
                    try {
                        var dt = d.bugun ? new Date(d.bugun + 'T00:00:00') : new Date();
                        if (dt && !isNaN(dt)) {
                            bugunLabel = dt.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' });
                        }
                    } catch(e) {}
                    var ad = d.personName || '';
                    var initials = (function(){
                        var p = ad.trim().split(/\s+/);
                        if (p.length >= 2) return (p[0][0] + p[p.length-1][0]).toUpperCase();
                        return ad.substring(0, 2).toUpperCase();
                    })();
                    document.getElementById('suAvatar').textContent = initials || '·';
                    document.getElementById('suHello').textContent = 'Merhaba, ' + ad;
                    document.getElementById('suTarih').textContent = bugunLabel || 'bugün';
                    document.getElementById('suStaleAdet').textContent = fmt.format(d.staleAdet || 0);
                    document.getElementById('suTeklifAdet').textContent = fmt.format(d.teklifVarAdet || 0);
                    // Detaylar → Rapor: kullanıcı 'Satış Temsilcisi' kriteriyle, kapanış tarihine göre filtreli
                    // (bugün dahil geçmiş kapanışlar için raporOnceTarihi = yarın). Cache-buster ile fresh.
                    var url = '/Rapor/Index?ownerName=' + encodeURIComponent(ad) +
                              '&kapanisOnceTarihi=' + encodeURIComponent(d.raporOnceTarihi || d.bugun || '') +
                              '&_t=' + Date.now();
                    document.getElementById('suDetaylar').setAttribute('href', url);
                    bd.classList.add('open');
                    requestAnimationFrame(function(){
                        card.classList.add('show');
                    });
                    function kapat(){
                        try { localStorage.setItem(KEY, TODAY); } catch(e){}
                        card.classList.remove('show');
                        setTimeout(function(){
                            bd.classList.remove('open');
                        }, 280);
                    }
                    document.getElementById('suKapat').addEventListener('click', kapat);
                    document.getElementById('suClose').addEventListener('click', kapat);
                    document.getElementById('suDetaylar').addEventListener('click', function(){
                        try { localStorage.setItem(KEY, TODAY); } catch(e){}
                    });
                    bd.addEventListener('click', function(e){ if (e.target === bd) kapat(); });
                    document.addEventListener('keydown', function escClose(e){
                        if (e.key === 'Escape') { kapat(); document.removeEventListener('keydown', escClose); }
                    });
                })
                .catch(function(e){ console.warn('[uyarı] alınamadı', e); });
        })();
        </script>
        <script>
        // ═══ LOGIN AKTİVİTE HEARTBEAT — 60sn'de bir SonAktiviteZamani güncelle ═══
        (function(){
            'use strict';
            var HEARTBEAT_MS = 60000;
            function ping() {
                if (document.hidden) return;
                fetch('/Account/Heartbeat', {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' },
                    credentials: 'same-origin',
                    keepalive: true
                }).catch(function(){ /* sessiz başarısızlık */ });
            }
            // İlk yüklemede 5sn sonra kayıt başlasın (oturum yeni)
            setTimeout(ping, 5000);
            setInterval(ping, HEARTBEAT_MS);
            document.addEventListener('visibilitychange', function(){
                if (!document.hidden) ping();
            });
        })();
        </script>
    }
</body>
</html>
