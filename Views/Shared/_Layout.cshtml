                display: inline-flex; align-items: center; gap: 6px;
            }
            .su-footer-tag::before {
                content: ''; width: 14px; height: 1px;
                background: #cbd5e1;
            }
            .su-detay-btn {
                display: inline-flex; align-items: center; gap: 8px;
                padding: 11px 20px;
