    @await RenderSectionAsync("Scripts", required: false)

    <script>
    // ═══ APPLE-QUALITY GLOBAL UTILITIES ═══
    (function(){
        'use strict';

        // Sayfa yüklendikten sonra fade-in (FOUC önleme)
        document.addEventListener('DOMContentLoaded', function(){
            requestAnimationFrame(function(){
                document.querySelectorAll('.fade-ready').forEach(function(el, i){
                    setTimeout(function(){ el.classList.add('fade-in'); }, i * 60);
                });
            });
        });

        // ═══ COUNT-UP: requestAnimationFrame ile 60fps sayı animasyonu ═══
        // Eski değerden yeni değere geçiş (0'dan değil)
        window.countUp = function(el, target, duration, prefix, suffix) {
            if (!el) return;
            prefix = prefix || '';
            suffix = suffix || '';
            duration = duration || 1200;
            var formatter = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });

            // Mevcut değeri oku — 0'dan başlama, eski değerden devam et
            var raw = (el.textContent || '').replace(/[^0-9]/g, '');
            var from = parseInt(raw, 10) || 0;
            if (from === target) return;

            var startTime = null;
            function ease(t) { return t === 1 ? 1 : 1 - Math.pow(2, -10 * t); }

            // Önceki animasyonu iptal et
            if (el._countUpId) cancelAnimationFrame(el._countUpId);

            function step(timestamp) {
                if (!startTime) startTime = timestamp;
                var progress = Math.min((timestamp - startTime) / duration, 1);
                var current = Math.floor(from + ease(progress) * (target - from));
                el.textContent = prefix + formatter.format(current) + suffix;
                if (progress < 1) {
                    el._countUpId = requestAnimationFrame(step);
                } else {
                    el.textContent = prefix + formatter.format(target) + suffix;
                    el._countUpId = null;
                }
            }

            el._countUpId = requestAnimationFrame(step);
        };

        // ═══ SMOOTH VALUE UPDATE: Eski değerden yeniye geçiş ═══
        window.smoothUpdate = function(el, newText, animate) {
            if (!el || el.textContent === newText) return;
            if (animate !== false) {
                el.style.transition = 'none';
                el.style.opacity = '0.4';
                el.style.transform = 'translateY(2px)';
                requestAnimationFrame(function(){
                    el.style.transition = 'opacity 0.2s cubic-bezier(0.16,1,0.3,1), transform 0.2s cubic-bezier(0.16,1,0.3,1)';
                    el.textContent = newText;
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                });
            } else {
                el.textContent = newText;
            }
        };

        // ═══ SMOOTH HTML UPDATE: innerHTML için GPU fade geçiş (setTimeout yok) ═══
        window.smoothHtmlUpdate = function(el, newHtml) {
            if (!el) return;
            el.style.transition = 'none';
            el.style.opacity = '0';
            el.style.transform = 'translateY(2px)';
            requestAnimationFrame(function(){
                el.innerHTML = newHtml;
                el.style.transition = 'opacity 0.3s cubic-bezier(0.16,1,0.3,1), transform 0.3s cubic-bezier(0.16,1,0.3,1)';
                el.style.opacity = '1';
                el.style.transform = 'translateY(0)';
            });
        };

    })();
    </script>

    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <!-- ═══ SATIŞÇI GİRİŞ UYARI POPUP — Premium ═══ -->
        <style>
            #satisciUyariBackdrop {
                position: fixed; inset: 0;
                background: rgba(2, 6, 23, .62);
                backdrop-filter: blur(12px) saturate(140%);
                -webkit-backdrop-filter: blur(12px) saturate(140%);
                z-index: 2147483646 !important;
                display: none; align-items: center; justify-content: center;
                padding: 16px;
            }
            #satisciUyariBackdrop.open { display: flex !important; }
            #satisciUyariCard {
                position: relative;
                z-index: 2147483647;
                width: 480px;
                max-width: 100%;
                background: #fff;
                border-radius: 28px;
                overflow: hidden;
                box-shadow:
                    0 50px 100px -20px rgba(2,6,23,.55),
                    0 30px 60px -30px rgba(2,6,23,.45),
                    inset 0 0 0 1px rgba(255,255,255,.04);
                transform: translateY(14px) scale(.94);
                opacity: 0;
                transition: transform .42s cubic-bezier(.16,1,.3,1), opacity .28s ease-out;
            }
            #satisciUyariCard.show { transform: translateY(0) scale(1); opacity: 1; }

            /* HERO — açık ton, sıcak beyaz wash */
            .su-hero {
                position: relative;
                padding: 26px 28px 24px;
                background:
                    radial-gradient(120% 120% at 100% 0%, rgba(245,158,11,.14) 0%, transparent 55%),
                    radial-gradient(140% 140% at 0% 100%, rgba(99,102,241,.10) 0%, transparent 60%),
                    linear-gradient(135deg, #fffaf0 0%, #fff 55%, #fdf4ff 100%);
                color: #0f172a;
                overflow: hidden;
                border-bottom: 1px solid #f1f5f9;
            }
            .su-hero::before {
                /* parlak ince üst çizgi (amber) */
                content: ''; position: absolute; left: 0; right: 0; top: 0;
                height: 2px;
                background: linear-gradient(90deg, transparent 0%, #f59e0b 35%, #ef4444 50%, #f59e0b 65%, transparent 100%);
                background-size: 200% 100%;
                animation: suGlow 4s ease-in-out infinite;
            }
            @@keyframes suGlow {
                0%, 100% { background-position: 0% 50%; }
                50% { background-position: 100% 50%; }
            }
            .su-hero-row { display: flex; align-items: center; gap: 16px; }
            .su-avatar {
                width: 52px; height: 52px;
                border-radius: 16px;
                display: inline-flex; align-items: center; justify-content: center;
                font-size: 18px; font-weight: 800; letter-spacing: -.02em;
                color: #1e1b14;
                background: linear-gradient(135deg, #fde68a 0%, #fbbf24 60%, #f59e0b 100%);
                box-shadow:
                    0 0 0 4px rgba(245,158,11,.18),
                    0 10px 24px -8px rgba(245,158,11,.55),
                    inset 0 1px 0 rgba(255,255,255,.45);
                flex-shrink: 0;
            }
