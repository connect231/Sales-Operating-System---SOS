            .su-detay-btn:hover {
                background-position: 100% 50%;
                transform: translateY(-1.5px);
                box-shadow:
                    0 14px 28px -6px rgba(15,23,42,.55),
                    0 0 0 1px rgba(245,158,11,.25) inset,
                    0 1px 0 rgba(255,255,255,.15) inset;
                color: #fff;
            }
            .su-detay-btn i { font-size: 12px; transition: transform .25s ease; }
            .su-detay-btn:hover i { transform: translateX(3px); }
            .su-kapat-btn {
                padding: 10px 14px;
                border-radius: 999px;
                font-size: 12.5px; font-weight: 600;
                color: #64748b;
