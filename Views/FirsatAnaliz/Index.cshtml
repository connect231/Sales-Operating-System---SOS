@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function() {
    'use strict';

    // ── Formatters ──
    const fmtCurrency = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', maximumFractionDigits: 0 });
    const fmtNumber = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
    const fmtPct = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

    function abbrev(v) {
        if (v >= 1e9) return '\u20BA' + (v / 1e9).toFixed(1) + 'B';
        if (v >= 1e6) return '\u20BA' + (v / 1e6).toFixed(1) + 'M';
        if (v >= 1e3) return '\u20BA' + (v / 1e3).toFixed(0) + 'K';
        return '\u20BA' + fmtNumber.format(v);
    }

    function axisAbbrev(v) {
        if (v >= 1e6) return (v / 1e6).toFixed(1) + 'M';
        if (v >= 1e3) return (v / 1e3).toFixed(0) + 'K';
        return v;
    }

    // ── State ──
    let activeFilter = '@Model.AktifFiltre';
    let chartInstances = {};
    let debounceTimer = null;
    let drillLoaded = {};
    let activeStatusDrill = null;

    // ── Filter params builder ──
    function getFilterParams() {
        const s = document.getElementById('rangeStart').value;
        const e = document.getElementById('rangeEnd').value;
        const p = document.getElementById('filterPerson').value;
        const pr = document.getElementById('filterProduct').value;
        let qs = 'filter=' + encodeURIComponent(activeFilter);
        if (s) qs += '&startDate=' + s;
        if (e) qs += '&endDate=' + e;
        if (p) qs += '&person=' + encodeURIComponent(p);
        if (pr) qs += '&product=' + encodeURIComponent(pr);
        return qs;
    }

    // ── Gradient helper ──
    function makeGradient(ctx, c1, c2, h) {
        const g = ctx.createLinearGradient(0, 0, 0, h || 200);
        g.addColorStop(0, c1);
        g.addColorStop(1, c2);
        return g;
    }

    // ── Chart.js common tooltip config ──
    const tooltipConfig = {
        backgroundColor: 'rgba(30,27,75,0.92)',
        titleFont: { family: 'Inter', size: 12, weight: '600' },
        bodyFont: { family: 'Inter', size: 11 },
        padding: 12,
        cornerRadius: 10,
        displayColors: false
    };

    // ── CountUp animation ──
    function countUp(el, target, duration, prefix, suffix) {
        prefix = prefix || '';
        suffix = suffix || '';
        duration = duration || 500;
        const start = performance.now();
        const from = 0;
        function step(now) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3); // ease-out-cubic
            const current = from + (target - from) * eased;
            el.textContent = prefix + fmtNumber.format(Math.round(current)) + suffix;
            if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
    }

    // ── Sparkline drawer ──
    function drawSparkline(canvasId, data, color) {
        const cv = document.getElementById(canvasId);
        if (!cv || !data || !data.length) return;
        const ctx = cv.getContext('2d');
        const dpr = window.devicePixelRatio || 1;
        const rect = cv.getBoundingClientRect();
        cv.width = rect.width * dpr;
        cv.height = 30 * dpr;
        ctx.scale(dpr, dpr);
        const w = rect.width, h = 30;
        const max = Math.max(...data), min = Math.min(...data);
        const range = max - min || 1;
        const step = w / (data.length - 1 || 1);

        ctx.beginPath();
        data.forEach((v, i) => {
            const x = i * step;
            const y = h - ((v - min) / range) * (h - 4) - 2;
            if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        });
        ctx.strokeStyle = color || '#4f46e5';
        ctx.lineWidth = 1.5;
        ctx.lineJoin = 'round';
        ctx.stroke();

        // Fill
        ctx.lineTo((data.length - 1) * step, h);
        ctx.lineTo(0, h);
        ctx.closePath();
        const grd = ctx.createLinearGradient(0, 0, 0, h);
        grd.addColorStop(0, (color || '#4f46e5') + '30');
        grd.addColorStop(1, (color || '#4f46e5') + '05');
        ctx.fillStyle = grd;
        ctx.fill();
    }

    // ── Fetch with retry ──
    async function fetchJson(url, retries) {
        retries = retries || 2;
        for (let i = 0; i <= retries; i++) {
            try {
                const r = await fetch('/FirsatAnaliz/' + url);
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return await r.json();
            } catch (err) {
                if (i === retries) throw err;
            }
        }
    }

    // ── LOAD KPI SUMMARY ──
    async function loadKpiSummary() {
        try {
            const d = await fetchJson('GetKpiSummary?' + getFilterParams());

            // Pipeline Toplam
            const pipeEl = document.querySelector('[data-kpi="pipelineToplam"]');
            pipeEl.textContent = '';
            countUp(pipeEl, d.pipelineToplam, 500, '\u20BA');

            // Aktif Firsat
            const aktifEl = document.querySelector('[data-kpi="aktifFirsat"]');
            aktifEl.textContent = '';
            countUp(aktifEl, d.aktifFirsatAdet, 500);

            // Aktif trend
            const aktifTrend = document.querySelector('[data-kpi-trend="aktifTrend"]');
            if (d.aktifFirsatTrend !== 0) {
                const up = d.aktifFirsatTrend > 0;
                aktifTrend.className = 'text-[12px] font-semibold ' + (up ? 'trend-up' : 'trend-down');
                aktifTrend.innerHTML = '<i class="bi ' + (up ? 'bi-arrow-up-right' : 'bi-arrow-down-right') + '"></i> %' + fmtPct.format(Math.abs(d.aktifFirsatTrend));
            } else {
                aktifTrend.innerHTML = '<span class="text-slate-300">-</span>';
            }

            // Pipeline trend (reuse aktifFirsatTrend for now)
            const pipeTrend = document.querySelector('[data-kpi-trend="pipelineTrend"]');
            pipeTrend.className = 'text-[12px] font-semibold ' + (d.aktifFirsatTrend > 0 ? 'trend-up' : d.aktifFirsatTrend < 0 ? 'trend-down' : '');
            if (d.aktifFirsatTrend !== 0) {
                pipeTrend.innerHTML = '<i class="bi ' + (d.aktifFirsatTrend > 0 ? 'bi-arrow-up-right' : 'bi-arrow-down-right') + '"></i> %' + fmtPct.format(Math.abs(d.aktifFirsatTrend));
            } else {
                pipeTrend.innerHTML = '<span class="text-slate-300">-</span>';
            }

            // Teklif
            const teklifEl = document.querySelector('[data-kpi="acikTeklif"]');
            teklifEl.textContent = '';
            countUp(teklifEl, d.acikTeklifToplam, 500, '\u20BA');
            const teklifTrend = document.querySelector('[data-kpi-trend="teklifTrend"]');
            teklifTrend.innerHTML = '<span class="text-slate-400">' + d.acikTeklifAdet + ' adet</span>';

            // Siparis
            const siparisEl = document.querySelector('[data-kpi="acikSiparis"]');
            siparisEl.textContent = '';
            countUp(siparisEl, d.acikSiparisToplam, 500, '\u20BA');
            const siparisTrend = document.querySelector('[data-kpi-trend="siparisTrend"]');
            siparisTrend.innerHTML = '<span class="text-slate-400">' + d.acikSiparisAdet + ' adet</span>';

            // Win rate
            const winEl = document.querySelector('[data-kpi="kazanmaOrani"]');
            winEl.textContent = '%' + fmtPct.format(d.kazanmaOraniCount);

            const circumference = 2 * Math.PI * 30; // 188.5
            const offset = circumference - (d.kazanmaOraniCount / 100) * circumference;
            document.getElementById('winrate-circle').style.strokeDashoffset = offset;

            // Sub labels
            document.querySelector('[data-kpi-sub="pipelineSub"]').textContent = d.aktifFirsatAdet + ' adet \u00B7 ' + abbrev(d.ortAnlasma) + ' ort';
            document.querySelector('[data-kpi-sub="aktifSub"]').textContent = abbrev(d.pipelineToplam) + ' toplam deger';
            document.querySelector('[data-kpi-sub="teklifSub"]').textContent = d.acikTeklifAdet + ' adet beklemede';
            document.querySelector('[data-kpi-sub="siparisSub"]').textContent = d.acikSiparisAdet + ' acik \u00B7 ' + d.kapaliSiparisAdet + ' kapali';
            document.querySelector('[data-kpi-sub="winrateSub"]').textContent = 'Gelir bazli %' + fmtPct.format(d.kazanmaOraniRevenue);

        } catch (err) {
            console.error('KPI load error:', err);
        }
    }

    // ── LOAD FUNNEL ──
    async function loadFunnel() {
        try {
            const stages = await fetchJson('GetFunnelData?' + getFilterParams());
            const body = document.getElementById('funnelBody');
            if (!stages || !stages.length) {
                body.innerHTML = '<p class="text-[11px] text-slate-400 text-center py-6 w-full">Huni verisi bulunamadi.</p>';
                return;
            }

            const colors = ['#6366f1', '#4f46e5', '#4338ca', '#3730a3', '#312e81'];
            let html = '';
            const maxCount = Math.max(...stages.map(s => s.count)) || 1;

            stages.forEach((s, i) => {
                const widthPct = 15 + (s.count / maxCount) * 85;
                html += '<div class="funnel-segment" style="background:' + (s.color || colors[i] || colors[4]) + '; flex: 0 0 ' + widthPct + '%; min-width: 100px;">';
                html += '<span class="text-[10px] font-semibold opacity-80">' + s.name + '</span>';
                html += '<span class="text-[15px] font-bold">' + fmtNumber.format(s.count) + '</span>';
                html += '<span class="text-[10px] opacity-80">' + abbrev(s.value) + '</span>';
                html += '</div>';

                if (i < stages.length - 1) {
                    const rate = s.conversionRate;
                    let badgeClass = 'bg-red-100 text-red-700';
                    if (rate >= 70) badgeClass = 'bg-emerald-100 text-emerald-700';
                    else if (rate >= 40) badgeClass = 'bg-amber-100 text-amber-700';
                    html += '<div class="funnel-conversion">';
                    html += '<span class="funnel-conv-badge ' + badgeClass + '">%' + fmtPct.format(rate) + '</span>';
                    html += '</div>';
                }
            });

            body.innerHTML = html;
        } catch (err) {
            console.error('Funnel load error:', err);
            document.getElementById('funnelBody').innerHTML = '<p class="text-[11px] text-red-400 text-center py-4 w-full">Hata olustu.</p>';
        }
    }

    // ── LOAD STATUS BREAKDOWNS ──
    async function loadStatusBreakdown(type) {
        try {
            const d = await fetchJson('GetStatusBreakdown?type=' + type + '&' + getFilterParams());
            if (!d) return;

            // Total
            const totalEl = document.querySelector('[data-status-total="' + type + '"]');
            totalEl.textContent = abbrev(d.grandTotal) + ' \u00B7 ' + d.grandCount + ' adet';

            // Doughnut
            const cvId = 'doughnut-' + type;
            if (chartInstances[cvId]) { chartInstances[cvId].destroy(); delete chartInstances[cvId]; }
            const cv = document.getElementById(cvId);
            if (cv && d.items && d.items.length) {
                chartInstances[cvId] = new Chart(cv, {
                    type: 'doughnut',
                    data: {
                        labels: d.items.map(x => x.statusName),
                        datasets: [{
                            data: d.items.map(x => x.count),
                            backgroundColor: d.items.map(x => x.color),
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        cutout: '68%',
                        animation: { animateRotate: true, duration: 800, easing: 'easeOutQuart' },
                        plugins: {
                            legend: { display: false },
                            tooltip: Object.assign({}, tooltipConfig, {
                                callbacks: {
                                    label: function(ctx) { return ctx.label + ': ' + ctx.raw + ' adet'; }
                                }
                            })
                        }
                    }
                });
            }

            // Status list
            const listEl = document.getElementById('status-list-' + type);
            if (d.items && d.items.length) {
                let h = '';
                const maxCount = Math.max(...d.items.map(x => x.count)) || 1;
                d.items.forEach(item => {
                    const pct = d.grandCount > 0 ? ((item.count / d.grandCount) * 100) : 0;
                    h += '<div class="flex items-center gap-3">';
                    h += '<div class="status-dot" style="background:' + item.color + ';"></div>';
                    h += '<span class="text-[12px] text-slate-600 flex-1">' + item.statusName + '</span>';
                    h += '<span class="text-[12px] font-semibold text-[#1e293b]">' + item.count + '</span>';
                    h += '<span class="text-[11px] text-slate-400 w-10 text-right">%' + fmtPct.format(pct) + '</span>';
                    h += '</div>';
                });
                listEl.innerHTML = h;
            } else {
                listEl.innerHTML = '<p class="text-[11px] text-slate-400 text-center py-2">Veri bulunamadi</p>';
            }
        } catch (err) {
            console.error('Status ' + type + ' load error:', err);
        }
    }

    // ── STATUS DRILL TOGGLE ──
    function toggleStatusDrill(type) {
        const panel = document.getElementById('drill-status-' + type);
        const arrow = document.getElementById('arrow-status-' + type);
        if (activeStatusDrill === type) {
            panel.classList.remove('open');
            arrow.classList.remove('rotated');
            activeStatusDrill = null;
        } else {
            if (activeStatusDrill) {
                document.getElementById('drill-status-' + activeStatusDrill).classList.remove('open');
                document.getElementById('arrow-status-' + activeStatusDrill).classList.remove('rotated');
            }
            panel.classList.add('open');
            arrow.classList.add('rotated');
            activeStatusDrill = type;
            if (!drillLoaded['status-' + type]) loadStatusDrillData(type);
        }
    }
    window.toggleStatusDrill = toggleStatusDrill;

    async function loadStatusDrillData(type) {
        const el = document.getElementById('drill-data-' + type);
        el.innerHTML = '<div class="shimmer h-5 w-full mb-2"></div><div class="shimmer h-5 w-4/5"></div>';
        try {
            const d = await fetchJson('GetDetail?type=' + type + '&page=1&pageSize=20&' + getFilterParams());
            if (!d || !d.rows || !d.rows.length) {
                el.innerHTML = '<p class="text-[11px] text-slate-400 text-center py-4">Veri bulunamadi.</p>';
                drillLoaded['status-' + type] = true;
                return;
            }
            let h = '<div class="overflow-x-auto"><table class="w-full text-[11px] fa-table"><thead><tr class="border-b border-slate-100">';
            h += '<th class="text-left py-2 px-2 font-semibold text-slate-400">No</th>';
            h += '<th class="text-left py-2 px-2 font-semibold text-slate-400">Musteri</th>';
            h += '<th class="text-left py-2 px-2 font-semibold text-slate-400">Urun</th>';
            h += '<th class="text-center py-2 px-2 font-semibold text-slate-400">Durum</th>';
            h += '<th class="text-right py-2 px-2 font-semibold text-slate-400">Tutar</th>';
            h += '<th class="text-center py-2 px-2 font-semibold text-slate-400">Tarih</th>';
            h += '<th class="text-left py-2 px-2 font-semibold text-slate-400">Sahip</th>';
            h += '</tr></thead><tbody>';
            d.rows.forEach(function(r) {
                h += '<tr class="border-t border-slate-50 hover:bg-indigo-50/20 transition-colors">';
                h += '<td class="py-1.5 px-2 text-[#1e293b] font-medium">' + (r.teklifNo || '-') + '</td>';
                h += '<td class="py-1.5 px-2 text-slate-500 max-w-[140px] truncate">' + (r.musteriAdi || '-') + '</td>';
                h += '<td class="py-1.5 px-2 text-slate-500 max-w-[120px] truncate">' + (r.urunAdi || '-') + '</td>';
                h += '<td class="py-1.5 px-2 text-center"><span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-medium" style="background:' + (r.durumRenk || '#e2e8f0') + '20; color:' + (r.durumRenk || '#475569') + ';">' + (r.durum || '-') + '</span></td>';
                h += '<td class="py-1.5 px-2 text-right font-semibold text-[#1e293b]">' + fmtCurrency.format(r.tutar || 0) + '</td>';
                h += '<td class="py-1.5 px-2 text-center text-slate-500">' + (r.tarih ? new Date(r.tarih).toLocaleDateString('tr-TR') : '-') + '</td>';
                h += '<td class="py-1.5 px-2 text-slate-500">' + (r.sahip || '-') + '</td>';
                h += '</tr>';
            });
            h += '</tbody></table></div>';
            if (d.totalCount > 20) {
                h += '<p class="text-[10px] text-slate-400 text-center mt-3">' + d.totalCount + ' kayittan ilk 20 gosteriliyor</p>';
            }
            el.innerHTML = h;
            drillLoaded['status-' + type] = true;
        } catch (err) {
            el.innerHTML = '<p class="text-[11px] text-red-400 text-center py-4">Hata olustu.</p>';
        }
    }

    // ── LOAD CHARTS ──
    async function loadCharts() {
        await Promise.all([
            loadTrendChart(),
            loadProductChart(),
            loadCustomerChart()
        ]);
    }

    async function loadTrendChart() {
        const cv = document.getElementById('chart-trend');
        if (!cv) return;
        try {
            const d = await fetchJson('GetChartData?chartType=trend&' + getFilterParams());
            if (!d || !d.labels || !d.labels.length) {
                document.getElementById('chart-trend-wrap').innerHTML = '<p class="text-[11px] text-slate-400 text-center py-8">Veri bulunamadi.</p>';
                return;
            }
            if (chartInstances['trend']) chartInstances['trend'].destroy();
            const ctx = cv.getContext('2d');

            const datasets = d.datasets.map(function(ds, i) {
                const colors = ['#6366f1', '#10b981', '#f59e0b'];
                const bgFrom = [
                    'rgba(99,102,241,0.25)', 'rgba(16,185,129,0.15)', 'rgba(245,158,11,0.15)'
                ];
                const bgTo = [
                    'rgba(99,102,241,0.02)', 'rgba(16,185,129,0.02)', 'rgba(245,158,11,0.02)'
                ];
                return {
                    label: ds.label,
                    data: ds.data,
                    borderColor: ds.borderColor || colors[i],
                    backgroundColor: makeGradient(ctx, bgFrom[i] || bgFrom[0], bgTo[i] || bgTo[0]),
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    pointBackgroundColor: ds.borderColor || colors[i],
                    tension: 0.4,
                    fill: true
                };
            });

            chartInstances['trend'] = new Chart(cv, {
                type: 'line',
                data: { labels: d.labels, datasets: datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 800, easing: 'easeOutQuart' },
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'bottom', labels: { font: { family: 'Inter', size: 10 }, padding: 12, usePointStyle: true, pointStyleWidth: 8 } },
                        tooltip: Object.assign({}, tooltipConfig, {
                            mode: 'index',
                            callbacks: { label: function(ctx) { return ctx.dataset.label + ': ' + fmtCurrency.format(ctx.raw); } }
                        })
                    },
                    scales: {
                        x: { grid: { display: false }, border: { display: false }, ticks: { font: { family: 'Inter', size: 9 }, color: '#94a3b8', maxRotation: 0 } },
                        y: { grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false, borderDash: [3,3] }, border: { display: false }, ticks: { font: { family: 'Inter', size: 9 }, color: '#94a3b8', callback: axisAbbrev } }
                    }
                }
            });
        } catch (err) {
            console.error('Trend chart error:', err);
        }
    }

    async function loadProductChart() {
        const cv = document.getElementById('chart-product');
        if (!cv) return;
        try {
            const d = await fetchJson('GetChartData?chartType=product&' + getFilterParams());
            if (!d || !d.labels || !d.labels.length) {
                document.getElementById('chart-product-wrap').innerHTML = '<p class="text-[11px] text-slate-400 text-center py-8">Veri bulunamadi.</p>';
                return;
            }
            if (chartInstances['product']) chartInstances['product'].destroy();

            const barColors = ['#4f46e5', '#6366f1', '#818cf8', '#a5b4fc', '#c7d2fe', '#ddd6fe'];
            chartInstances['product'] = new Chart(cv, {
                type: 'bar',
                data: {
                    labels: d.labels,
                    datasets: [{
                        data: d.datasets[0].data,
                        backgroundColor: d.labels.map(function(_, i) { return barColors[i] || barColors[5]; }),
                        borderRadius: 6,
                        borderSkipped: false,
                        barThickness: 18
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 800, easing: 'easeOutQuart' },
                    plugins: {
                        legend: { display: false },
                        tooltip: Object.assign({}, tooltipConfig, {
                            callbacks: { label: function(ctx) { return fmtCurrency.format(ctx.raw); } }
                        })
                    },
                    scales: {
                        x: { grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false, borderDash: [3,3] }, border: { display: false }, ticks: { font: { family: 'Inter', size: 9 }, color: '#94a3b8', callback: axisAbbrev } },
                        y: { grid: { display: false }, border: { display: false }, ticks: { font: { family: 'Inter', size: 10 }, color: '#475569' } }
                    }
                }
            });
        } catch (err) {
            console.error('Product chart error:', err);
        }
    }

    async function loadCustomerChart() {
        const cv = document.getElementById('chart-customer');
        if (!cv) return;
        try {
            const d = await fetchJson('GetChartData?chartType=customer&' + getFilterParams());
            if (!d || !d.labels || !d.labels.length) {
                document.getElementById('chart-customer-wrap').innerHTML = '<p class="text-[11px] text-slate-400 text-center py-8">Veri bulunamadi.</p>';
                return;
            }
            if (chartInstances['customer']) chartInstances['customer'].destroy();

            const palette = ['#4f46e5','#6366f1','#818cf8','#a5b4fc','#c7d2fe','#10b981','#34d399','#6ee7b7','#f59e0b','#fbbf24'];
            chartInstances['customer'] = new Chart(cv, {
                type: 'doughnut',
                data: {
                    labels: d.labels,
                    datasets: [{
                        data: d.datasets[0].data,
                        backgroundColor: d.labels.map(function(_, i) { return palette[i] || palette[9]; }),
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '55%',
                    animation: { animateRotate: true, duration: 800, easing: 'easeOutQuart' },
                    plugins: {
                        legend: { position: 'right', labels: { font: { family: 'Inter', size: 9 }, padding: 6, usePointStyle: true, pointStyleWidth: 6 } },
                        tooltip: Object.assign({}, tooltipConfig, {
                            callbacks: { label: function(ctx) { return ctx.label + ': ' + fmtCurrency.format(ctx.raw); } }
                        })
                    }
                }
            });
        } catch (err) {
            console.error('Customer chart error:', err);
        }
    }

    // ── LOAD LEADERBOARD ──
    async function loadLeaderboard() {
        try {
            const rows = await fetchJson('GetLeaderboard?' + getFilterParams());
            const body = document.getElementById('leaderboardBody');
            if (!rows || !rows.length) {
                body.innerHTML = '<tr><td colspan="7" class="text-[11px] text-slate-400 text-center py-6">Veri bulunamadi.</td></tr>';
                return;
            }

            const maxPipeline = Math.max(...rows.map(function(r) { return r.pipelineValue; })) || 1;
            const medals = ['\uD83E\uDD47', '\uD83E\uDD48', '\uD83E\uDD49']; // gold, silver, bronze

            let h = '';
            rows.forEach(function(r) {
                const medal = r.rank <= 3 ? medals[r.rank - 1] : r.rank;
                const barW = (r.pipelineValue / maxPipeline * 100).toFixed(1);
                h += '<tr class="border-t border-slate-50 cursor-pointer leaderboard-row" data-person="' + encodeURIComponent(r.name) + '">';
                h += '<td class="py-2.5 px-2 text-center text-[13px]">' + medal + '</td>';
                h += '<td class="py-2.5 px-3"><div><span class="font-semibold text-[#1e293b]">' + r.name + '</span>';
                h += '<div class="lb-bar"><div class="lb-bar-fill" style="width:' + barW + '%;"></div></div>';
                h += '</div></td>';
                h += '<td class="py-2.5 px-3 text-right font-medium text-[#1e293b]">' + abbrev(r.pipelineValue) + '</td>';
                h += '<td class="py-2.5 px-3 text-right text-emerald-600 font-medium">' + r.wonDeals + '/' + r.totalDeals + '</td>';
                h += '<td class="py-2.5 px-3 text-center">';
                h += '<span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-semibold ';
                h += r.winRate >= 60 ? 'bg-emerald-100 text-emerald-700' : r.winRate >= 30 ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700';
                h += '">%' + fmtPct.format(r.winRate) + '</span></td>';
                h += '<td class="py-2.5 px-3 text-right text-slate-500">' + abbrev(r.avgDealSize) + '</td>';
                h += '<td class="py-2.5 px-3 text-right font-semibold text-[#1e293b]">' + abbrev(r.pipelineValue) + '</td>';
                h += '</tr>';
            });
            body.innerHTML = h;

            // Bind click events for slide-over
            body.querySelectorAll('.leaderboard-row').forEach(function(row) {
                row.addEventListener('click', function() {
                    openSlideOver(decodeURIComponent(this.dataset.person));
                });
            });
        } catch (err) {
            console.error('Leaderboard error:', err);
        }
    }

    // ── LOAD RISK ALERTS ──
    async function loadRiskAlerts() {
        try {
            const alerts = await fetchJson('GetRiskAlerts');
            const body = document.getElementById('riskBody');
            if (!alerts || !alerts.length) {
                body.innerHTML = '<div class="flex flex-col items-center justify-center py-8"><i class="bi bi-check-circle text-emerald-400" style="font-size:24px;"></i><p class="text-[12px] text-slate-400 mt-2">Risk uyarisi yok</p></div>';
                return;
            }

            let h = '';
            alerts.forEach(function(a) {
                let cls = 'risk-info';
                if (a.severity === 'CRITICAL') cls = 'risk-critical';
                else if (a.severity === 'WARNING') cls = 'risk-warning';

                let iconClass = 'bi-info-circle text-blue-500';
                if (a.severity === 'CRITICAL') iconClass = 'bi-exclamation-octagon text-red-500';
                else if (a.severity === 'WARNING') iconClass = 'bi-exclamation-triangle text-amber-500';

                h += '<div class="risk-item ' + cls + '">';
                h += '<div class="flex items-start gap-3">';
                h += '<i class="bi ' + iconClass + ' mt-0.5" style="font-size:14px;"></i>';
                h += '<div class="flex-1 min-w-0">';
                h += '<div class="flex items-center justify-between">';
                h += '<span class="text-[12px] font-semibold text-[#1e293b]">' + a.title + '</span>';
                h += '<span class="text-[10px] font-bold text-slate-400">' + a.count + '</span>';
                h += '</div>';
                h += '<p class="text-[11px] text-slate-500 mt-0.5">' + a.message + '</p>';
                if (a.value > 0) {
                    h += '<p class="text-[11px] font-semibold text-slate-600 mt-1">' + fmtCurrency.format(a.value) + '</p>';
                }
                h += '</div></div></div>';
            });
            body.innerHTML = h;
        } catch (err) {
            console.error('Risk alerts error:', err);
        }
    }

    // ── LOAD SPARKLINES (via KPI endpoint, uses stub data array) ──
    async function loadSparklines() {
        try {
            const d = await fetchJson('GetChartData?chartType=trend&' + getFilterParams());
            if (d && d.datasets && d.datasets.length) {
                // Use first dataset for pipeline sparkline
                if (d.datasets[0]) drawSparkline('spark-pipeline', Array.from(d.datasets[0].data), '#4f46e5');
                if (d.datasets[1]) drawSparkline('spark-aktif', Array.from(d.datasets[1].data), '#10b981');
                // Generate simulated sparklines for teklif/siparis from available data
                if (d.datasets[0]) {
                    const data0 = Array.from(d.datasets[0].data);
                    drawSparkline('spark-teklif', data0.map(function(v) { return v * 0.6 + Math.random() * v * 0.1; }), '#6366f1');
                    drawSparkline('spark-siparis', data0.map(function(v) { return v * 0.4 + Math.random() * v * 0.1; }), '#818cf8');
                }
            }
        } catch (err) {
            // Sparklines are non-critical
        }
    }

    // ── SLIDE-OVER PANEL ──
    async function openSlideOver(personName) {
        document.getElementById('slideName').textContent = personName;
        document.getElementById('slideOverlay').classList.add('active');
        document.getElementById('slidePanel').classList.add('active');
        document.getElementById('slideContent').innerHTML = '<div class="shimmer h-6 w-full mb-3"></div><div class="shimmer h-6 w-4/5 mb-3"></div><div class="shimmer h-6 w-11/12"></div>';

        try {
            const d = await fetchJson('GetPersonScorecard?person=' + encodeURIComponent(personName) + '&' + getFilterParams());
            if (!d) {
                document.getElementById('slideContent').innerHTML = '<p class="text-[11px] text-slate-400 text-center py-8">Veri bulunamadi.</p>';
                return;
            }

            let h = '';

            // Summary KPIs
            h += '<div class="grid grid-cols-2 gap-3 mb-5">';
            if (d.pipelineValue !== undefined) {
                h += '<div class="bg-indigo-50 rounded-xl p-3"><p class="text-[9px] text-indigo-500 font-semibold uppercase">Pipeline</p><p class="text-base font-bold text-[#1e293b] mt-1">' + abbrev(d.pipelineValue || 0) + '</p></div>';
            }
            if (d.wonDeals !== undefined) {
                h += '<div class="bg-emerald-50 rounded-xl p-3"><p class="text-[9px] text-emerald-500 font-semibold uppercase">Kazanilan</p><p class="text-base font-bold text-[#1e293b] mt-1">' + (d.wonDeals || 0) + ' firsat</p></div>';
            }
            if (d.winRate !== undefined) {
                h += '<div class="bg-amber-50 rounded-xl p-3"><p class="text-[9px] text-amber-500 font-semibold uppercase">Donusum</p><p class="text-base font-bold text-[#1e293b] mt-1">%' + fmtPct.format(d.winRate || 0) + '</p></div>';
            }
            if (d.avgDealSize !== undefined) {
                h += '<div class="bg-sky-50 rounded-xl p-3"><p class="text-[9px] text-sky-500 font-semibold uppercase">Ort. Anlasma</p><p class="text-base font-bold text-[#1e293b] mt-1">' + abbrev(d.avgDealSize || 0) + '</p></div>';
            }
            h += '</div>';

            // Monthly trend mini chart
            h += '<div class="mb-5"><p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wide mb-2">Aylik Trend</p>';
            h += '<canvas id="slide-trend" height="100"></canvas></div>';

            // Open deals
            if (d.openDeals && d.openDeals.length) {
                h += '<p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wide mb-2">Acik Firsatlar</p>';
                h += '<div class="space-y-2 mb-4">';
                d.openDeals.forEach(function(deal) {
                    h += '<div class="bg-slate-50 rounded-lg p-3 flex items-center justify-between">';
                    h += '<div><p class="text-[12px] font-medium text-[#1e293b]">' + (deal.musteriAdi || '-') + '</p>';
                    h += '<p class="text-[10px] text-slate-400">' + (deal.urunAdi || '-') + '</p></div>';
                    h += '<div class="text-right"><p class="text-[12px] font-bold text-[#1e293b]">' + fmtCurrency.format(deal.tutar || 0) + '</p>';
                    h += '<span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-medium" style="background:' + (deal.durumRenk || '#e2e8f0') + '20; color:' + (deal.durumRenk || '#475569') + ';">' + (deal.durum || '-') + '</span>';
                    h += '</div></div>';
                });
                h += '</div>';
            }

            // Customer distribution
            if (d.customerDistribution && d.customerDistribution.length) {
                h += '<p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wide mb-2">Musteri Dagilimi</p>';
                h += '<div class="space-y-1.5 mb-4">';
                d.customerDistribution.forEach(function(c) {
                    h += '<div class="flex items-center gap-2">';
                    h += '<span class="text-[11px] text-slate-600 flex-1 truncate">' + c.name + '</span>';
                    h += '<span class="text-[11px] font-semibold text-[#1e293b]">' + fmtCurrency.format(c.value || 0) + '</span>';
                    h += '</div>';
                });
                h += '</div>';
            }

            // Product performance
            if (d.productPerformance && d.productPerformance.length) {
                h += '<p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wide mb-2">Urun Performansi</p>';
                h += '<div class="space-y-1.5">';
                d.productPerformance.forEach(function(p) {
                    h += '<div class="flex items-center gap-2">';
                    h += '<span class="text-[11px] text-slate-600 flex-1 truncate">' + p.name + '</span>';
                    h += '<span class="text-[11px] font-semibold text-[#1e293b]">' + fmtCurrency.format(p.value || 0) + '</span>';
                    h += '</div>';
                });
                h += '</div>';
            }

            document.getElementById('slideContent').innerHTML = h;

            // Render mini trend chart
            if (d.monthlyTrend && d.monthlyTrend.labels && d.monthlyTrend.labels.length) {
                const tcv = document.getElementById('slide-trend');
                if (tcv) {
                    new Chart(tcv, {
                        type: 'bar',
                        data: {
                            labels: d.monthlyTrend.labels,
                            datasets: [{
                                data: d.monthlyTrend.data,
                                backgroundColor: '#6366f1',
                                borderRadius: 4,
                                barThickness: 14
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            animation: { duration: 600 },
                            plugins: { legend: { display: false }, tooltip: Object.assign({}, tooltipConfig, { callbacks: { label: function(ctx) { return fmtCurrency.format(ctx.raw); } } }) },
                            scales: {
                                x: { grid: { display: false }, border: { display: false }, ticks: { font: { family: 'Inter', size: 9 }, color: '#94a3b8' } },
                                y: { display: false }
                            }
                        }
                    });
                }
            }

        } catch (err) {
            document.getElementById('slideContent').innerHTML = '<p class="text-[11px] text-red-400 text-center py-8">Veri yuklenirken hata olustu.</p>';
        }
    }

    function closeSlideOver() {
        document.getElementById('slideOverlay').classList.remove('active');
        document.getElementById('slidePanel').classList.remove('active');
    }
    window.closeSlideOver = closeSlideOver;

    // ESC to close slide-over
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeSlideOver();
    });

    // ── FILTER MANAGEMENT ──
    function refreshAll() {
        // Reset drill state
        drillLoaded = {};
        activeStatusDrill = null;
        document.querySelectorAll('.drill-panel').forEach(function(p) { p.classList.remove('open'); });
        document.querySelectorAll('.chevron-btn').forEach(function(c) { c.classList.remove('rotated'); });

        // Destroy all charts
        Object.keys(chartInstances).forEach(function(k) {
            if (chartInstances[k]) { chartInstances[k].destroy(); delete chartInstances[k]; }
        });

        // Fire all loads in parallel
        Promise.all([
            loadKpiSummary(),
            loadFunnel(),
            loadStatusBreakdown('firsatlar'),
            loadStatusBreakdown('teklifler'),
            loadStatusBreakdown('siparisler'),
            loadCharts(),
            loadLeaderboard(),
            loadRiskAlerts(),
            loadSparklines()
        ]);
    }

    function debouncedRefresh() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(refreshAll, 300);
    }

    // Filter pill clicks
    document.getElementById('filterPills').addEventListener('click', function(e) {
        const pill = e.target.closest('.filter-pill');
        if (!pill) return;
        document.querySelectorAll('.filter-pill').forEach(function(p) { p.classList.remove('active'); });
        pill.classList.add('active');
        activeFilter = pill.dataset.filter;
        debouncedRefresh();
    });

    // Date range change
    document.getElementById('rangeStart').addEventListener('change', function() {
        activeFilter = 'range';
        document.querySelectorAll('.filter-pill').forEach(function(p) { p.classList.remove('active'); });
        debouncedRefresh();
    });
    document.getElementById('rangeEnd').addEventListener('change', function() {
        activeFilter = 'range';
        document.querySelectorAll('.filter-pill').forEach(function(p) { p.classList.remove('active'); });
        debouncedRefresh();
    });

    // Person/Product change
    document.getElementById('filterPerson').addEventListener('change', debouncedRefresh);
    document.getElementById('filterProduct').addEventListener('change', debouncedRefresh);

    // ── INIT ──
    document.addEventListener('DOMContentLoaded', function() {
        refreshAll();
    });

})();
</script>
}
