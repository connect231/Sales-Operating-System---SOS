    var monthlyChartInstance = null;
    function renderMonthlyChart(data) {
        var canvas = document.getElementById('monthlyChartCanvas');
        if (!canvas || !data || !data.length) return;

        var ayMap = { '01':'Oca','02':'Şub','03':'Mar','04':'Nis','05':'May','06':'Haz','07':'Tem','08':'Ağu','09':'Eyl','10':'Eki','11':'Kas','12':'Ara' };
        var labels = data.map(function(d) { var p = d.ay.split('-'); return ayMap[p[1]] || p[1]; });
        var firsatData = data.map(function(d) { return d.firsatTutar; });
        var teklifData = data.map(function(d) { return d.teklifTutar; });
        var siparisData = data.map(function(d) { return d.acikSiparisTutar; });

        // ⚡ Mevcut instance varsa sadece data swap + update('none') — destroy yok
        if (monthlyChartInstance) {
            monthlyChartInstance.data.labels = labels;
            monthlyChartInstance.data.datasets[0].data = firsatData;
            monthlyChartInstance.data.datasets[1].data = teklifData;
            monthlyChartInstance.data.datasets[2].data = siparisData;
            monthlyChartInstance.update('none');
            return;
        }

        var ctx = canvas.getContext('2d');

        // Gradient fills
        var gFirsat = ctx.createLinearGradient(0, 0, 0, 280);
