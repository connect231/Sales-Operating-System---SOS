    async function loadFunnelBreakdown(funnel, reqId) {
        reqId = reqId || _reqSeq;
        try {
            var bpParams = getFilterParams() + '&funnel=' + funnel;
            if (activeCustomerFilter)     bpParams += '&customer='     + encodeURIComponent(activeCustomerFilter);
            if (activeProductFilter)      bpParams += '&product='      + encodeURIComponent(activeProductFilter);
            if (activeOwnerFilter)        bpParams += '&ownerName='    + encodeURIComponent(activeOwnerFilter);
            if (activeFirsatSahibiFilter) bpParams += '&firsatSahibi=' + encodeURIComponent(activeFirsatSahibiFilter);

            var data = consumeInitial('funnel', funnel) || await cachedFetch('/FirsatAnaliz/GetFunnelBreakdown?' + bpParams);

            // Race guard: kullanıcı bu arada tab değiştirdiyse bu response'u atla
            if (reqId !== _reqSeq) { console.warn('[FA] funnel stale, reqId=', reqId, 'curSeq=', _reqSeq); return; }

            console.log('[FA] funnel veri geldi', {
                owner: (data.ownerBreakdown||[]).length,
                firsat: (data.firsatSahipleriBreakdown||[]).length,
                product: (data.productBreakdown||[]).length,
                customer: (data.customerBreakdown||[]).length
            });

            // 4 breakdown — DocumentFragment ile tek DOM write
            renderBreakdownList('ownerList',           data.ownerBreakdown,           'owner');
            renderBreakdownList('firsatSahipleriList', data.firsatSahipleriBreakdown, 'firsat');
            renderBreakdownList('productBars',         data.productBreakdown,         'product');
            renderBreakdownList('customerBars',        data.customerBreakdown,        'customer');

            // Üst dropdown'ları breakdown verisinden besle (sadece adı al, tutarı değil)
            populateOppKisiDropdowns(data.ownerBreakdown, data.firsatSahipleriBreakdown);
        } catch(e) {
            if (e.name === 'AbortError') {
                // Abort sonrası UI stuck olmasın: fading'i kaldır, kullanıcı bir sonraki veriyi bekliyor olsun
                ['ownerList','firsatSahipleriList','productBars','customerBars'].forEach(function(id){
                    var el = document.getElementById(id);
                    if (el) el.classList.remove('fading');
                });
                // Arka planda bir kez daha dene — abort eden işlemin ardından cache sıcak olmalı
                setTimeout(function(){ if (reqId === _reqSeq) loadFunnelBreakdown(funnel, reqId); }, 50);
                return;
            }
            console.error('FunnelBreakdown error:', e);
            // Hata durumunda da fading'i kaldır, "Veri Bulunamadı" göster
            ['ownerList','firsatSahipleriList','productBars','customerBars'].forEach(function(id){
                var el = document.getElementById(id);
                if (el) { el.classList.remove('fading'); el.innerHTML = '<p class="text-[11px] text-[#94a3b8] text-center py-6">Veri Bulunamadı</p>'; }
            });
            return;
        }
    }

