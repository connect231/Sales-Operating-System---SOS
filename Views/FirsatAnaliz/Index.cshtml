@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    // Server-side preload — ilk açılışta AJAX beklemeden kartlar dolabilsin
    window.__faInitial = {
        kpiCore: @Html.Raw(ViewBag.InitialKpiCore != null ? System.Text.Json.JsonSerializer.Serialize(ViewBag.InitialKpiCore) : "null"),
        summary: @Html.Raw(ViewBag.InitialSummary != null ? System.Text.Json.JsonSerializer.Serialize(ViewBag.InitialSummary) : "null"),
        funnelF2: @Html.Raw(ViewBag.InitialFunnelF2 != null ? System.Text.Json.JsonSerializer.Serialize(ViewBag.InitialFunnelF2) : "null"),
        funnelF3: @Html.Raw(ViewBag.InitialFunnelF3 != null ? System.Text.Json.JsonSerializer.Serialize(ViewBag.InitialFunnelF3) : "null")
    };
</script>
<script>
(function() {
    'use strict';

    /* ══════════════════════════════════
       FORMATTERS
       ══════════════════════════════════ */
    var fmt = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
    var fmtPct = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

    function abbr(v) {
        if (v == null) return '-- \u20BA';
        if (v >= 1e9) return (v / 1e9).toFixed(1) + 'B \u20BA';
        if (v >= 1e6) return (v / 1e6).toFixed(1) + 'M \u20BA';
        if (v >= 1e3) return (v / 1e3).toFixed(0) + 'K \u20BA';
        return fmt.format(v) + ' \u20BA';
    }

    /* ── CountUp Animation ── */
    function countUp(el, target, duration, prefix, suffix) {
        if (!el) return;
        prefix = prefix || '';
        suffix = suffix || '';
        duration = duration || 800;
        // Race guard: her çağrıda seq artar; eski step kendi seq'i güncel değilse çıkar
        var mySeq = (parseInt(el.dataset.cuSeq || '0', 10) + 1);
        el.dataset.cuSeq = String(mySeq);
        // Güvenlik: final değeri hemen set et (rAF throttle/arka plan sekmesi durumunda bile görünür)
        // Animasyon rAF ile 0'dan progresif override eder, kesintiye uğrarsa final zaten burada.
        try { el.textContent = prefix + abbr(target); } catch(e) {}
        var start = performance.now();
        function step(now) {
            if (parseInt(el.dataset.cuSeq || '0', 10) !== mySeq) return; // üzerine yeni countUp geldi → iptal
            var elapsed = now - start;
            var progress = Math.min(elapsed / duration, 1);
            var eased = 1 - Math.pow(1 - progress, 3); // ease-out-cubic
            var current = target * eased;
            el.textContent = prefix + abbr(Math.round(current));
            if (progress < 1) requestAnimationFrame(step);
            else {
                el.textContent = prefix + abbr(target);
                el.classList.add('num-pulse');
                setTimeout(function() { el.classList.remove('num-pulse'); }, 400);
            }
        }
        requestAnimationFrame(step);
    }

    function countUpInt(el, target, duration) {
        duration = duration || 600;
        var start = performance.now();
        function step(now) {
            var elapsed = now - start;
            var progress = Math.min(elapsed / duration, 1);
            var eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = fmt.format(Math.round(target * eased));
            if (progress < 1) requestAnimationFrame(step);
            else {
                el.textContent = fmt.format(target);
                el.classList.add('num-pulse');
                setTimeout(function() { el.classList.remove('num-pulse'); }, 400);
            }
        }
        requestAnimationFrame(step);
    }

    /* ══════════════════════════════════
       STATE
       ══════════════════════════════════ */
    var activeFilter = (window.activeFilter = 'month');
    var activeFunnel = 0; // 0 = none selected, 1-5 = funnel index
    var oppSortVal = 'kapanis'; // default sıralama: en yeni kapanış tarihi → en eskisine
    var oppSortDir = 'desc';    // 'asc' | 'desc' — başlığa tıklayarak değişir
    var activeProductFilter = '';
    var activeCustomerFilter = '';
    var activeOwnerFilter = '';
    var activeFirsatSahibiFilter = '';

    /* ══════════════════════════════════
       PERFORMANS: request guard + client cache + abort
       ══════════════════════════════════ */
    var _reqSeq = 0;                      // her refreshAll'a artan id (race guard)
    // _currentAbort kaldırıldı: cascade abort cold-start'ta breakdown'ları silent kesiyordu.
    // Stale race guard sadece _reqSeq check ile sağlanıyor; eski refresh'in response'u render edilmez.
    var _clientCache = new Map();         // url → { data, ts }
    var CLIENT_TTL = 30000;               // 30 sn stale-while-revalidate
    var _tabDebounce = null;

    // Server-side preload consumer — ilk fetch yerine inline veriyi kullan (0ms)
    function consumeInitial(type, funnel) {
        var init = window.__faInitial;
        if (!init) return null;
        if (_forceNextFetch) return null;  // Kullanıcı "Yenile"ye bastı → initial cache'i atla
        if (activeFilter !== 'month') return null;  // Sadece default "Bu Ay" açılışı için
        if (activeProductFilter || activeCustomerFilter || activeOwnerFilter || activeFirsatSahibiFilter) return null;
        var d = null;
        if (type === 'kpiCore' && init.kpiCore)      { d = init.kpiCore;  init.kpiCore = null; }
        else if (type === 'summary' && init.summary) { d = init.summary;  init.summary = null; }
        else if (type === 'funnel' && funnel === 2 && init.funnelF2) { d = init.funnelF2; init.funnelF2 = null; }
        else if (type === 'funnel' && funnel === 3 && init.funnelF3) { d = init.funnelF3; init.funnelF3 = null; }
        return d;
    }

    function cachedFetch(url, opts) {
        var now = Date.now();
        var hit = _clientCache.get(url);
        if (hit && (now - hit.ts) < CLIENT_TTL) {
            // stale-while-revalidate: anında stale dön, arka planda tazele
            fetch(url, opts).then(function(r){ return r.json(); })
                .then(function(fresh){ _clientCache.set(url, { data: fresh, ts: Date.now() }); })
                .catch(function(){});
            return Promise.resolve(hit.data);
        }
        return fetch(url, opts).then(function(r){ return r.json(); })
            .then(function(fresh){ _clientCache.set(url, { data: fresh, ts: Date.now() }); return fresh; });
    }

    // Filtre değişiminde client cache'i geçersiz kılmaya gerek yok — URL'ye 'filter' dahil
    // Ama tahakkuk invalidate vs. için manuel çağrılabilir:
    window._clearClientCache = function() { _clientCache.clear(); };

    // Ürün/Müşteri/Temsilci/Sahip tıklama filtreleri — BERABER çalışır (AND semantic).
    // Aynı değere tekrar tıklamak o filtreyi kapatır (toggle). "Tümünü Temizle" chip ile sıfırlanır.
    function _clearAllBreakdownFilters() {
        activeProductFilter = '';
        activeCustomerFilter = '';
        activeOwnerFilter = '';
        activeFirsatSahibiFilter = '';
    }
    // Optimistic UI: click anında aktif halka göster, fetch dönmeden görsel feedback
    function highlightBreakdown(containerId, selectedText, activeCss) {
        var el = document.getElementById(containerId);
        if (!el) return;
        Array.prototype.forEach.call(el.children, function(row) {
            if (!row.classList || !row.className.indexOf) return;
            // cursor-pointer'lı satırlar (divider değil, footer değil)
            if (row.className.indexOf('cursor-pointer') === -1) return;
            // Önce tüm active css'leri temizle (ring + bg variantları)
            ['bg-indigo-50','ring-indigo-200','bg-amber-50','ring-amber-200','bg-emerald-50','ring-emerald-200','bg-violet-50','ring-violet-200','ring-1'].forEach(function(c){ row.classList.remove(c); });
            if (selectedText && row.textContent && row.textContent.indexOf(selectedText) !== -1) {
                activeCss.split(' ').forEach(function(c){ row.classList.add(c); });
            }
        });
    }
    // Aktif filtre chip'lerini render et (toolbar'da "Filtreyi Sıfırla" + tek tek kaldırma)
    function renderActiveFilterChips() {
        var host = document.getElementById('activeFilterChips');
        if (!host) return;
        var filters = [
            { type: 'urun',     label: 'Ürün',       value: activeProductFilter,      color: 'emerald', clear: function(){ activeProductFilter=''; highlightBreakdown('productBars', null, ''); } },
            { type: 'musteri',  label: 'Müşteri',    value: activeCustomerFilter,     color: 'violet',  clear: function(){ activeCustomerFilter=''; highlightBreakdown('customerBars', null, ''); } },
            { type: 'temsilci', label: 'Temsilci',   value: activeOwnerFilter,        color: 'indigo',  clear: function(){ activeOwnerFilter=''; highlightBreakdown('ownerList', null, ''); } },
            { type: 'sahip',    label: 'Fırsat Sah.',value: activeFirsatSahibiFilter, color: 'amber',   clear: function(){ activeFirsatSahibiFilter=''; highlightBreakdown('firsatSahipleriList', null, ''); } }
        ].filter(function(f){ return f.value; });
        host.innerHTML = '';
        if (!filters.length) return;
        var frag = document.createDocumentFragment();
        // Reset butonu
        var reset = document.createElement('button');
        reset.className = 'text-[11px] px-2.5 py-1 rounded-md bg-slate-800 text-white hover:bg-slate-900 flex items-center gap-1.5 font-medium';
        reset.innerHTML = '<i class="bi bi-x-circle" style="font-size:11px;"></i><span>Filtreyi Sıfırla</span>';
        reset.onclick = function() {
            _clearAllBreakdownFilters();
            ['productBars','customerBars','ownerList','firsatSahipleriList'].forEach(function(id){ highlightBreakdown(id, null, ''); });
            renderActiveFilterChips();
            refreshLowerSections();
        };
        frag.appendChild(reset);
        // Her filtre için chip
        filters.forEach(function(f) {
            var chip = document.createElement('span');
            var colorMap = {
                emerald: 'bg-emerald-50 text-emerald-700 border-emerald-200',
                violet:  'bg-violet-50 text-violet-700 border-violet-200',
                indigo:  'bg-indigo-50 text-indigo-700 border-indigo-200',
                amber:   'bg-amber-50 text-amber-700 border-amber-200'
            };
            chip.className = 'text-[11px] px-2.5 py-1 rounded-md border ' + (colorMap[f.color]||'bg-slate-50') + ' flex items-center gap-1.5 font-medium';
            var truncated = f.value.length > 30 ? f.value.substring(0, 28) + '…' : f.value;
            chip.innerHTML = '<span class="opacity-60">' + f.label + ':</span><span>' + truncated + '</span><i class="bi bi-x-lg hover:opacity-60 cursor-pointer" style="font-size:9px;"></i>';
            chip.querySelector('.bi-x-lg').onclick = function() { f.clear(); renderActiveFilterChips(); refreshLowerSections(); };
            frag.appendChild(chip);
        });
        host.appendChild(frag);
        if (typeof syncOppKisiDropdownSelection === 'function') syncOppKisiDropdownSelection();
    }
    window._filterByProduct = function(urun) {
        urun = decodeURIComponent(urun);
        var wasActive = activeProductFilter === urun;
        activeProductFilter = wasActive ? '' : urun;
        highlightBreakdown('productBars', wasActive ? null : urun, 'bg-emerald-50 ring-1 ring-emerald-200');
        renderActiveFilterChips();
        refreshLowerSections();
    };
    window._filterByCustomer = function(musteri) {
        musteri = decodeURIComponent(musteri);
        var wasActive = activeCustomerFilter === musteri;
        activeCustomerFilter = wasActive ? '' : musteri;
        highlightBreakdown('customerBars', wasActive ? null : musteri, 'bg-violet-50 ring-1 ring-violet-200');
        renderActiveFilterChips();
        refreshLowerSections();
    };
    window._filterByOwner = function(owner) {
        owner = decodeURIComponent(owner);
        var wasActive = activeOwnerFilter === owner;
        activeOwnerFilter = wasActive ? '' : owner;
        highlightBreakdown('ownerList', wasActive ? null : owner, 'bg-indigo-50 ring-1 ring-indigo-200');
        renderActiveFilterChips();
        if (typeof syncOppKisiDropdownSelection === 'function') syncOppKisiDropdownSelection();
        refreshLowerSections();
    };
    window._filterByFirsatSahibi = function(sahibi) {
        sahibi = decodeURIComponent(sahibi);
        var wasActive = activeFirsatSahibiFilter === sahibi;
        activeFirsatSahibiFilter = wasActive ? '' : sahibi;
        highlightBreakdown('firsatSahipleriList', wasActive ? null : sahibi, 'bg-amber-50 ring-1 ring-amber-200');
        renderActiveFilterChips();
        if (typeof syncOppKisiDropdownSelection === 'function') syncOppKisiDropdownSelection();
        refreshLowerSections();
    };

    // ── Üst kişi dropdown'ları (Fırsat Detayları tablosu) ──
    function populateOppKisiDropdowns(ownerRows, sahipRows) {
        var temSel = document.getElementById('oppTemsilciSelect');
        var sahSel = document.getElementById('oppFirsatSahibiSelect');
        if (!temSel || !sahSel) return;
        var trCol = new Intl.Collator('tr-TR', { sensitivity: 'base' });
        var esc = function(s){ return String(s||'').replace(/[<>&"]/g,function(c){return ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'})[c];}); };
        var nameOf = function(r){ return (r && (r.adSoyad || r.AdSoyad) || '').trim(); };
        var temNames = Array.from(new Set((ownerRows||[]).map(nameOf).filter(Boolean))).sort(trCol.compare);
        var sahNames = Array.from(new Set((sahipRows||[]).map(nameOf).filter(Boolean))).sort(trCol.compare);
        // Aktif değer listede yoksa eklenir (filtre sonrası breakdown daralabilir, kendi seçtiğin kaybolmasın)
        if (activeOwnerFilter        && !temNames.includes(activeOwnerFilter))        temNames.unshift(activeOwnerFilter);
        if (activeFirsatSahibiFilter && !sahNames.includes(activeFirsatSahibiFilter)) sahNames.unshift(activeFirsatSahibiFilter);
        temSel.innerHTML = '<option value="">Tüm Satış Temsilcileri</option>' +
            temNames.map(function(n){ return '<option value="'+esc(n)+'"'+(n===activeOwnerFilter?' selected':'')+'>'+esc(n)+'</option>'; }).join('');
        sahSel.innerHTML = '<option value="">Tüm Fırsat Sahipleri</option>' +
            sahNames.map(function(n){ return '<option value="'+esc(n)+'"'+(n===activeFirsatSahibiFilter?' selected':'')+'>'+esc(n)+'</option>'; }).join('');
        temSel.classList.toggle('has-value', !!activeOwnerFilter);
        sahSel.classList.toggle('has-value', !!activeFirsatSahibiFilter);
    }

    function syncOppKisiDropdownSelection() {
        var temSel = document.getElementById('oppTemsilciSelect');
        var sahSel = document.getElementById('oppFirsatSahibiSelect');
        if (temSel) { temSel.value = activeOwnerFilter || ''; temSel.classList.toggle('has-value', !!activeOwnerFilter); }
        if (sahSel) { sahSel.value = activeFirsatSahibiFilter || ''; sahSel.classList.toggle('has-value', !!activeFirsatSahibiFilter); }
    }

