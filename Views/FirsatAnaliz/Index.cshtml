    function renderSalesCycle(data) {
        var mainEl = document.getElementById('cycleMainNumber');
        if (!mainEl) return;
        var dealEl = document.getElementById('cycleDealCount');
        var setText = function(id, txt) { var el = document.getElementById(id); if (el) el.textContent = txt; };
        var setWidth = function(id, w) { var el = document.getElementById(id); if (el) el.style.width = w; };

        var reset = function() {
            mainEl.textContent = '—';
            if (dealEl) dealEl.textContent = 'Veri yok';
            setText('cycleFirsatTeklif', '—');
            setText('cycleTeklifSiparis', '—');
            setText('cycleSiparisFatura', '—');
            setWidth('segFirsatTeklif', '0%');
            setWidth('segTeklifSiparis', '0%');
            setWidth('segSiparisFatura', '0%');
        };

        if (!data || (data.toplamKapanan === 0 && data.firsatKapanisAdet === 0)) { reset(); return; }

        // Ana metrik: Fırsat oluşturma → Kapanış (Won)
        var firsatKapanis = data.ortFirsatKapanis || 0;
        mainEl.textContent = firsatKapanis > 0 ? firsatKapanis.toFixed(1) : (data.ortToplamDongu || 0).toFixed(1);
        mainEl.classList.remove('num-pulse');
        void mainEl.offsetWidth;
        mainEl.classList.add('num-pulse');
        var dealCount = data.firsatKapanisAdet || data.toplamKapanan || 0;
        if (dealEl) dealEl.textContent = dealCount + ' deal';

        // 3 aşama süreleri (eski layout — DOM yoksa atla)
        var ft = data.ortFirsatTeklif || 0;
        setText('cycleFirsatTeklif', ft > 0 ? ft.toFixed(0) + ' gün' : '—');
        setText('cycleTeklifSiparis', data.ortTeklifSiparis.toFixed(0) + ' gün');
        setText('cycleSiparisFatura', data.ortSiparisFatura.toFixed(0) + ' gün');

        // Segmented timeline bar: oransal genişlik (eski layout — DOM yoksa atla)
        var total = ft + data.ortTeklifSiparis + data.ortSiparisFatura;
        if (total > 0) {
            setTimeout(function() {
                var pct = function(v) { return Math.max(Math.round(v / total * 100), v > 0 ? 4 : 0) + '%'; };
                setWidth('segFirsatTeklif', pct(ft));
                setWidth('segTeklifSiparis', pct(data.ortTeklifSiparis));
                setWidth('segSiparisFatura', pct(data.ortSiparisFatura));
            }, 200);
        }
    }


    var hedefChartInstance = null;
    function renderHedefChart(hedef, opp) {
        var cv = document.getElementById('hedefChart');
        if (!cv || !cv.getContext) return;
        var stages = [
            { label: 'Fırsat', value: opp.exFirsatTutar || 0, color: '#8b5cf6' },
            { label: 'Teklif', value: opp.exTeklifTutar || 0, color: '#3b82f6' },
            { label: 'Sipariş', value: opp.exSiparisTutar || 0, color: '#06b6d4' },
            { label: 'Fatura', value: window._faturaData ? window._faturaData.kapaliSiparisTutar : 0, color: '#10b981' }
        ];
        // Y ekseni hedef çizgisini her zaman kapsasın
        var maxBar = Math.max.apply(null, stages.map(function(s) { return s.value; }));
        var yMax = Math.max(maxBar, hedef) * 1.12; // %12 padding

        // ⚡ Mevcut instance varsa data + y-max swap, destroy yok
        if (hedefChartInstance) {
            hedefChartInstance.data.labels = stages.map(function(s){ return s.label; });
            hedefChartInstance.data.datasets[0].data = stages.map(function(s){ return s.value; });
            hedefChartInstance.data.datasets[0].backgroundColor = stages.map(function(s){ return s.color; });
            hedefChartInstance.options.scales.y.suggestedMax = yMax;
            _hedefLineValue = hedef;
            hedefChartInstance.update('none');
            return;
        }

        var cfg = {
            type: 'bar',
            data: {
                labels: stages.map(function(s) { return s.label; }),
                datasets: [{
                    data: stages.map(function(s) { return s.value; }),
                    backgroundColor: stages.map(function(s) { return s.color; }),
                    borderRadius: 6, barThickness: 32
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                animation: { duration: 800, easing: 'easeOutQuart' },
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: function(c) { return abbr(c.raw); } } } },
                scales: {
                    x: { grid: { display: false }, border: { display: false }, ticks: { font: { family: 'DM Sans', size: 10 }, color: '#64748b' } },
                    y: { suggestedMax: yMax, grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false }, border: { display: false }, ticks: { font: { size: 9 }, color: '#94a3b8', callback: function(v) { return v >= 1e6 ? (v/1e6).toFixed(0)+'M' : v >= 1e3 ? (v/1e3).toFixed(0)+'K' : v; } } }
                }
            },
            plugins: [hedefLinePlugin]
        };
        _hedefLineValue = hedef;
        hedefChartInstance = new Chart(cv, cfg);
    }

    /* ══════════════════════════════════
       OPPORTUNITY DETAIL TABLE
       ══════════════════════════════════ */
    async function loadOppDetail(page) {
        var params = getFilterParams() + '&page=' + page + '&pageSize=30';
        if (oppSortVal) params += '&sort=' + encodeURIComponent(oppSortVal);
        if (oppSortDir) params += '&dir=' + encodeURIComponent(oppSortDir);
        if (activeCustomerFilter) params += '&customer=' + encodeURIComponent(activeCustomerFilter);
        if (activeProductFilter) params += '&product=' + encodeURIComponent(activeProductFilter);
        if (activeOwnerFilter) params += '&ownerName=' + encodeURIComponent(activeOwnerFilter);
        if (activeFirsatSahibiFilter) params += '&firsatSahibi=' + encodeURIComponent(activeFirsatSahibiFilter);
        // Aktif funnel → detay tablosu üst kartlarla aynı exclusive sete göre daralsın.
        // Kullanıcı kademe seçmediyse (activeFunnel=0) default funnel=2 (kalan açık fırsat havuzu) — üst karttaki
        // ownerBreakdown / productBreakdown ile birebir tutarlı; aksi halde detay Lost/Won dahil her şeyi
        // gösterip üst kartlardan farklı dip toplam çıkarıyordu (kart-detay sapma bug'ı).
        var detFunnel = activeFunnel > 0 ? activeFunnel : 2;
        params += '&funnel=' + detFunnel;

        // Aktif filtre badge
        var filterBadge = document.getElementById('activeFilterBadge');
        if (activeProductFilter) {
            filterBadge.innerHTML = '<span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-emerald-50 text-emerald-700 text-[10px] font-semibold">Ürün: '+activeProductFilter+' <button onclick="window._filterByProduct(\''+encodeURIComponent(activeProductFilter)+'\')" class="ml-1 text-emerald-400 hover:text-emerald-700">&times;</button></span>';
            filterBadge.classList.remove('hidden');
        } else if (activeCustomerFilter) {
            filterBadge.innerHTML = '<span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-violet-50 text-violet-700 text-[10px] font-semibold">Müşteri: '+activeCustomerFilter+' <button onclick="window._filterByCustomer(\''+encodeURIComponent(activeCustomerFilter)+'\')" class="ml-1 text-violet-400 hover:text-violet-700">&times;</button></span>';
            filterBadge.classList.remove('hidden');
        } else if (activeOwnerFilter) {
            filterBadge.innerHTML = '<span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-[10px] font-semibold">Temsilci: '+activeOwnerFilter+' <button onclick="window._filterByOwner(\''+encodeURIComponent(activeOwnerFilter)+'\')" class="ml-1 text-indigo-400 hover:text-indigo-700">&times;</button></span>';
            filterBadge.classList.remove('hidden');
        } else if (activeFirsatSahibiFilter) {
            filterBadge.innerHTML = '<span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-amber-50 text-amber-700 text-[10px] font-semibold">Fırsat Sahibi: '+activeFirsatSahibiFilter+' <button onclick="window._filterByFirsatSahibi(\''+encodeURIComponent(activeFirsatSahibiFilter)+'\')" class="ml-1 text-amber-400 hover:text-amber-700">&times;</button></span>';
            filterBadge.classList.remove('hidden');
        } else {
            filterBadge.classList.add('hidden');
        }

        try {
            var d = await fetch('/FirsatAnaliz/GetOpportunityDetail?' + params).then(function(r) { return r.json(); });
            var tbody = document.getElementById('oppDetailBody');
            if (!d.items || !d.items.length) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-6 text-[#94a3b8] text-[11px]">Veri Bulunamadı</td></tr>';
                document.getElementById('oppPagination').innerHTML = '';
                return;
            }

            // Teklif durumu badge sınıfı (durumun rengi: yeşil = ileri, kırmızı = ret, gri = teklif yok / taslak)
            function teklifBadgeClass(durum) {
                switch (durum) {
                    case 'Kabul Edildi':
                    case 'Onaylandi':
                    case 'Kismen Siparis':
                        return 'bg-emerald-50 text-emerald-700';
                    case 'Sunuldu':
                        return 'bg-indigo-50 text-indigo-700';
                    case 'Incelemede':
                        return 'bg-amber-50 text-amber-700';
                    case 'Reddedildi':
                        return 'bg-red-50 text-red-700';
                    case 'Kapatildi':
                    case 'Taslak':
                        return 'bg-slate-100 text-slate-600';
                    case 'Yok':
                        return 'bg-[#f1f5f9] text-[#94a3b8]';
                    default:
                        return 'bg-[#f1f5f9] text-[#64748b]';
                }
            }

            var h = '';
            d.items.forEach(function(item) {
                var katBadge = item.kategori === 'Yenileme'
                    ? 'bg-emerald-50 text-emerald-700'
                    : 'bg-indigo-50 text-indigo-700';
                var tDurum = item.teklifDurumu || 'Yok';
                var tAdet = item.teklifAdet || 0;
                var tBadge = teklifBadgeClass(tDurum);
                var tTitle = tAdet > 1 ? (tAdet + ' teklif · en son: ' + tDurum) : (tAdet === 1 ? 'En son teklif: ' + tDurum : 'Teklif yok');
                h += '<tr class="border-t border-[#f8fafc] hover:bg-[#fafbfd] transition-colors">';
                h += '<td class="py-2.5 px-2 text-[11px] text-[#334155] font-medium truncate max-w-[240px]" title="' + (item.musteri || '') + '">' + (item.musteri || '--') + '</td>';
                h += '<td class="py-2.5 px-2 text-[11px] text-[#334155] truncate max-w-[260px]" title="' + (item.name || '') + '">' + (item.name || '--') + '</td>';
                h += '<td class="py-2.5 px-2 text-[11px] text-[#64748b]">' + (item.satisTemsilcisi || '--') + '</td>';
                h += '<td class="py-2.5 px-2"><span class="stage-badge ' + katBadge + '">' + (item.kategori || '--') + '</span></td>';
                h += '<td class="py-2.5 px-2" title="' + tTitle + '"><span class="stage-badge ' + tBadge + '">' + tDurum + (tAdet > 1 ? ' · ' + tAdet : '') + '</span></td>';
                h += '<td class="py-2.5 px-2 text-[11px] text-right font-semibold text-[#0f172a]">' + (item.tutar != null ? abbr(item.tutar) : '--') + '</td>';
                h += '<td class="py-2.5 px-2 text-[11px] text-center text-[#64748b]">' + (item.kapanisTarihi || '--') + '</td>';
                h += '</tr>';
            });
            tbody.innerHTML = h;

            // Pagination
            var totalPages = Math.ceil(d.total / d.pageSize);
            var pag = document.getElementById('oppPagination');
            var ph = '<span class="text-[10px] text-[#94a3b8]">' + d.total + ' kayit</span>';
            if (totalPages > 1) {
                for (var p = 1; p <= Math.min(totalPages, 10); p++) {
                    ph += '<button onclick="window._loadOppDetail(' + p + ')" class="pg-btn ' + (p === d.page ? 'active' : '') + '">' + p + '</button>';
                }
                if (totalPages > 10) {
                    ph += '<span class="text-[10px] text-[#94a3b8]">...</span>';
                }
            }
            pag.innerHTML = ph;
        } catch (e) { console.error('Detail error:', e); }
    }
    window._loadOppDetail = loadOppDetail;

    /* ══════════════════════════════════
       EVENT LISTENERS
       ══════════════════════════════════ */

    // Filter tabs — debounce ile hızlı art arda tıklamalarda tek dalga
    document.getElementById('filterTabs').addEventListener('click', function(e) {
        var btn = e.target.closest('.ftab');
        if (!btn) return;
        document.querySelectorAll('.ftab').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        activeFilter = (window.activeFilter = btn.dataset.filter);
        // Reset funnel selection on filter change
        activeFunnel = 0;
        document.querySelectorAll('.funnel-card').forEach(function(c) {
            c.classList.remove('active-card', 'dimmed');
        });
        if (_tabDebounce) clearTimeout(_tabDebounce);
        _tabDebounce = setTimeout(function(){
            refreshAll();
            if (typeof window.loadHedefDetay === 'function') window.loadHedefDetay();
        }, 120);
    });

    // Sort — başlığa tıklama: aynı başlık → yön toggle, farklı başlık → o key'e geç (varsayılan yön: tutar/kapanis desc, diğerleri asc)
    function renderOppSortArrows() {
        document.querySelectorAll('th[data-sort-key]').forEach(function(th) {
            var arrow = th.querySelector('.opp-sort-arrow');
            if (!arrow) return;
            if (th.dataset.sortKey === oppSortVal) {
                arrow.textContent = oppSortDir === 'asc' ? '▲' : '▼';
                th.classList.add('active');
            } else {
                arrow.textContent = '';
                th.classList.remove('active');
            }
        });
    }
    document.querySelectorAll('th[data-sort-key]').forEach(function(th) {
        th.addEventListener('click', function() {
            var key = th.dataset.sortKey;
            if (oppSortVal === key) {
                oppSortDir = oppSortDir === 'asc' ? 'desc' : 'asc';
            } else {
                oppSortVal = key;
                oppSortDir = (key === 'tutar' || key === 'kapanis') ? 'desc' : 'asc';
            }
            renderOppSortArrows();
            loadOppDetail(1);
        });
    });
    renderOppSortArrows();

    // Üst kişi dropdown'ları — change'te activeOwnerFilter / activeFirsatSahibiFilter set + tabloyu yenile
    var _oppTemSel = document.getElementById('oppTemsilciSelect');
    var _oppSahSel = document.getElementById('oppFirsatSahibiSelect');
    if (_oppTemSel) {
        _oppTemSel.addEventListener('change', function(e) {
            activeOwnerFilter = e.target.value || '';
            e.target.classList.toggle('has-value', !!activeOwnerFilter);
            highlightBreakdown('ownerList', activeOwnerFilter || null, 'bg-indigo-50 ring-1 ring-indigo-200');
            renderActiveFilterChips();
            refreshLowerSections();
        });
    }
    if (_oppSahSel) {
        _oppSahSel.addEventListener('change', function(e) {
            activeFirsatSahibiFilter = e.target.value || '';
            e.target.classList.toggle('has-value', !!activeFirsatSahibiFilter);
            highlightBreakdown('firsatSahipleriList', activeFirsatSahibiFilter || null, 'bg-amber-50 ring-1 ring-amber-200');
            renderActiveFilterChips();
            refreshLowerSections();
        });
    }

    /* ══════════════════════════════════
       FIRSAT SAHIPLERI TOGGLE (gizle/göster)
       ══════════════════════════════════ */
    function applyFirsatSahibiVisibility() {
        var hidden = localStorage.getItem('fa_hideFirsatSahibi') === '1';
        var grid = document.getElementById('breakdownGrid');
        var card = grid.querySelector('[data-breakdown-card="sahip"]');
        var btnIcon = document.getElementById('toggleFirsatSahibiIcon');
        var btnText = document.getElementById('toggleFirsatSahibiText');
        if (hidden) {
            card.style.display = 'none';
            grid.className = 'grid grid-cols-3 gap-3 mb-6';
            btnIcon.className = 'bi bi-eye';
            btnText.textContent = 'Fırsat Sahipleri\'ni göster';
            if (activeFirsatSahibiFilter) {
                activeFirsatSahibiFilter = '';
                refreshLowerSections();
            }
        } else {
            card.style.display = '';
            grid.className = 'grid grid-cols-4 gap-3 mb-6';
            btnIcon.className = 'bi bi-eye-slash';
            btnText.textContent = 'Fırsat Sahipleri\'ni gizle';
        }
    }

    /* ══════════════════════════════════
       INIT
       ══════════════════════════════════ */
    document.addEventListener('DOMContentLoaded', function() {
        var toggleBtn = document.getElementById('toggleFirsatSahibiBtn');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function() {
                var current = localStorage.getItem('fa_hideFirsatSahibi') === '1';
                localStorage.setItem('fa_hideFirsatSahibi', current ? '0' : '1');
                applyFirsatSahibiVisibility();
            });
            applyFirsatSahibiVisibility();
        }
        refreshAll();
    });

})();
</script>
}
