<style>
    /* Tek trigger — row altında ortalı pill */
    .fnl-single-trigger {
        display: flex; align-items: center; gap: 12px;
        margin: 12px 0 0 0; cursor: pointer; user-select: none;
    }
    .fnl-single-trigger .fnl-st-line { flex: 1; height: 1px; background: #e5e7eb; }
    .fnl-single-trigger .fnl-st-pill {
        display: inline-flex; align-items: center; gap: 8px;
        background: #fff; border: 1px solid #e5e7eb; border-radius: 999px;
        padding: 6px 14px; font-size: 11px; font-weight: 600; color: #475569;
        transition: all .18s ease;
    }
    .fnl-single-trigger:hover .fnl-st-pill {
        border-color: #c7d2fe; color: #4f46e5; box-shadow: 0 2px 6px rgba(79,70,229,.08);
    }
    .fnl-single-trigger .fnl-chev {
        font-size: 10px; transition: transform .2s ease;
    }
    .fnl-single-trigger.active .fnl-st-pill {
        background: #eef2ff; border-color: #c7d2fe; color: #4f46e5;
    }
    .fnl-single-trigger.active .fnl-chev { transform: rotate(180deg); }

    /* Accordion panel */
    .fnl-expand-panel {
        max-height: 0; overflow: hidden;
        transition: max-height .28s ease, margin-top .28s ease, opacity .2s ease;
        background: #ffffff; border: 1px solid #e2e8f0;
        border-radius: 14px; margin-top: 0; opacity: 0;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
    }
    .fnl-expand-panel.open { max-height: 400px; margin-top: 12px; opacity: 1; }
    .fnl-expand-inner { padding: 24px 28px; }

    /* ── Funnel pipeline — clean block flow ── */
    .fnl-pipe-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 6px; }
    .fnl-pipe-title { font-size: 12px; font-weight: 700; color: #0f172a; }
    .fnl-pipe-meta { font-size: 10px; color: #94a3b8; }

    /* Funnel zinciri: TEK YATAY OK — chevron clip-path ile 3 aşama birleşik */
    .fnl-pipe { display: flex; align-items: stretch; width: 100%; gap: 0; position: relative; padding: 2px 0; }

    .fnl-pipe-stage {
        flex: 1 1 0; padding: 8px 24px 8px 26px; text-align: center;
        background: #f8fafc;
        clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%, 14px 50%);
        margin-right: -14px;
        transition: background .15s ease;
        position: relative;
    }
    .fnl-pipe-stage:first-child {
        clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%);
        padding-left: 14px;
    }
    .fnl-pipe-stage:last-child {
        clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 14px 50%);
        padding-right: 14px;
        margin-right: 0;
    }
    /* 3 aşama — kart renkleriyle uyumlu hafif tonlar */
    .fnl-pipe-stage:nth-child(1) { background: #f5f3ff; }  /* Fırsat — violet-50 */
    .fnl-pipe-stage:nth-child(2) { background: #eff6ff; }  /* Teklif — blue-50  */
    .fnl-pipe-stage:nth-child(3) { background: #ecfdf5; }  /* Satış  — green-50 */
    .fnl-pipe-stage:nth-child(1) .fnl-pipe-label { color: #7c3aed; }
    .fnl-pipe-stage:nth-child(2) .fnl-pipe-label { color: #2563eb; }
    .fnl-pipe-stage:nth-child(3) .fnl-pipe-label { color: #059669; }
    .fnl-pipe-stage:hover { filter: brightness(0.97); }

    .fnl-pipe-label { font-size: 10px; font-weight: 700; color: #64748b; letter-spacing: .4px; margin-bottom: 2px; }
