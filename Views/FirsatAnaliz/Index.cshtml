    // Dönüşüm oranı helper — tutar bazlı, >100 gizle, 0/null → "—"
    function showConv(el, pay, payda, prefix) {
        if (!payda || payda <= 0 || !pay) { el.textContent = '\u2014'; el.classList.remove('hidden'); return; }
        var oran = pay / payda * 100;
        if (oran > 100) { el.classList.add('hidden'); return; }
        if (oran === 0) { el.textContent = '\u2014'; el.classList.remove('hidden'); return; }
        el.textContent = prefix + '%' + fmtPct.format(oran);
        el.classList.remove('hidden');
    }

    async function loadKpis(reqId) {
        reqId = reqId || _reqSeq;
        try {
            // 1) Hafif core — kartlar hemen dolsun (KpiCore endpoint'i Task #9'da eklendi)
            var core = consumeInitial('kpiCore');
            if (!core) {
                var coreUrl = '/FirsatAnaliz/GetKpiCore?' + getFilterParams();
                core = await cachedFetch(coreUrl);
            }
            if (reqId !== _reqSeq) return;

            // Hızlı paint: 5 kartı core verisiyle doldur (animasyonlu countUp)
            var lblCore = donemLabel();
            document.getElementById('kpiLabel2').textContent = lblCore + ' Fırsat';
            document.getElementById('kpiLabel3').textContent = lblCore + ' Teklif';
            document.getElementById('kpiLabel4').textContent = lblCore + ' Sipariş';
            document.getElementById('kpiLabel5').textContent = lblCore + ' Satış Faturası';

            countUp(document.getElementById('kpiVal1'), core.tumFirsatTutar, 500);
            document.getElementById('kpiSub1').textContent = core.tumFirsatAdet + ' fırsat · Açık havuz';
            countUp(document.getElementById('kpiVal2'), core.exFirsatTutar, 500);
            document.getElementById('kpiSub2a').textContent = core.exFirsatAdet + ' fırsat · Henüz teklif verilmemiş';
            countUp(document.getElementById('kpiVal3'), core.exTeklifTutar, 500);
            document.getElementById('kpiSub3').textContent = core.exTeklifAdet + ' fırsat · Teklif aşamasında';
            countUp(document.getElementById('kpiVal4'), core.exSiparisTutar, 500);
            document.getElementById('kpiSub4').textContent = core.exSiparisAdet + ' fırsat · Sipariş aşamasında';
            // Teklif kartı üst toplam (Beklemede + Kabul edildi)
            countUp(document.getElementById('kpiValTeklifTotal'), (core.exTeklifTutar||0) + (core.exSiparisTutar||0), 500);
            countUp(document.getElementById('kpiVal5'), core.kapaliSiparisTutar, 500);
            document.getElementById('kpiSub5').textContent = core.kapaliSiparisAdet + ' faturalanan sipariş';

            // Hedef tutarı hazır — ilk renk kodlaması için
            window._hedefTutar = core.hedefTutar || 0;
            window._faturaData = { kapaliSiparisTutar: core.kapaliSiparisTutar, kapaliSiparisAdet: core.kapaliSiparisAdet, gecenDonemFatura: 0 };

            // 2) Tam summary — footer notları, aşama dağılımı, aylık trend, ağırlıklı potansiyel
            //    Arka planda idle'da çağır, ilk paint'i bloklamasın
            var idle = window.requestIdleCallback || function(cb){ return setTimeout(cb, 80); };
            idle(function(){ if (reqId === _reqSeq) loadKpisFull(reqId); });
        } catch (e) {
            if (e.name !== 'AbortError') console.error('KPI core error:', e);
        }
    }

    // Tam summary — footer / stage dağılımı / aylık trend / hedef paneli
    async function loadKpisFull(reqId) {
        reqId = reqId || _reqSeq;
        try {
            var opp = consumeInitial('summary') || await cachedFetch('/FirsatAnaliz/GetOpportunitySummary?' + getFilterParams());
            if (reqId !== _reqSeq) return;
            var lbl = donemLabel();

            // Sarı notu kaldır (ilk paint'te de set edilebilir ama burada kalsın)
            document.getElementById('kpiNote1').classList.add('hidden');

            // Card 1: Won + Lost info
            var lost1 = document.getElementById('kpiLost1');
            var totalExcluded1 = (opp.wonHavuzAdet || 0) + (opp.lostAdet || 0);
            if (totalExcluded1 > 0) {
                var parts1 = [];
                if (opp.wonHavuzAdet > 0) parts1.push(opp.wonHavuzAdet + ' kazanılan (' + abbr(opp.wonHavuzTutar) + ')');
                if (opp.lostAdet > 0) parts1.push(opp.lostAdet + ' kaybedilen (' + abbr(opp.lostTutar) + ')');
                document.getElementById('kpiLost1Text').innerHTML = '<i class="bi bi-exclamation-triangle-fill" style="font-size:11px;margin-right:4px;"></i>' + parts1.join(' + ') + ' hariç tutuldu';
                lost1.classList.remove('hidden');
            } else lost1.classList.add('hidden');

            // Card 2: exclusive pipeline rafine değer (GetKpiCore SP proxy'sini summary ile değiştir)
            countUp(document.getElementById('kpiVal2'), opp.exFirsatTutar, 300);
            document.getElementById('kpiSub2a').textContent = opp.exFirsatAdet + ' fırsat · Henüz teklif verilmemiş';
            // Card 3: rafine
            countUp(document.getElementById('kpiVal3'), opp.exTeklifTutar, 300);
            document.getElementById('kpiSub3').textContent = opp.exTeklifAdet + ' fırsat · Teklif aşamasında';
            // Card 4: rafine
            countUp(document.getElementById('kpiVal4'), opp.exSiparisTutar, 300);
            document.getElementById('kpiSub4').textContent = opp.exSiparisAdet + ' fırsat · Sipariş aşamasında';
            // Teklif kartı üst toplam (rafine)
            countUp(document.getElementById('kpiValTeklifTotal'), (opp.exTeklifTutar||0) + (opp.exSiparisTutar||0), 300);
            // Card 2 (Fırsat): sadece "X kaybedilen hariç"
            var lost2 = document.getElementById('kpiLost2');
            if (opp.donemLostAdet > 0) {
                document.getElementById('kpiLost2Text').innerHTML = '<i class="bi bi-info-circle-fill" style="font-size:11px;margin-right:4px;"></i>' + opp.donemLostAdet + ' kaybedilen hariç';
                lost2.classList.remove('hidden');
            } else lost2.classList.add('hidden');

            // Card 3 (Teklif): sadece "X reddedilen hariç"
            var lost3 = document.getElementById('kpiLost3');
            if (opp.lostTeklifAdet > 0) {
                document.getElementById('kpiLost3Text').innerHTML = '<i class="bi bi-info-circle-fill" style="font-size:11px;margin-right:4px;"></i>' + opp.lostTeklifAdet + ' reddedilen hariç';
                lost3.classList.remove('hidden');
            } else lost3.classList.add('hidden');

            // Card 4: Footer temizle (Bu Ay Sipariş ayrı kart değil — Teklif altında kabul edildi olarak gösteriliyor)
            var lost4 = document.getElementById('kpiLost4');
            if (lost4) lost4.classList.add('hidden');

            // Card 5 — kpiVal5 RE-UPDATE: initial state stale ise üst kart yanlış kalmasın
            // (Önceki bug: kpiVal5 sadece loadKpis'te bir kez set ediliyordu, summary'den taze değer gelmiyordu)
            countUp(document.getElementById('kpiVal5'), opp.kapaliSiparisTutar, 300);
            document.getElementById('kpiSub5').textContent = opp.exFaturaAdet + ' fırsat · Faturaya dönüştü';

            // Satış kartı — DealType breakdown: Yenileme vs Yeni Satış (Diğer = Yeni Satış'a dahil)
            var yT = opp.faturaYenilemeTutar || 0, yA = opp.faturaYenilemeAdet || 0;
            var nT = (opp.faturaYeniSatisTutar || 0) + (opp.faturaDigerTutar || 0);
            var nA = (opp.faturaYeniSatisAdet  || 0) + (opp.faturaDigerAdet  || 0);
            document.getElementById('kpiSatisYenilemeAdet').textContent = yA + ' fatura';
            document.getElementById('kpiSatisYenilemeTutar').textContent = abbr(yT);
            document.getElementById('kpiSatisYeniAdet').textContent      = nA + ' fatura';
            document.getElementById('kpiSatisYeniTutar').textContent     = abbr(nT);

            document.getElementById('kpiVal4').dataset.raw = opp.exSiparisTutar;
            window._oppData = opp;
            // Sub-funnel panel açıksa filter değişimi sonrası yeni veriyi göster
            if (_subFunnelOpen) renderSubFunnel();
            // Üst funnel zincirini de yeniden çiz (renderFunnelExpand _oppData kullanır)
            if (typeof renderFunnelExpand === 'function') renderFunnelExpand();
            window._hedefTutar = opp.hedefTutar || 0;
            // Fatura verisi — exclusive fırsat adedi + SP fatura tutarı
            window._faturaData = { kapaliSiparisTutar: opp.kapaliSiparisTutar, kapaliSiparisAdet: opp.exFaturaAdet, gecenDonemFatura: opp.gecenDonemFatura };
            if (opp.hedefTutar > 0) updateHedefWithFatura(window._faturaData);

            // Kart 2-4 hedef renk kodları (fatura bağımsız)
            var hedef = opp.hedefTutar || 0;
            if (hedef > 0) {
                [
                    { idx: 2, val: opp.exFirsatTutar },
                    { idx: 3, val: opp.exTeklifTutar },
                    { idx: 4, val: opp.exSiparisTutar }
                ].forEach(function(k) {
                    var pct = (k.val / hedef) * 100;
                    var card = document.querySelector('[data-funnel="' + k.idx + '"]');
                    if (!card) return;
                    card.classList.remove('kpi-border-green','kpi-border-amber','kpi-border-red');
                    card.classList.add(pct >= 100 ? 'kpi-border-green' : pct >= 85 ? 'kpi-border-amber' : 'kpi-border-red');
                });

                // Dönem etiketi + hedef tutar (fatura bağımsız)
                document.getElementById('hedefDonemLabel').textContent = lbl + ' Hedefi';
                document.getElementById('hedefHedefTutar').textContent = abbr(hedef);
            }

            // Aylık dağılım grafiği (fatura bağımsız)
            renderMonthlyChart(opp.aylikTrend || []);
            renderFunnelExpand(); // Funnel her zaman görünür

            // Hedef paneli + potansiyel + geçen dönem → fatura verisi gelince render edilecek (updateHedefWithFatura)

        } catch (e) { console.error('KPI error:', e); }
    }

    // Fatura verisi gelince hedef panelinin tamamını render et
    function updateHedefWithFatura(f) {
        var opp = window._oppData;
        var hedef = window._hedefTutar;
        if (!opp || !hedef || hedef <= 0) return;

        var fatVal = f.kapaliSiparisTutar || 0;
        var faturaPct = (fatVal / hedef) * 100;

        function pctColor(v) { return v >= 100 ? 'text-emerald-600' : v >= 85 ? 'text-amber-600' : 'text-red-500'; }
        function safeHtml(id, html) { var el = document.getElementById(id); if (el) el.innerHTML = html; }

        // Hedef kartı stripe rengi (Satış kartı yerine artık ayrı Hedef kartında)
        var hedefStripe = document.getElementById('hedefStripe');
        if (hedefStripe) {
            hedefStripe.style.background = faturaPct >= 100 ? '#10b981' : faturaPct >= 85 ? '#f59e0b' : '#ef4444';
        }

        // Büyük yüzde + progress bar
        var el = document.getElementById('hedefPctBig');
        if (el) { el.textContent = '%' + fmtPct.format(faturaPct); }
        var bar = document.getElementById('hedefBarBig');
        if (bar) {
            setTimeout(function() {
                var circ = 301.59; // 2π × r (r=48)
                var dash = Math.min(faturaPct, 100) / 100 * circ;
                bar.setAttribute('stroke-dasharray', dash + ' ' + circ);
                bar.setAttribute('stroke', faturaPct >= 100 ? '#10b981' : faturaPct >= 85 ? '#f59e0b' : '#ef4444');
            }, 200);
        }
        var ge = document.getElementById('hedefGerceklesen');
        if (ge) ge.textContent = abbr(fatVal);

        // Kalan iş günü + günlük gerekli (sadece "Bu Ay" filtresi için anlamlı)
        (function() {
            var tempoBox = document.getElementById('hedefTempoBox');
            if (!tempoBox) return;
            if (activeFilter && activeFilter !== 'month') { tempoBox.classList.add('hidden'); return; }
            var now = new Date();
            var ayBasi = new Date(now.getFullYear(), now.getMonth(), 1);
            var aySonu = new Date(now.getFullYear(), now.getMonth()+1, 0);
            // 2026 TR resmi tatilleri (minimum liste; güncellenebilir)
            var tatiller = new Set(['2026-01-01','2026-04-23','2026-05-01','2026-05-19','2026-05-27','2026-05-28','2026-05-29','2026-05-30','2026-07-15','2026-08-30','2026-10-29','2027-01-01']);
            function ymd(d){ return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
            function isIsg(d){ var g=d.getDay(); if(g===0||g===6) return false; return !tatiller.has(ymd(d)); }
            // Yarından ay sonuna kadar iş günü (bugün dahil değil)
            var kalan = 0;
            var cur = new Date(now.getFullYear(), now.getMonth(), now.getDate()+1);
            while (cur <= aySonu) { if (isIsg(cur)) kalan++; cur.setDate(cur.getDate()+1); }
            var kalanTutar = Math.max(0, hedef - fatVal);
            var gunluk = kalan > 0 ? kalanTutar / kalan : 0;
            document.getElementById('hedefKalanGun').textContent = kalan;
            document.getElementById('hedefGunlukGerekli').textContent = kalan > 0 ? abbr(gunluk) : '—';
            tempoBox.classList.remove('hidden');
        })();

        // Geçen dönem karşılaştırma
        var gecenFat = f.gecenDonemFatura || 0;
        if (gecenFat > 0) {
            var gecenTutarEl = document.getElementById('gecenAyTutar');
            if (gecenTutarEl) gecenTutarEl.textContent = abbr(gecenFat);
            var trendEl = document.getElementById('gecenAyTrend');
            if (trendEl && fatVal > 0) {
                var trendPct = ((fatVal - gecenFat) / gecenFat * 100);
                trendEl.innerHTML = '<span class="' + (trendPct >= 0 ? 'text-emerald-600' : 'text-red-500') + '">' + (trendPct >= 0 ? '\u2191' : '\u2193') + ' %' + fmtPct.format(Math.abs(trendPct)) + '</span>';
            }
        }

        // Aşama detayları
        var fp = (opp.exFirsatTutar||0)/hedef*100, tp = (opp.exTeklifTutar||0)/hedef*100, sp = (opp.exSiparisTutar||0)/hedef*100;
        safeHtml('hedefFirsatPct', abbr(opp.exFirsatTutar||0) + ' <span class="' + pctColor(fp) + '">%' + fmtPct.format(fp) + '</span>');
        safeHtml('hedefTeklifPct', abbr(opp.exTeklifTutar||0) + ' <span class="' + pctColor(tp) + '">%' + fmtPct.format(tp) + '</span>');
        safeHtml('hedefSiparisPct', abbr(opp.exSiparisTutar||0) + ' <span class="' + pctColor(sp) + '">%' + fmtPct.format(sp) + '</span>');
        safeHtml('hedefFaturaPct', abbr(fatVal) + ' <span class="' + pctColor(faturaPct) + '">%' + fmtPct.format(faturaPct) + '</span>');

        // Huni chart
        renderHedefChart(hedef, opp);

        // Potansiyel analizi
        var potArea = document.getElementById('potansiyelArea');
        if (potArea) {
            var teklifPotansiyel = opp.agirlikliPotansiyel || 0;
            var acikSipTutar = opp.exSiparisTutar || 0; // Exclusive: sadece faturası olmayanlar
            var toplamPotansiyel = fatVal + acikSipTutar + teklifPotansiyel;
            var potPct = (toplamPotansiyel / hedef) * 100;
            var ortOlasilik = opp.ortOlasilik || 0;

            // Yüksek olasılıklı teklif sayısı (≥%90) — agirlikliPotansiyel artık bu dilim üzerinden
            var yuksekTeklifAdet = opp.agirlikliPotansiyelAdet || 0;
            var yuksekTeklifTutar = opp.yuksekOlasilikliTutar || 0;
            var sipAdet = opp.exSiparisAdet || 0;
            var fatAdet = opp.kapaliSiparisAdet || 0;

            var ph = '';
            ph += '<div class="px-3 py-2.5 rounded-lg bg-violet-50/50 border border-violet-100">';
            ph += '<p class="text-[10px] font-bold text-violet-700">Teklif potansiyeli</p>';
            ph += '<p class="text-[18px] font-extrabold text-violet-700">' + abbr(teklifPotansiyel) + '</p>';
            ph += '<p class="text-[9px] text-violet-600">≥%90 olasılıklı <b>' + yuksekTeklifAdet + ' teklif</b> · ham tutar ' + abbr(yuksekTeklifTutar) + '</p>';
            ph += '</div>';
            var potClr = potPct >= 100 ? 'bg-emerald-50 border-emerald-200' : potPct >= 85 ? 'bg-amber-50 border-amber-200' : 'bg-red-50 border-red-200';
            var potTxtClr = potPct >= 100 ? 'text-emerald-700' : potPct >= 85 ? 'text-amber-700' : 'text-red-700';
            ph += '<div class="px-3 py-2.5 rounded-lg ' + potClr + ' border">';
            ph += '<p class="text-[10px] font-bold ' + pctColor(potPct) + '">Tahmini hedef gerçekleşme</p>';
            ph += '<p class="text-[22px] font-extrabold ' + pctColor(potPct) + '">%' + fmtPct.format(potPct) + '</p>';
            ph += '<div class="mt-2 space-y-1.5">';
            ph += '<div class="flex items-center justify-between"><span class="text-[11px] text-[#64748b]"><span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 mr-1.5"></span>Faturalanan <span class="text-[#94a3b8]">(' + fatAdet + ' fatura)</span></span><span class="text-[15px] font-bold text-emerald-700">' + abbr(fatVal) + '</span></div>';
            ph += '<div class="flex items-center justify-between"><span class="text-[11px] text-[#64748b]"><span class="inline-block w-2.5 h-2.5 rounded-full bg-cyan-500 mr-1.5"></span>Açık sipariş <span class="text-[#94a3b8]">(' + sipAdet + ' sipariş)</span></span><span class="text-[15px] font-bold text-cyan-700">' + abbr(acikSipTutar) + '</span></div>';
            ph += '<div class="flex items-center justify-between"><span class="text-[11px] text-[#64748b]"><span class="inline-block w-2.5 h-2.5 rounded-full bg-violet-500 mr-1.5"></span>Teklif potansiyeli <span class="text-[#94a3b8]">(ağırlıklı)</span></span><span class="text-[15px] font-bold text-violet-700">' + abbr(teklifPotansiyel) + '</span></div>';
            ph += '</div>';
            ph += '<div class="flex items-center justify-between mt-2 pt-2 border-t border-[#e2e8f0]"><span class="text-[11px] font-semibold text-[#475569]">Toplam</span><span class="text-[17px] font-extrabold text-[#0f172a]">' + abbr(toplamPotansiyel) + ' <span class="text-[11px] font-normal text-[#94a3b8]">/ ' + abbr(hedef) + '</span></span></div>';
            ph += '</div>';
            potArea.innerHTML = ph;
        }
    }

