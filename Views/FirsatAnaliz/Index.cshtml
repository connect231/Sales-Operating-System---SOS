        .hd-sub-row td.sub-isim { padding-left: 36px; font-style: normal; }
        .hd-sub-row .sub-label { display: inline-flex; align-items: center; gap: 6px; }
        .hd-sub-row .sub-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; display: inline-block; }
        .hd-sub-row .sub-dot.ys  { background: #3b82f6; }
        .hd-sub-row .sub-dot.yen { background: #8b5cf6; }
        .hd-sub-row .sub-mut { color: #cbd5e1; }
    </style>

    <script>
        (function () {
            const toggle = document.getElementById('hedefDetayToggle');
            const body = document.getElementById('hedefDetayBody');
            const chevron = document.getElementById('hedefDetayChevron');
            const tbody = document.getElementById('hedefDetayRows');
            const donemLabel = document.getElementById('hedefDetayDonemLabel');
            if (!toggle || !body) return;

            const DONEM_LABELS = {
                month: 'Bu Ay', lastmonth: 'Geçen Ay',
                q1: '1. Çeyrek', q2: '2. Çeyrek', q3: '3. Çeyrek', q4: '4. Çeyrek',
                ytd: 'YTD', all: 'Tüm Yıl'
            };

            function fmtTL(v) {
                if (v == null || isNaN(v)) return '—';
                return '₺' + Math.round(v).toLocaleString('tr-TR');
            }
            function fmtPct(v) {
                if (v == null || isNaN(v)) return '—';
                return v.toFixed(0) + '%';
            }
            function activeTab() {
                const a = document.querySelector('.hd-tab-btn.active');
                return a ? a.dataset.htab : 'satisci';
            }
            function activeDonem() {
                return (typeof window.activeFilter !== 'undefined' && window.activeFilter) || 'month';
            }

            function subRow(label, dotClass, hedef, gerc) {
                const yuzde = hedef > 0 ? (gerc / hedef * 100) : 0;
                return `<tr class="hd-sub-row">
                    <td class="sub-isim"><span class="sub-label"><span class="sub-dot ${dotClass}"></span>${label}</span></td>
                    <td class="text-right px-3">${fmtTL(hedef)}</td>
                    <td class="text-right px-3 font-semibold text-[#475569]">${fmtTL(gerc)}</td>
                    <td class="text-right px-3">${fmtPct(yuzde)}</td>
                    <td class="text-right px-3 sub-mut">—</td>
                    <td class="text-right px-3 sub-mut">—</td>
                    <td class="text-right px-3 sub-mut">—</td>
                    <td class="px-3 sub-mut">—</td>
                </tr>`;
            }

            function renderRows(rows) {
                if (!rows || !rows.length) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-10 text-[11px] text-[#94a3b8]">Bu dönem için kayıt yok</td></tr>';
                    return;
                }
                const tab = activeTab();
                // Sub-row'lar: ürün ve satışçı tab'larında her satırın altına Yeni Satış + Yenileme.
                // 'yenileme' tab'ı zaten kendi başına 2 satır (YS/Yen toplam) — sub-row eklemiyoruz.
                const showSubRows = (tab === 'urun' || tab === 'satisci');
                let html = '';
                let tH = 0, tG = 0, tT = 0, tA = 0;
                rows.forEach(r => {
                    tH += r.hedef || 0; tG += r.gerceklesen || 0;
                    tA += r.acikTeklif || 0; tT += (r.gerceklesen || 0) + (r.acikTeklif || 0);
                    const yuzde = r.hedef > 0 ? (r.gerceklesen / r.hedef * 100) : 0;
                    const tahminiTutar = (r.gerceklesen || 0) + (r.acikTeklif || 0);
                    const tahminiYuzde = r.hedef > 0 ? (tahminiTutar / r.hedef * 100) : 0;
                    const wG = Math.min(100, yuzde);
                    const wT = Math.min(100 - wG, Math.max(0, tahminiYuzde - yuzde));
                    const asim = tahminiYuzde > 100 ? Math.round(tahminiYuzde - 100) : 0;
                    html += `<tr class="border-b border-[#f1f5f9] hover:bg-[#f8fafc]">
                        <td class="px-4 py-2.5 font-medium text-[#0f172a]">${r.isim || '—'}</td>
                        <td class="text-right px-3 py-2.5 text-[#475569]">${fmtTL(r.hedef)}</td>
                        <td class="text-right px-3 py-2.5 text-[#0f172a] font-semibold">${fmtTL(r.gerceklesen)}</td>
                        <td class="text-right px-3 py-2.5 text-[#475569]">${fmtPct(yuzde)}</td>
                        <td class="text-right px-3 py-2.5 text-[#475569]">${fmtTL(r.acikTeklif)}</td>
                        <td class="text-right px-3 py-2.5 text-[#0f172a] font-semibold">${fmtTL(tahminiTutar)}</td>
                        <td class="text-right px-3 py-2.5 text-[#4f46e5] font-bold">${fmtPct(tahminiYuzde)}${asim ? ` <span class="text-[9px] text-[#94a3b8] font-medium">+${asim}%</span>` : ''}</td>
                        <td class="px-3 py-2.5">
                            <div class="w-full h-2 rounded-full bg-[#f1f5f9] overflow-hidden flex">
                                <div style="width:${wG}%; background:#4f46e5; transition:width .6s ease"></div>
                                <div style="width:${wT}%; background:#4f46e5; opacity:.35; background-image:repeating-linear-gradient(45deg, transparent, transparent 3px, rgba(255,255,255,.5) 3px, rgba(255,255,255,.5) 6px); transition:width .6s ease"></div>
                            </div>
                        </td>
                    </tr>`;

                    // Ürün tab'ında alt satırlar: Yeni Satış + Yenileme (dönem aralığında)
                    if (showSubRows) {
                        html += subRow('Yeni Satış', 'ys',  r.hedefYS  || 0, r.gerceklesenYS  || 0);
                        html += subRow('Yenileme',   'yen', r.hedefYen || 0, r.gerceklesenYen || 0);
                    }
                });
                const tYuzde = tH > 0 ? tG / tH * 100 : 0;
                const tTYuzde = tH > 0 ? tT / tH * 100 : 0;
                const twG = Math.min(100, tYuzde);
                const twT = Math.min(100 - twG, Math.max(0, tTYuzde - tYuzde));
                html += `<tr class="border-t-2 border-[#e2e8f0] bg-[#f8fafc] font-bold sticky bottom-0">
                    <td class="px-4 py-3 text-[#0f172a]">TOPLAM</td>
                    <td class="text-right px-3 py-3 text-[#0f172a]">${fmtTL(tH)}</td>
                    <td class="text-right px-3 py-3 text-[#0f172a]">${fmtTL(tG)}</td>
                    <td class="text-right px-3 py-3 text-[#0f172a]">${fmtPct(tYuzde)}</td>
                    <td class="text-right px-3 py-3 text-[#0f172a]">${fmtTL(tA)}</td>
                    <td class="text-right px-3 py-3 text-[#0f172a]">${fmtTL(tT)}</td>
                    <td class="text-right px-3 py-3 text-[#4f46e5]">${fmtPct(tTYuzde)}</td>
                    <td class="px-3 py-3">
                        <div class="w-full h-2 rounded-full bg-[#e2e8f0] overflow-hidden flex">
                            <div style="width:${twG}%; background:#4f46e5"></div>
                            <div style="width:${twT}%; background:#4f46e5; opacity:.35; background-image:repeating-linear-gradient(45deg, transparent, transparent 3px, rgba(255,255,255,.5) 3px, rgba(255,255,255,.5) 6px)"></div>
                        </div>
                    </td>
                </tr>`;
                tbody.innerHTML = html;
            }

            let _loadSeq = 0;
            window.loadHedefDetay = function () {
                if (body.classList.contains('hidden')) return;
                const tab = activeTab();
                const donem = activeDonem();
                if (donemLabel) donemLabel.textContent = DONEM_LABELS[donem] || donem;
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-10 text-[11px] text-[#94a3b8]">Yükleniyor…</td></tr>';
                const seq = ++_loadSeq;
                fetch('/Hedef/AnalizDetay?tab=' + encodeURIComponent(tab) + '&donem=' + encodeURIComponent(donem))
                    .then(r => r.json())
                    .then(j => {
                        if (seq !== _loadSeq) return;
                        if (!j.ok) {
                            tbody.innerHTML = '<tr><td colspan="8" class="text-center py-10 text-[11px] text-red-500">' + (j.error || 'Hata') + '</td></tr>';
                            return;
                        }
                        renderRows(j.rows || []);
                    })
                    .catch(e => {
                        if (seq !== _loadSeq) return;
                        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-10 text-[11px] text-red-500">' + e.message + '</td></tr>';
                    });
            };

            toggle.addEventListener('click', () => {
                const opening = body.classList.contains('hidden');
                body.classList.toggle('hidden');
                toggle.setAttribute('aria-expanded', opening ? 'true' : 'false');
                chevron.style.transform = opening ? 'rotate(180deg)' : 'rotate(0deg)';
                if (opening) window.loadHedefDetay();
            });

            document.querySelectorAll('.hd-tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.hd-tab-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    window.loadHedefDetay();
                });
            });

            // Default open: panel başlangıçta açık geliyor — ilk veri yüklemesini tetikle.
            // setTimeout 0: activeFilter atamasının (~line 1434) önce çalışmasına izin verir.
            if (!body.classList.contains('hidden')) {
                setTimeout(() => window.loadHedefDetay(), 0);
            }
        })();
    </script>

    <!-- ═══ AYLIK DAĞILIM ═══ -->
    <div class="flex gap-5 mb-6">
        <!-- Aylık Fırsat Dağılımı -->
        <div class="w-full fa-card p-5 fade-up">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center">
