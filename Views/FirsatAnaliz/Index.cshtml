    // Funnel kart tıklama — tek handler
    var _funnelLoading = false;
    window._clickFunnel = function(idx) {
        if (_funnelLoading) return; // Çift tıklama engeli
        var cards = document.querySelectorAll(".funnel-card");
        var subs = document.querySelectorAll('[data-teklif-sub]');
        if (activeFunnel === idx) {
            activeFunnel = 0;
            cards.forEach(function(c) { c.classList.remove("active-card","dimmed"); });
            subs.forEach(function(s) { s.classList.remove("teklif-sub-active"); });
        } else {
            activeFunnel = idx;
            cards.forEach(function(c) {
                // data-funnel birden fazla değer tutabilir (ör. Teklif kartı "3,4") — herhangi biri eşleşirse active
                var fs = (c.dataset.funnel || "").split(",").map(function(x){ return parseInt(x.trim()); });
                if (fs.indexOf(idx) >= 0) { c.classList.add("active-card"); c.classList.remove("dimmed"); }
                else { c.classList.remove("active-card"); c.classList.add("dimmed"); }
            });
            // Teklif alt satır aktif göstergesi
            subs.forEach(function(s) {
                var sub = s.dataset.teklifSub;
                var isActive = (sub === "bekleme" && idx === 3) || (sub === "kabul" && idx === 4);
                s.classList.toggle("teklif-sub-active", isActive);
            });
        }
        _funnelLoading = true;
        refreshLowerSections().then(function() { _funnelLoading = false; });
    };

    /* ══════════════════════════════════
       LOAD ALL
       ══════════════════════════════════ */
    // Son başarılı refreshAll zamanı — age badge + visibility auto-refresh için
    var _lastRefreshAt = Date.now();

    async function refreshAll(opts) {
        opts = opts || {};
        var myReq = ++_reqSeq;
        var prevForce = _forceNextFetch;
        if (opts.force) {
            _forceNextFetch = true;
            window._clearClientCache && window._clearClientCache();
        }

        document.querySelectorAll('.content-panel').forEach(function(p){ p.classList.add('fading'); });

        try {
            await Promise.all([
                loadKpis(myReq),
                loadFunnelBreakdown(activeFunnel > 0 ? activeFunnel : 2, myReq),
                loadOppDetail(1, myReq),
                loadSalesCycle(myReq),
                loadAgingData(myReq)
            ]);
            // Sub-funnel artık _oppData.subFunnel'dan geliyor; filter değişince loadKpis zaten yeni veri çeker
            if (_subFunnelOpen) renderSubFunnel();
            if (myReq === _reqSeq) {
                _lastRefreshAt = Date.now();
                updateDataAgeBadge();
            }
        } finally {
            if (myReq === _reqSeq) {
                document.querySelectorAll('.content-panel').forEach(function(p){ p.classList.remove('fading'); });
            }
            // force flag'i sadece bu refreshAll için aktifti — sıfırla
            _forceNextFetch = prevForce;
        }
    }

    // ──────────── Veri Tazeliği UX ────────────
    // Age badge: son refresh'ten geçen süre (sürekli görünmez — sadece >2 dk eskiyse)
    function updateDataAgeBadge() {
        var badge = document.getElementById('dataAgeBadge');
        if (!badge) return;
        var ageSec = Math.floor((Date.now() - _lastRefreshAt) / 1000);
        if (ageSec < 120) { badge.classList.add('hidden'); return; }
        var txt;
        if (ageSec < 60) txt = ageSec + ' sn önce';
        else if (ageSec < 3600) txt = Math.floor(ageSec/60) + ' dk önce';
        else txt = Math.floor(ageSec/3600) + ' sa önce';
        badge.textContent = '· ' + txt;
        badge.classList.remove('hidden');
    }
    setInterval(updateDataAgeBadge, 30000);

    // Manuel "Yenile" butonu — force fetch + spin animation + clientCache temizle
    document.addEventListener('DOMContentLoaded', function() {
        var btn = document.getElementById('btnRefreshAll');
        if (!btn) return;
        var icon = btn.querySelector('i');
        btn.addEventListener('click', async function() {
            if (btn.disabled) return;
            btn.disabled = true;
            icon && icon.classList.add('animate-spin');
            try { await refreshAll({ force: true }); }
            finally {
                btn.disabled = false;
                icon && icon.classList.remove('animate-spin');
            }
        });
    });

    // Sessiz auto-refresh: kullanıcı sekmeye geri döndüğünde son refresh >5 dk eskiyse arka planda tazele.
    // Görsel feedback yok — sadece data güncellenir, kart değerleri smooth countUp ile değişir.
    document.addEventListener('visibilitychange', function() {
        if (document.visibilityState !== 'visible') return;
        var ageMs = Date.now() - _lastRefreshAt;
        if (ageMs > 5 * 60 * 1000) {
            // Background fetch — opacity düşürmeden, butona dokunmadan
            refreshAll({ force: true }).catch(function(){});
        }
    });

    async function loadSalesCycle(reqId) {
        reqId = reqId || _reqSeq;
        try {
            var data = await cachedFetch('/FirsatAnaliz/GetSalesCycleData?' + getFilterParams());
            if (reqId !== _reqSeq) return;
            renderSalesCycle(data);
        } catch(e) { if (e.name !== 'AbortError') console.error('SalesCycle error:', e); }
    }

    async function loadAgingData(reqId) {
        reqId = reqId || _reqSeq;
        try {
            // Aging filter'dan bağımsız — sadece person filtresini ilet
            var personParam = '';
            try { var u = new URLSearchParams(getFilterParams()); if (u.get('person')) personParam = '?person=' + encodeURIComponent(u.get('person')); } catch(_) {}
            var data = await cachedFetch('/FirsatAnaliz/GetAgingData' + personParam);
            if (reqId !== _reqSeq) return;
            renderAging(data);
        } catch(e) { if (e.name !== 'AbortError') console.error('Aging error:', e); }
    }

    function renderAging(data) {
        if (!data) return;
        var setText = function(id, v) { var el = document.getElementById(id); if (el) el.textContent = v; };
        var fmtAdet = function(n) { return (Number(n)||0).toLocaleString('tr-TR'); };
        var fmtTutar = function(v) {
            v = Number(v) || 0;
            if (Math.abs(v) >= 1e9) return '₺' + (v/1e9).toFixed(1) + 'Mr';
            if (Math.abs(v) >= 1e6) return '₺' + (v/1e6).toFixed(1) + 'M';
            if (Math.abs(v) >= 1e3) return '₺' + (v/1e3).toFixed(0) + 'K';
            return '₺' + Math.round(v);
        };
        // Fırsat
        if (data.firsat) {
            setText('agingFirsat30', fmtAdet(data.firsat.g30 && data.firsat.g30.adet));
            setText('agingFirsat30Tutar', fmtTutar(data.firsat.g30 && data.firsat.g30.tutar));
            setText('agingFirsat60', fmtAdet(data.firsat.g60 && data.firsat.g60.adet));
            setText('agingFirsat60Tutar', fmtTutar(data.firsat.g60 && data.firsat.g60.tutar));
            setText('agingFirsat90', fmtAdet(data.firsat.g90 && data.firsat.g90.adet));
            setText('agingFirsat90Tutar', fmtTutar(data.firsat.g90 && data.firsat.g90.tutar));
        }
        // Teklif
        if (data.teklif) {
            setText('agingTeklif30', fmtAdet(data.teklif.g30 && data.teklif.g30.adet));
            setText('agingTeklif30Tutar', fmtTutar(data.teklif.g30 && data.teklif.g30.tutar));
            setText('agingTeklif60', fmtAdet(data.teklif.g60 && data.teklif.g60.adet));
            setText('agingTeklif60Tutar', fmtTutar(data.teklif.g60 && data.teklif.g60.tutar));
            setText('agingTeklif90', fmtAdet(data.teklif.g90 && data.teklif.g90.adet));
            setText('agingTeklif90Tutar', fmtTutar(data.teklif.g90 && data.teklif.g90.tutar));
        }
    }

    // loadFaturaKarti kaldırıldı: hiç çağrılmıyordu (dead code).
    // Kart 5 (Faturalanan) verisi loadKpis (GetKpiCore) ve loadKpisFull (GetOpportunitySummary)
    // tarafından zaten dolduruluyor — ayrı GetFaturaKarti AJAX'a ihtiyaç yoktu.

    async function refreshLowerSections() {
        var myReq = ++_reqSeq;
        var funnel = activeFunnel > 0 ? activeFunnel : 2;
        await Promise.all([
            loadFunnelBreakdown(funnel, myReq),
            loadOppDetail(1, myReq)
        ]);
    }

    // iOS-like fade transition
    function fadeOut(el) { el.classList.add('fading'); }
    function fadeIn(el) { el.classList.remove('fading'); }

    /* ── Ortak breakdown renderer: DocumentFragment ile tek DOM write ── */
    function renderBreakdownList(containerId, rows, type) {
        try {
        var el = document.getElementById(containerId);
        if (!el) { console.warn('[FA] renderBreakdownList: el yok', containerId); return; }
        if (!rows || !rows.length) {
            el.innerHTML = (type === 'customer')
                ? ''
                : '<p class="text-[11px] text-[#94a3b8] text-center py-6">Veri Bulunamadı</p>';
            return;
        }
        var frag = document.createDocumentFragment();
        var totalTutar = 0, totalAdet = 0;
        var maxTutar = 1;
        if (type === 'product' || type === 'customer') {
            maxTutar = Math.max.apply(null, rows.map(function(r){ return r.tutar || 0; })) || 1;
        }

        rows.forEach(function(r, i) {
            var label = (type === 'product') ? r.urun : (type === 'customer' ? r.musteri : r.adSoyad);
            var isDiger = (label === 'Diğer') && r.detay && r.detay.length > 0;
            var div = document.createElement('div');
            if (type === 'owner') {
                var isActive = activeOwnerFilter === r.adSoyad;
                div.className = 'flex items-center gap-3 py-2.5 px-2 rounded-lg ' + (isDiger ? 'cursor-pointer hover:bg-slate-50' : 'cursor-pointer transition-colors group ') +
                                (isActive ? ' bg-indigo-50 ring-1 ring-indigo-200' : (isDiger ? '' : ' hover:bg-[#f8fafc]'));
                if (isDiger) {
                    div.setAttribute('data-diger-row','1');
