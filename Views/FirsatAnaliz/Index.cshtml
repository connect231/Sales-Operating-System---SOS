        html += '  <div class="fnl-pipe-label">Satış</div>';
        html += '  <div class="fnl-pipe-tutar">'+abbr(satisTutar)+'</div>';
        html += '  <div class="fnl-pipe-adet">'+satisAdet+' adet</div>';
