@model SOS.Models.ViewModels.FirsatAnalizViewModel

@{
    ViewData["Title"] = "Fırsat Analizi";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap');

    .fa-dash { font-family: 'DM Sans', sans-serif; color: #1e293b; }
    .fa-dash * { box-sizing: border-box; }

    /* ── CountUp + Fade-in Animations ── */
    .fade-up {
        opacity: 0;
        transform: translateY(16px);
        animation: fadeUp 0.6s cubic-bezier(0.25,0.46,0.45,0.94) forwards;
    }
    .fade-up-d1 { animation-delay: 0.05s; }
    .fade-up-d2 { animation-delay: 0.10s; }
    .fade-up-d3 { animation-delay: 0.15s; }
    .fade-up-d4 { animation-delay: 0.20s; }
    .fade-up-d5 { animation-delay: 0.25s; }
    @@keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }
    .shimmer-line {
        background: linear-gradient(90deg, #f1f5f9 25%, #e8edf2 50%, #f1f5f9 75%);
        background-size: 200% 100%;
        animation: shimmerAnim 1.5s infinite;
        border-radius: 6px; height: 24px;
    }
    @@keyframes shimmerAnim { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

    /* Number pulse on update */
    .num-pulse {
        animation: numPulse 0.4s ease;
    }
    @@keyframes numPulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.04); color: #4f46e5; }
        100% { transform: scale(1); }
    }

    /* iOS-like content transition */
    .content-panel {
        transition: opacity 0.3s cubic-bezier(0.25,0.1,0.25,1), transform 0.3s cubic-bezier(0.25,0.1,0.25,1);
    }
    .content-panel.fading {
        opacity: 0;
        transform: translateY(6px);
    }

    /* ── Cards ── */
    .fa-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #eef2f6;
        transition: box-shadow 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .fa-card:hover {
        box-shadow: 0 12px 32px rgba(15,23,42,0.08);
        transform: translateY(-2px);
    }

    /* ── Funnel card specifics ── */
    .funnel-card {
        cursor: pointer;
        user-select: none;
        padding: 12px 12px 10px;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        word-break: break-word;
    }
    .funnel-card p { min-width: 0; }
    .funnel-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2.5px;
        border-radius: 14px 14px 0 0;
    }
    .funnel-card.fc-orange::before { background: #f97316; }
    .funnel-card.fc-violet::before { background: #8b5cf6; }
    .funnel-card.fc-blue::before   { background: #3b82f6; }
    .funnel-card.fc-cyan::before   { background: #06b6d4; }
    .funnel-card.fc-green::before  { background: #10b981; }

    /* Icon circles */
    .fc-icon {
        width: 32px; height: 32px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; flex-shrink: 0;
    }
    .fc-orange .fc-icon { background: #fff7ed; color: #ea580c; }
    .fc-violet .fc-icon { background: #f5f3ff; color: #7c3aed; }
    .fc-blue .fc-icon   { background: #eff6ff; color: #2563eb; }
    .fc-cyan .fc-icon   { background: #ecfeff; color: #0891b2; }
    .fc-green .fc-icon  { background: #ecfdf5; color: #059669; }

    /* Funnel active/dimmed states */
    .funnel-card.active-card {
        box-shadow: 0 0 0 2px currentColor, 0 12px 32px rgba(15,23,42,0.10);
        transform: translateY(-2px);
    }
    .funnel-card.fc-orange.active-card { box-shadow: 0 0 0 2px #f97316, 0 12px 32px rgba(15,23,42,0.10); }
    .funnel-card.fc-violet.active-card { box-shadow: 0 0 0 2px #8b5cf6, 0 12px 32px rgba(15,23,42,0.10); }
    .funnel-card.fc-blue.active-card   { box-shadow: 0 0 0 2px #3b82f6, 0 12px 32px rgba(15,23,42,0.10); }
    .funnel-card.fc-cyan.active-card   { box-shadow: 0 0 0 2px #06b6d4, 0 12px 32px rgba(15,23,42,0.10); }
    .funnel-card.fc-green.active-card  { box-shadow: 0 0 0 2px #10b981, 0 12px 32px rgba(15,23,42,0.10); }
    .funnel-card.dimmed { opacity: 0.55; transform: none; }
    .funnel-card.dimmed:hover { opacity: 0.75; transform: translateY(-1px); box-shadow: 0 6px 18px rgba(15,23,42,0.06); }

    /* Teklif kartı alt-satır aktif göstergesi */
    [data-teklif-sub] { position: relative; transition: background-color .18s ease; }
    [data-teklif-sub="bekleme"].teklif-sub-active { background: #eff6ff !important; box-shadow: inset 2px 0 0 #3b82f6; }
    [data-teklif-sub="kabul"].teklif-sub-active   { background: #ecfdf5 !important; box-shadow: inset 2px 0 0 #10b981; }

    /* Conversion badge */
    .conv-badge {
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 11px; font-weight: 800;
        padding: 3px 6px; border-radius: 8px;
        letter-spacing: -0.02em;
        white-space: nowrap;
        min-width: 44px;
        text-align: center;
    }
    .fc-orange .conv-badge { background: #fff7ed; color: #c2410c; }
    .fc-violet .conv-badge { background: #f5f3ff; color: #6d28d9; }
    .fc-blue .conv-badge   { background: #eff6ff; color: #1d4ed8; }
    .fc-cyan .conv-badge   { background: #ecfeff; color: #0e7490; }
    .fc-green .conv-badge  { background: #ecfdf5; color: #047857; }

    /* Arrow connector between cards */
    .funnel-arrow {
        display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
        flex-shrink: 0; width: 56px; gap: 6px; position: relative;
        padding-bottom: 24px;
        transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .funnel-arrow:hover { transform: translateX(2px); }
    .funnel-arrow svg { opacity: 0.5; transition: opacity 200ms ease; }
    .funnel-arrow:hover svg { opacity: 0.8; }
    .conv-circle {
        min-width: 48px; height: 28px; border-radius: 14px;
        padding: 0 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: 800; letter-spacing: -0.03em;
        white-space: nowrap;
        background: linear-gradient(135deg, #eef2ff, #e0e7ff) !important;
        color: #4f46e5 !important;
        box-shadow: 0 2px 10px rgba(79,70,229,0.18);
        transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 200ms ease;
    }
    .conv-circle:hover { transform: scale(1.08); box-shadow: 0 4px 14px rgba(79,70,229,0.25); }

    /* ── Filter tabs ── */
    .ftab {
        padding: 6px 16px; border-radius: 8px; font-size: 12px; font-weight: 500;
        cursor: pointer; border: none; transition: all 0.2s ease;
        color: #64748b; background: transparent;
    }
    .ftab:hover { background: #f1f5f9; color: #1e293b; }
    .ftab.active {
        background: #1e293b; color: #fff;
        box-shadow: 0 2px 8px rgba(30,41,59,0.18);
    }

    /* ── Avatar ── */
    .avatar-circle {
        width: 38px; height: 38px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: 700; color: #fff; flex-shrink: 0;
    }

    /* ── Alarm Banner ── */
    .alarm-banner {
        background: linear-gradient(90deg, #fef2f2, #fee2e2);
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 12px 20px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        animation: alarmPulse 2s ease-in-out infinite;
    }
    @@keyframes alarmPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(248,113,113,0); }
        50% { box-shadow: 0 0 0 4px rgba(248,113,113,0.15); }
    }
    .alarm-banner.warning {
        background: linear-gradient(90deg, #fffbeb, #fef3c7);
        border-color: #fde68a;
        animation: warnPulse 2s ease-in-out infinite;
    }
    @@keyframes warnPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(245,158,11,0); }
        50% { box-shadow: 0 0 0 4px rgba(245,158,11,0.12); }
    }
    .alarm-banner .alarm-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: #f87171;
        animation: dotPulse 1.5s ease-in-out infinite;
    }
    .alarm-banner.warning .alarm-dot { background: #f59e0b; }
    @@keyframes dotPulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.3); }
    }

    /* ── KPI Kart Renk Kodları ── */
    .kpi-status-dot {
        width: 6px; height: 6px; border-radius: 50%; display: inline-block;
    }
    .kpi-status-green { background: #22d3a0; box-shadow: 0 0 6px rgba(34,211,160,0.4); }
    .kpi-status-amber { background: #f59e0b; box-shadow: 0 0 6px rgba(245,158,11,0.4); animation: dotPulse 1.5s infinite; }
    .kpi-status-red { background: #f87171; box-shadow: 0 0 6px rgba(248,113,113,0.5); animation: dotPulse 1s infinite; }

    .funnel-card.kpi-border-green::before { background: #22d3a0 !important; }
    .funnel-card.kpi-border-amber::before { background: #f59e0b !important; }
    .funnel-card.kpi-border-red::before { background: #f87171 !important; }

    /* ── Progress bar ── */
    .pbar-track { height: 7px; border-radius: 4px; background: #f1f5f9; overflow: hidden; }
    .pbar-fill { height: 100%; border-radius: 4px; transition: width 0.8s cubic-bezier(0.25,0.1,0.25,1); }

    /* ── Stage badge ── */
    .stage-badge {
        display: inline-flex; padding: 3px 10px; border-radius: 6px;
        font-size: 10px; font-weight: 600;
    }

    /* ── Medal ── */
    .medal { font-size: 15px; width: 24px; text-align: center; flex-shrink: 0; }

    /* ── Shimmer ── */
    .sh { background: linear-gradient(90deg,#f1f5f9 25%,#e8edf2 50%,#f1f5f9 75%); background-size: 200% 100%; animation: sh 1.5s infinite; border-radius: 6px; height: 18px; }
    @@keyframes sh { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

    /* ── Pagination ── */
    .pg-btn {
        padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 500;
        border: 1px solid #e2e8f0; background: #fff; color: #475569; cursor: pointer;
        transition: all 0.15s ease;
    }
    .pg-btn:hover { background: #f8fafc; border-color: #cbd5e1; }
    .pg-btn.active { background: #1e293b; color: #fff; border-color: #1e293b; }

    /* ── Divider ── */
    .divider { height: 1px; background: #f1f5f9; margin: 0; }

    /* ── Warning note ── */
    .warn-note {
        display: flex; align-items: flex-start; gap: 5px;
        background: #fffbeb; border: 1px solid #fef3c7; border-radius: 6px;
        padding: 6px 8px; margin-top: 8px;
        font-size: 10px; color: #92400e; line-height: 1.4;
    }

    /* ═══ HERO ROW — Birleşik panel (sol) + Hedef yan paneli (sağ) ═══
       Sol: 3 KPI + Funnel zinciri (geniş)
       Sağ: Hedef metric paneli (dikey, 280px sabit) */
    .hero-row {
        display: flex;
        align-items: stretch;
        gap: 12px;
    }
    .hero-row > .fa-card { margin-bottom: 0; }
    .hero-row > .fa-card.hero-main { flex: 1; min-width: 0; }
    .hero-row > .fa-card.hero-aside {
        width: 280px;
        flex-shrink: 0;
        position: relative;
        padding: 16px 20px 18px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    #hedefStripe {
        position: absolute; top: 0; left: 0; right: 0; height: 3px;
        background: #94a3b8; transition: background .25s ease;
    }
    .hero-aside-title {
        font-size: 10px; font-weight: 700; color: #94a3b8;
        letter-spacing: 0.08em;
        margin-top: 2px;
    }
    .hero-aside-donut {
        margin: 8px auto 14px;
        position: relative;
        width: 120px; height: 120px;
    }
    .hero-aside-donut svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .hero-aside-donut svg circle {
        transition: stroke-dasharray 1.1s cubic-bezier(.4,0,.2,1), stroke .25s ease;
    }
    .hero-aside-donut > span {
        position: absolute; inset: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 24px; font-weight: 800; color: #0f172a;
        font-variant-numeric: tabular-nums; letter-spacing: -0.02em;
    }
    .hero-aside-rows {
        display: flex; flex-direction: column;
        border-top: 1px solid #f1f5f9;
    }
    .hero-aside-row {
        display: flex; justify-content: space-between; align-items: baseline;
        padding: 8px 0;
        border-bottom: 1px solid #f1f5f9;
    }
    .hero-aside-row:last-child { border-bottom: 0; padding-bottom: 0; }
    .hero-aside-row .label {
        font-size: 10px; font-weight: 700; color: #94a3b8;
        letter-spacing: 0.06em;
    }
    .hero-aside-row .value {
        font-size: 14px; font-weight: 800; color: #0f172a;
        font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
        white-space: nowrap;
    }
    .hero-aside-row .value.muted { color: #64748b; font-weight: 700; }
    .hero-aside-row .value.danger { color: #dc2626; }
    .hero-aside-row .suffix { font-size: 11px; font-weight: 600; color: #64748b; margin-left: 3px; }

    @@media (max-width: 1023px) {
        .hero-row { flex-direction: column; }
        .hero-row > .fa-card.hero-aside { width: 100%; }
    }
</style>

<div class="fa-dash" style="position:sticky; top:-32px; z-index:40; background:#f8fafc; margin:-32px 0 0; padding:16px 0 10px; box-shadow:0 8px 12px -8px rgba(15,23,42,0.08);">

    <!-- ═══ HEADER ═══ -->
    <div class="flex items-center justify-between mb-4">
        <div>
            <h1 class="text-[22px] font-bold text-[#0f172a] tracking-tight">Fırsat Analizi</h1>
            <p class="text-[12px] text-[#94a3b8] mt-0.5 font-medium">Fırsattan Faturaya Uçtan Uca Dönüşüm İzleme</p>
        </div>
        <div class="flex items-center gap-2">
            <div class="flex items-center gap-2 bg-[#f8fafc] rounded-xl px-2 py-1" id="filterTabs">
                <span class="text-[12px] text-[#64748b] font-medium pl-1 pr-0.5 select-none">Filtre:</span>
                <button class="ftab active" data-filter="month">Bu ay</button>
                <button class="ftab" data-filter="lastmonth">Geçen ay</button>
                <button class="ftab" data-filter="q1">1. Çeyrek</button>
                <button class="ftab" data-filter="q2">2. Çeyrek</button>
                <button class="ftab" data-filter="q3">3. Çeyrek</button>
                <button class="ftab" data-filter="q4">4. Çeyrek</button>
                <button class="ftab" data-filter="ytd">YTD</button>
                <button class="ftab" data-filter="all">Tümü</button>
            </div>
            <button id="btnRefreshAll" type="button" title="Verileri yenile (cache'i atla)"
                    class="flex items-center justify-center w-9 h-9 rounded-xl bg-[#f8fafc] hover:bg-white border border-transparent hover:border-[#e2e8f0] text-[#64748b] hover:text-[#0f172a] transition-all"
                    aria-label="Verileri yenile">
                <i class="bi bi-arrow-clockwise text-[15px]"></i>
            </button>
            <span id="dataAgeBadge" class="hidden text-[11px] text-[#94a3b8] font-medium ml-0.5"></span>
        </div>
    </div>


    @* ═══ HEDEF KARNE — ⓘ ikon + yan panel CSS ═══ *@
    <style>
        .hk-info-btn {
            background: rgba(14,165,233,.08); border: 0; color: #0ea5e9;
            width: 22px; height: 22px; border-radius: 50%;
            cursor: pointer; opacity: .85; transition: all .2s;
            font-size: 12px; display: inline-flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .hk-info-btn:hover { opacity: 1; background: #0ea5e9; color: #fff; transform: scale(1.08); }
        .hk-info-btn i { font-size: 13px; line-height: 1; }
        .hk-overlay { position: fixed; inset: 0; background: rgba(15,23,42,.4); backdrop-filter: blur(4px); z-index: 999; opacity: 0; pointer-events: none; transition: opacity .25s; }
        .hk-overlay.open { opacity: 1; pointer-events: auto; }
        .hk-panel { position: fixed; top: 0; right: 0; bottom: 0; width: 480px; max-width: 92vw; background: #fff; z-index: 1000; box-shadow: -10px 0 40px rgba(15,23,42,.15); transform: translateX(100%); transition: transform .35s cubic-bezier(.4,0,.2,1); overflow-y: auto; }
        .hk-panel.open { transform: translateX(0); }
        .hk-panel-head { padding: 24px 28px 16px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
        .hk-panel-title { font-size: 18px; font-weight: 700; color: #0f172a; letter-spacing: -0.01em; }
        .hk-panel-sub { font-size: 11px; color: #94a3b8; margin-top: 4px; font-weight: 600; letter-spacing: .06em; }
        .hk-panel-close { background: #f1f5f9; border: 0; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; color: #64748b; transition: all .2s; }
        .hk-panel-close:hover { background: #e2e8f0; color: #0f172a; }
        .hk-panel-body { padding: 20px 28px 32px; }
        .hk-stat { display: flex; justify-content: space-between; align-items: baseline; padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
        .hk-stat-l { font-size: 11px; color: #64748b; font-weight: 600; }
        .hk-stat-v { font-size: 14px; color: #0f172a; font-weight: 700; font-variant-numeric: tabular-nums; }
        .hk-bar { height: 6px; background: #f1f5f9; border-radius: 3px; overflow: hidden; margin-top: 4px; }
        .hk-bar-fill { height: 100%; border-radius: 3px; width: 0; transition: width .9s cubic-bezier(.4,0,.2,1); }
        .hk-bar-fill.green  { background: linear-gradient(90deg, #10b981, #059669); }
        .hk-bar-fill.yellow { background: linear-gradient(90deg, #f59e0b, #d97706); }
        .hk-bar-fill.red    { background: linear-gradient(90deg, #ef4444, #dc2626); }
        .hk-bar-fill.neutral{ background: linear-gradient(90deg, #94a3b8, #64748b); }
        .hk-mini-table { width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 4px; }
        .hk-mini-table th { font-weight: 700; color: #94a3b8; font-size: 9px; letter-spacing: .05em; padding: 6px 4px; text-align: right; }
        .hk-mini-table th:first-child, .hk-mini-table td:first-child { text-align: left; }
        .hk-mini-table td { padding: 6px 4px; border-top: 1px solid #f1f5f9; font-variant-numeric: tabular-nums; text-align: right; color: #0f172a; }
        .hk-perf-block { background: #f8fafc; border-radius: 10px; padding: 12px 14px; margin-bottom: 10px; }
        .hk-perf-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
        .hk-perf-label { font-size: 11px; color: #64748b; font-weight: 700; letter-spacing: .04em; }
        .hk-perf-pct { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
        .hk-perf-nums { font-size: 11px; color: #64748b; margin-bottom: 8px; font-variant-numeric: tabular-nums; }
        .hk-perf-nums b { color: #0f172a; font-weight: 700; }
        .hk-section { margin-top: 24px; }
        .hk-section-title { font-size: 12px; font-weight: 700; color: #0f172a; margin-bottom: 8px; letter-spacing: -0.01em; }
        .hk-link { display: inline-flex; align-items: center; gap: 4px; color: #0ea5e9; font-size: 11px; font-weight: 700; text-decoration: none; margin-top: 16px; }
        .hk-link:hover { text-decoration: underline; }
    </style>

    <div class="hk-overlay" id="hkOverlay" onclick="window._closeHedefKarne()"></div>
    <aside class="hk-panel" id="hkPanel">
        <div class="hk-panel-head">
            <div>
                <div class="hk-panel-sub" id="hkType"></div>
                <div class="hk-panel-title" id="hkTitle">—</div>
            </div>
            <button class="hk-panel-close" onclick="window._closeHedefKarne()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="hk-panel-body" id="hkBody"></div>
    </aside>

    <script>
    (function(){
        const fmtTLm = v => {
            v = Number(v) || 0;
            if (Math.abs(v) >= 1e9) return '₺' + (v/1e9).toFixed(1) + 'Mr';
            if (Math.abs(v) >= 1e6) return '₺' + (v/1e6).toFixed(1) + 'M';
            if (Math.abs(v) >= 1e3) return '₺' + (v/1e3).toFixed(0) + 'K';
            return '₺' + Math.round(v);
        };
        const fmtPct = v => (Math.round((Number(v)||0)*10)/10).toLocaleString('tr-TR') + '%';
        const renkClass = v => v >= 85 ? 'green' : v >= 70 ? 'yellow' : v > 0 ? 'red' : 'neutral';
        const renkHex   = r => r === 'green' ? '#059669' : r === 'yellow' ? '#d97706' : r === 'red' ? '#dc2626' : '#94a3b8';

        // activeFilter -> ay aralığı (1-based, inclusive)
        function donemAyRange(filt) {
            const now = new Date();
            const m = now.getMonth() + 1;
            switch ((filt || 'month').toLowerCase()) {
                case 'lastmonth': { const d = new Date(now.getFullYear(), now.getMonth()-1, 1); return [d.getMonth()+1, d.getMonth()+1, _aylarLabel(d.getMonth()+1) + ' ' + d.getFullYear()]; }
                case 'q1': return [1, 3, '1. Çeyrek'];
                case 'q2': return [4, 6, '2. Çeyrek'];
                case 'q3': return [7, 9, '3. Çeyrek'];
                case 'q4': return [10, 12, '4. Çeyrek'];
                case 'ytd': return [1, m, 'YTD'];
                case 'all': return [1, 12, 'Tüm Yıl'];
                case 'month':
                default: return [m, m, _aylarLabel(m) + ' ' + now.getFullYear()];
            }
        }
        function _aylarLabel(ay) {
            return ['','Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'][ay] || '';
        }

        function metricBlock(label, hedef, gerc, opts) {
            opts = opts || {};
            const pct = hedef > 0 ? gerc / hedef * 100 : 0;
            const renk = renkClass(pct);
            const barPct = Math.min(100, Math.max(0, pct));
            const pctTxt = hedef > 0 ? fmtPct(pct) : '—';
            return '<div class="hk-perf-block">' +
                '<div class="hk-perf-head">' +
                    '<span class="hk-perf-label">' + label + '</span>' +
                    '<span class="hk-perf-pct" style="color:' + renkHex(renk) + ';">' + pctTxt + '</span>' +
                '</div>' +
                '<div class="hk-perf-nums"><b>' + fmtTLm(gerc) + '</b> / ' + fmtTLm(hedef) + '</div>' +
                '<div class="hk-bar"><div class="hk-bar-fill ' + renk + '" data-pct="' + barPct + '"></div></div>' +
            '</div>';
        }

        window._openHedefKarne = function(type, name) {
            const ov = document.getElementById('hkOverlay');
            const pn = document.getElementById('hkPanel');
            const body = document.getElementById('hkBody');
            const title = document.getElementById('hkTitle');
            const sub = document.getElementById('hkType');
            ov.classList.add('open'); pn.classList.add('open');
            sub.innerText = type === 'temsilci' ? 'Satış Temsilcisi' : 'Ürün Hedefi';
            title.innerText = decodeURIComponent(name);
            body.innerHTML = '<div style="text-align:center;padding:48px;color:#94a3b8;font-size:12px;">Yükleniyor…</div>';

            const url = type === 'temsilci'
                ? '/Hedef/TemsilciByAd?ad=' + name
                : '/Hedef/UrunDetay?urunAd=' + name;

            fetch(url).then(r => r.json()).then(j => {
                if (!j.ok) {
                    body.innerHTML = '<div style="padding:24px;color:#94a3b8;font-size:12px;">Bu kaynak için hedef bulunmuyor.<br><span style="font-size:10px;color:#cbd5e1;">' + (j.error||'') + '</span></div>';
                    return;
                }
                const d = j.data;
                const filt = (typeof activeFilter !== 'undefined') ? activeFilter : 'month';
                const range = donemAyRange(filt);
                const donemMin = range[0], donemMax = range[1], donemLab = range[2];

                // Seçili dönem toplamı (ay bazında)
                let donHedef = 0, donGerc = 0, donHedYS = 0, donGerYS = 0, donHedYen = 0, donGerYen = 0;
                (d.ayToplamlari||[]).forEach(a => {
                    if (a.ay >= donemMin && a.ay <= donemMax) {
                        donHedef  += Number(a.hedef) || 0;
                        donGerc   += Number(a.gerceklesen) || 0;
                        donHedYS  += Number(a.hedefYS) || 0;
                        donGerYS  += Number(a.gerceklesenYS) || 0;
                        donHedYen += Number(a.hedefYen) || 0;
                        donGerYen += Number(a.gerceklesenYen) || 0;
                    }
                });

                // Ürün × seçili dönem (UrunAyMatris üzerinden topla)
                const urunDonem = {};  // urunId -> {urunAd, hedef, gerc}
                (d.urunAyMatris||[]).forEach(c => {
                    if (c.ay >= donemMin && c.ay <= donemMax) {
                        if (!urunDonem[c.urunId]) urunDonem[c.urunId] = { urunAd: c.urunAd, hedef: 0, gerc: 0 };
                        urunDonem[c.urunId].hedef += Number(c.hedef) || 0;
                        urunDonem[c.urunId].gerc  += Number(c.gerceklesen) || 0;
                    }
                });

                let html = '';

                // 1) Yıllık özet (header)
                html += '<div class="hk-stat"><span class="hk-stat-l">Yıllık Hedef</span><span class="hk-stat-v">' + fmtTLm(d.yillikHedef) + '</span></div>';

                // 2) YTD
                html += '<div style="margin-top:14px;">' + metricBlock('YTD Hedef vs Gerçekleşen', d.ytdHedef, d.ytdGerceklesen) + '</div>';

                // 3) Seçili dönem
                html += metricBlock(donemLab + ' · Hedef vs Gerç.', donHedef, donGerc);

                if (type === 'temsilci') {
                    // 4a) YS / Yenileme — Seçili dönem
                    html += '<div class="hk-section-title" style="margin-top:18px;">Yeni Satış · Yenileme — ' + donemLab + '</div>';
                    html += metricBlock('Yeni Satış', donHedYS, donGerYS);
                    html += metricBlock('Yenileme',   donHedYen, donGerYen);

                    // 4b) YS / Yenileme — Yıllık
                    html += '<div class="hk-section-title" style="margin-top:18px;">Yeni Satış · Yenileme — Yıllık</div>';
                    html += metricBlock('Yeni Satış', d.yillikHedefYS, d.gerceklesenYS);
                    html += metricBlock('Yenileme',   d.yillikHedefYen, d.gerceklesenYen);

                    // 5) Ürünler — Seçili dönem (Hedef + Gerç + %)
                    html += '<div class="hk-section"><div class="hk-section-title">Ürünler · ' + donemLab + '</div><table class="hk-mini-table"><thead><tr><th>Ürün</th><th>Hedef</th><th>Gerç.</th><th>%</th></tr></thead><tbody>';
                    Object.values(urunDonem).sort((a,b) => b.hedef - a.hedef).forEach(u => {
                        const pct = u.hedef > 0 ? u.gerc / u.hedef * 100 : 0;
                        const r = renkClass(pct);
                        html += '<tr><td>' + u.urunAd + '</td><td>' + fmtTLm(u.hedef) + '</td><td><b>' + fmtTLm(u.gerc) + '</b></td><td style="color:' + renkHex(r) + ';font-weight:700;">' + (u.hedef>0?fmtPct(pct):'—') + '</td></tr>';
                    });
                    html += '</tbody></table></div>';

                    html += '<a href="/Hedef/Karne#temsilci=' + d.temsilciId + '" class="hk-link">Tüm hedefleri aç <i class="bi bi-arrow-right"></i></a>';
                } else {
                    // Ürün paneli — YS / Yenileme: Seçili Dönem + Yıllık (ayToplamlari ürün için de mevcut)
                    html += '<div class="hk-section-title" style="margin-top:18px;">Yeni Satış · Yenileme — ' + donemLab + '</div>';
                    html += metricBlock('Yeni Satış', donHedYS, donGerYS);
                    html += metricBlock('Yenileme',   donHedYen, donGerYen);

                    html += '<div class="hk-section-title" style="margin-top:18px;">Yeni Satış · Yenileme — Yıllık</div>';
                    // gerceklesenYS/gerceklesenYen ürün modelinde yok → ayToplamlari toplamı kullan
                    let yilGerYS = 0, yilGerYen = 0;
                    (d.ayToplamlari||[]).forEach(a => {
                        yilGerYS  += Number(a.gerceklesenYS) || 0;
                        yilGerYen += Number(a.gerceklesenYen) || 0;
                    });
                    html += metricBlock('Yeni Satış', d.yillikHedefYS, yilGerYS);
                    html += metricBlock('Yenileme',   d.yillikHedefYen, yilGerYen);

                    if ((d.temsilciDagilimi||[]).length) {
                        html += '<div class="hk-section"><div class="hk-section-title">Temsilci Dağılımı — Yıllık Hedef</div><table class="hk-mini-table"><thead><tr><th>Temsilci</th><th>YS</th><th>Yen</th><th>Top</th></tr></thead><tbody>';
                        d.temsilciDagilimi.forEach(t => html += '<tr><td>' + t.ad + '</td><td>' + fmtTLm(t.hedefYS) + '</td><td>' + fmtTLm(t.hedefYen) + '</td><td><b>' + fmtTLm(t.yillikHedef) + '</b></td></tr>');
                        html += '</tbody></table></div>';
                    }
                    html += '<div style="margin-top:12px;padding:10px 12px;background:#fef3c7;border-radius:8px;font-size:10px;color:#92400e;line-height:1.5;"><i class="bi bi-info-circle"></i> Ürün-bazlı gerçekleşen henüz kalem-seviyesinde hesaplanmıyor — temsilci ürün dağılımı yıllık hedef olarak gösteriliyor.</div>';
                    html += '<a href="/Hedef/Karne" class="hk-link">Tüm hedefleri aç <i class="bi bi-arrow-right"></i></a>';
                }

                body.innerHTML = html;
                requestAnimationFrame(() => {
                    body.querySelectorAll('.hk-bar-fill').forEach(el => el.style.width = (el.dataset.pct || 0) + '%');
                });
            }).catch(err => {
                body.innerHTML = '<div style="padding:24px;color:#dc2626;font-size:12px;">Bağlantı hatası: ' + err.message + '</div>';
            });
        };

        window._closeHedefKarne = function() {
            document.getElementById('hkOverlay').classList.remove('open');
            document.getElementById('hkPanel').classList.remove('open');
        };
        document.addEventListener('keydown', e => { if (e.key === 'Escape') window._closeHedefKarne(); });
    })();
    </script>

